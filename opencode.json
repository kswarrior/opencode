{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "repomix": {
      "type": "local",
      "command": ["npx", "-y", "repomix", "--mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["python3", "-m", "mcp_server_fetch"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["python3", "-m", "mcp_server_git", "--repository", "."],
      "enabled": true
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5-Coder-7B Q4_K_M (4.7GB, 7.7tok/s)"
        }
      }
    },
    "ks-own": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "KS Own (local)",
      "options": {
        "baseURL": "http://localhost:8089/v1"
      },
      "models": {
        "ks-qwen2.5-coder-7b-q4": {
          "name": "KS Qwen2.5-Coder-7B Q4 (coding, private)"
        }
      }
    }
  },
  "model": "ks-own/ks-qwen2.5-coder-7b-q4",
  "small_model": "ks-own/ks-qwen2.5-coder-7b-q4"
}
