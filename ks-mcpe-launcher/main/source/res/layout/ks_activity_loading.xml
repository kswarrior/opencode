<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ks_black">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ks_loading_logo"
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ks_logo_mark" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.14"
            android:text="@string/ks_brand_title"
            android:textColor="@color/ks_white"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.28"
            android:text="@string/ks_brand_subtitle"
            android:textColor="@color/ks_gray_400"
            android:textSize="9sp" />

        <FrameLayout
            android:id="@+id/ks_loading_track"
            android:layout_width="280dp"
            android:layout_height="3dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/ks_bg_progress_track">

            <View
                android:id="@+id/ks_loading_progress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/ks_bg_progress_fill" />
        </FrameLayout>

        <TextView
            android:id="@+id/ks_loading_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.22"
            android:text="@string/ks_loading_status_preparing"
            android:textColor="@color/ks_gray_400"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ks_loading_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:letterSpacing="0.12"
        android:textColor="@color/ks_gray_500"
        android:textSize="9sp" />
</FrameLayout>
