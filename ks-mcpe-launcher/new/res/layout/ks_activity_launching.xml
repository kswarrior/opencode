<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ks_black">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:id="@+id/ks_launching_logo"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ks_logo_mark" />

        <TextView
            android:id="@+id/ks_launching_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:letterSpacing="0.16"
            android:text="@string/ks_launching_title"
            android:textColor="@color/ks_white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/ks_launching_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.24"
            android:text="@string/ks_launching_checking"
            android:textColor="@color/ks_gray_400"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/ks_launching_detail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxWidth="420dp"
            android:text="@string/ks_ui_wait"
            android:textColor="@color/ks_gray_300"
            android:textSize="12sp" />

        <FrameLayout
            android:id="@+id/ks_launching_track"
            android:layout_width="220dp"
            android:layout_height="3dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/ks_bg_progress_track">

            <View
                android:id="@+id/ks_launching_progress"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/ks_bg_progress_fill" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/ks_launching_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="24dp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:letterSpacing="0.12"
        android:textColor="@color/ks_gray_500"
        android:textSize="9sp" />

    <TextView
        android:id="@+id/ks_launching_action"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="24dp"
        android:background="@drawable/ks_btn_secondary"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.14"
        android:minWidth="120dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/ks_back_to_home"
        android:textColor="@color/ks_white"
        android:textSize="11sp"
        android:visibility="gone" />
</FrameLayout>
