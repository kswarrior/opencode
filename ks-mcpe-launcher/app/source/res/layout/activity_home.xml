<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home">

    <ImageView
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_gravity="center"
        android:alpha="0.045"
        android:contentDescription="@null"
        android:src="@drawable/logo_mark" />

    <LinearLayout
        android:id="@+id/home_brand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="28dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/logo_mark" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:letterSpacing="0.10"
                android:text="@string/brand_title"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif"
                android:includeFontPadding="false"
                android:letterSpacing="0.24"
                android:text="@string/brand_subtitle"
                android:textColor="@color/gray_400"
                android:textSize="9sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/home_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_margin="28dp"
        android:orientation="vertical">

        <View
            android:layout_width="38dp"
            android:layout_height="2dp"
            android:layout_marginBottom="12dp"
            android:background="@color/gray_600" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:text="@string/requirements_hint"
            android:textColor="@color/gray_500"
            android:textSize="9sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/launch_button"
        android:layout_width="wrap_content"
        android:layout_height="58dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="28dp"
        android:background="@drawable/btn_launch"
        android:clickable="true"
        android:drawablePadding="12dp"
        android:drawableStart="@drawable/ic_play"
        android:focusable="true"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:includeFontPadding="false"
        android:letterSpacing="0.16"
        android:minWidth="200dp"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:text="@string/launch"
        android:textColor="@color/black"
        android:textSize="15sp" />
</FrameLayout>
