                <ImageView android:layout_gravity="end|center" android:layout_width="18.0dp" android:layout_height="18.0dp" android:src="@drawable/ic_ui_expand_more" android:importantForAccessibility="no" android:layout_marginEnd="12.0dp" app:tint="@color/text_secondary" />
