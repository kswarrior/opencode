        </LinearLayout>
        <org.levimc.launcher.ui.packages.TaskProgressView android:id="@id/pkg_settings_cache_progress" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12.0dp" />
        <View style="@style/settings_Divider" />
        <LinearLayout style="@style/settings_Row">
