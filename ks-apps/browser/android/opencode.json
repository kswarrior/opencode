{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "mobile-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mobilenext/mobile-mcp@latest"],
      "enabled": true,
      "timeout": 30000
    },
    "android-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@us-all/android-mcp"],
      "enabled": true,
      "timeout": 30000,
      "environment": {
        "ANDROID_MCP_ALLOW_WRITE": "true",
        "ANDROID_TOOLS": "device,apps,ui,logcat,emulator,debug"
      }
    }
  }
}
