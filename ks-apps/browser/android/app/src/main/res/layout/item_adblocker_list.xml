<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/adBlockerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/ks_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/adBlockerSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ks_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/adBlockerStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/ks_accent"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/adBlockerCheck"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@null"
        android:src="@drawable/bg_engine_check" />
</LinearLayout>
