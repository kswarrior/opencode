<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:background="@drawable/bg_header_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp">

        <ImageButton
            android:id="@+id/videoBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_toolbar_button"
            android:contentDescription="@string/back"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_file_download"
            android:tint="#0B0B0B" />

        <TextView
            android:id="@+id/videoTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/video_downloader_title"
            android:textColor="@color/ks_text"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/videoDownloads"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_toolbar_button"
            android:contentDescription="@string/downloads_title"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_file_download"
            android:tint="@color/ks_text" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp">

        <EditText
            android:id="@+id/videoLinkInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/bg_url_bar"
            android:drawableStart="@drawable/ic_video_download"
            android:drawablePadding="8dp"
            android:hint="@string/video_link_hint"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/ks_text"
            android:textColorHint="@color/ks_muted"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/videoLinkGo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="7dp"
            android:background="@drawable/bg_primary_button"
            android:contentDescription="@string/video_download_link"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_file_download"
            android:tint="@color/ks_text" />
    </LinearLayout>

    <TextView
        android:id="@+id/videoPageLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:paddingStart="16dp"
        android:paddingTop="7dp"
        android:paddingEnd="16dp"
        android:paddingBottom="2dp"
        android:singleLine="true"
        android:textColor="@color/ks_muted"
        android:textSize="12sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/videoList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="6dp"
            android:paddingStart="8dp"
            android:paddingTop="4dp"
            android:paddingEnd="8dp"
            android:paddingBottom="14dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/videoEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:alpha="0.55"
                android:contentDescription="@null"
                android:src="@drawable/ic_video_download"
                android:tint="@color/ks_muted" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/video_empty_title"
                android:textColor="@color/ks_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/video_empty_body"
                android:textColor="@color/ks_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
