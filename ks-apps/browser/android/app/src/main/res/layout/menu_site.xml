<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/siteMenuPanel"
    android:layout_width="@dimen/site_menu_width"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_menu_glass"
    android:orientation="vertical"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/siteMenuIcon"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_toolbar_button"
            android:contentDescription="@string/site_logo_description"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_globe" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/siteMenuTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ks_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/siteMenuHost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/ks_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/siteMenuUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="middle"
                android:singleLine="true"
                android:textColor="@color/ks_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/siteMenuSecurity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:textColor="@color/ks_accent"
        android:textSize="11sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        android:background="@color/ks_divider" />

    <LinearLayout
        android:id="@+id/siteMenuInfo"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_info"
            android:tint="@color/ks_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/site_menu_information"
            android:textColor="@color/ks_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/siteMenuSettings"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_settings"
            android:tint="@color/ks_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/site_settings"
            android:textColor="@color/ks_text"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/siteMenuScreenSize"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_screen_size"
            android:tint="@color/ks_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/site_menu_screen_size"
            android:textColor="@color/ks_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/siteMenuScreenSizeValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ks_muted"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/ks_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/siteMenuCookies"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_cookie"
            android:tint="@color/ks_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/site_menu_cookies"
            android:textColor="@color/ks_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/siteMenuCookiesValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ks_muted"
            android:textSize="12sp" />

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/ks_muted" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/siteMenuAdBlock"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_menu_item"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_adblock"
            android:tint="@color/ks_text" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="@string/adblocking"
            android:textColor="@color/ks_text"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/siteMenuAdBlockSwitch"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:clickable="false"
            android:focusable="false"
            android:thumbTint="@color/ks_switch_thumb"
            android:trackTint="@color/ks_switch_track" />
    </LinearLayout>
</LinearLayout>
