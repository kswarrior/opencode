<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="44dp"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="4dp">

    <ImageView
        android:id="@+id/tabGroupChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_down"
        android:tint="@color/ks_muted" />

    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_folder"
        android:tint="@color/ks_muted" />

    <TextView
        android:id="@+id/tabGroupName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textColor="@color/ks_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tabGroupCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:singleLine="true"
        android:textColor="@color/ks_muted"
        android:textSize="11sp" />

    <ImageButton
        android:id="@+id/tabGroupMore"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="2dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tabs_options"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/ks_text" />
</LinearLayout>
