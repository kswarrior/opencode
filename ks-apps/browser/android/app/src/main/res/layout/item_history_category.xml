<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_row"
    android:gravity="center_vertical"
    android:minHeight="62dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="9dp"
    android:paddingEnd="4dp"
    android:paddingBottom="9dp">

    <ImageView
        android:id="@+id/historyCategoryChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_down"
        android:tint="@color/ks_muted" />

    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_file_icon">

        <TextView
            android:id="@+id/historyCategoryInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/ks_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/historyCategoryFavicon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="6dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyCategoryName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ks_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/historyCategoryUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ks_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/historyCategoryCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tab_counter"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:minWidth="36dp"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:singleLine="true"
        android:textColor="@color/ks_muted"
        android:textSize="11sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/historyCategoryMore"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="2dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/history_category_options"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/ks_text" />
</LinearLayout>
