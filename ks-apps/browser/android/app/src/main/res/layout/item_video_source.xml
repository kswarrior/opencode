<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_download_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/videoSourceIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_file_icon"
        android:contentDescription="@null"
        android:padding="9dp"
        android:src="@drawable/ic_video_download"
        android:tint="@color/ks_text" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/videoSourceTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ks_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/videoSourceMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ks_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/videoSourceBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_video_badge"
        android:paddingStart="7dp"
        android:paddingTop="3dp"
        android:paddingEnd="7dp"
        android:paddingBottom="3dp"
        android:textColor="@color/ks_accent"
        android:textSize="9sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/videoSourceDownload"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="3dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/video_download_action"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_file_download"
        android:tint="@color/ks_accent" />
</LinearLayout>
