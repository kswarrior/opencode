<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_choice_card"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="9dp"
    android:paddingEnd="6dp"
    android:paddingBottom="9dp">

    <FrameLayout
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_file_icon">

        <TextView
            android:id="@+id/tabInitial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/ks_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/tabFavicon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:padding="7dp"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tabName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ks_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tabUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/ks_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/tabAudio"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:contentDescription="@string/tabs_audible_description"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_volume_off"
        android:tint="@color/ks_muted"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/tabMore"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tabs_menu"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_more_vert"
        android:tint="@color/ks_text" />
</LinearLayout>
