<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_header_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="7dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/homeButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/bg_toolbar_button"
            android:contentDescription="@string/home_description"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_home"
            android:tint="@color/ks_text" />

        <EditText
            android:id="@+id/urlBar"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="7dp"
            android:layout_weight="1"
            android:background="@drawable/bg_url_bar"
            android:contentDescription="@string/url_hint"
            android:gravity="center_vertical"
            android:imeOptions="actionGo"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/ks_text"
            android:textColorHint="@color/ks_muted"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/menuButton"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_toolbar_button"
            android:contentDescription="@string/more_description"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/ks_text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/ks_panel"
            android:progressTint="@color/ks_text"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
