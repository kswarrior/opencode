<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true">

    <FrameLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/webContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:indeterminate="false"
            android:max="100"
            android:progress="0"
            android:progressBackgroundTint="@color/ks_panel"
            android:progressTint="@color/ks_text"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/toolbarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_toolbar_glass"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="7dp">

            <ImageView
                android:id="@+id/siteLogo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_toolbar_button"
                android:contentDescription="@string/site_logo_description"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_globe" />

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/bg_url_bar"
                android:contentDescription="@string/url_hint"
                android:gravity="center_vertical"
                android:imeOptions="actionGo"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:selectAllOnFocus="true"
                android:singleLine="true"
                android:textColor="@color/ks_text"
                android:textColorHint="@color/ks_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabsButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="7dp"
                android:background="@drawable/bg_tab_counter"
                android:clickable="true"
                android:contentDescription="@string/tabs_description"
                android:focusable="true"
                android:gravity="center"
                android:text="@string/tabs_default_count"
                android:textColor="@color/ks_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/menuButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_toolbar_button"
                android:contentDescription="@string/more_description"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/ks_text" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_toolbar_glass"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/findInput"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_url_bar"
            android:gravity="center_vertical"
            android:hint="@string/find_hint"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/ks_text"
            android:textColorHint="@color/ks_muted"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:gravity="center"
            android:minWidth="44dp"
            android:textColor="@color/ks_muted"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/findPrev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_toolbar_button"
            android:contentDescription="@string/find_previous"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_up"
            android:tint="@color/ks_text" />

        <ImageButton
            android:id="@+id/findNext"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_toolbar_button"
            android:contentDescription="@string/find_next"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/ks_text" />

        <ImageButton
            android:id="@+id/findClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_toolbar_button"
            android:contentDescription="@string/find_close"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close"
            android:tint="@color/ks_text" />
    </LinearLayout>

    <com.ks.android.portal.FloatingToolbarToggle
        android:id="@+id/toolbarToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:contentDescription="@string/collapse_toolbar"
        android:visibility="invisible" />

    <ImageButton
        android:id="@+id/mediaButton"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/bg_media_fab"
        android:contentDescription="@string/media_download_button"
        android:elevation="6dp"
        android:padding="13dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_video_download"
        android:tint="@color/ks_text"
        android:visibility="gone" />
</FrameLayout>
