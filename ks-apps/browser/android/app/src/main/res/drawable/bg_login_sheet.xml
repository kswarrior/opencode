<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#FF0B0B0B"
                android:endColor="#FF070707"
                android:startColor="#FF141414" />
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#0DFFFFFF"
                android:startColor="#59FFFFFF" />
        </shape>
    </item>
</layer-list>
