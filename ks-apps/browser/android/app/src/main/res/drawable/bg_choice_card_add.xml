<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#0AFFFFFF"
                        android:startColor="#1CFFFFFF" />
                    <stroke
                        android:width="2dp"
                        android:color="#F5F5F5"
                        android:dashGap="4dp"
                        android:dashWidth="6dp" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="#07FFFFFF"
                        android:startColor="#12FFFFFF" />
                    <stroke
                        android:width="1dp"
                        android:color="#40FFFFFF"
                        android:dashGap="4dp"
                        android:dashWidth="6dp" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
