<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#1F0A08"
                android:endColor="#0B0403"
                android:startColor="#3B1712" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.5"
                android:centerY="0"
                android:endColor="#00F97316"
                android:gradientRadius="440dp"
                android:startColor="#55F97316"
                android:type="radial" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="1"
                android:centerY="1"
                android:endColor="#00EF4444"
                android:gradientRadius="360dp"
                android:startColor="#40EF4444"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
