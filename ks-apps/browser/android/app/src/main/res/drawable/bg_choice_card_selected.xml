<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:centerColor="#16FFFFFF"
                android:endColor="#0DFFFFFF"
                android:startColor="#24FFFFFF" />
            <stroke
                android:width="2dp"
                android:color="#F5F5F5" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#14FFFFFF"
                android:startColor="#66FFFFFF" />
        </shape>
    </item>
</layer-list>
