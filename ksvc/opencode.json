{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "."],
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "repomix": {
      "type": "local",
      "command": ["npx", "-y", "repomix", "--mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["python3", "-m", "mcp_server_fetch"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["python3", "-m", "mcp_server_git", "--repository", "/home/runner/work/opencode/opencode"],
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": ["npx", "-y", "mcp-docker-server"],
      "enabled": true
    },
    "kubernetes": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-kubernetes"],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-github"],
      "enabled": true
    }
  }
}
