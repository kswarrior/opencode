{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "minecraft-creator-tools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@minecraft/creator-tools@0.19.0",
        "mcp",
        "-i",
        "."
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "skill": {
      "design-model": "allow",
      "create-block": "allow",
      "create-item": "allow",
      "create-mob": "allow",
      "debug-addon": "allow",
      "creator-tools-cli": "allow"
    }
  }
}
