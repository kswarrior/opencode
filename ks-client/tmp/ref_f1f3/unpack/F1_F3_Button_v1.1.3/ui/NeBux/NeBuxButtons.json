{
    "namespace": "NeBux_Buttons",
    
    "tab_top@common_tabs.base_tab": {
    "$is_left_most_tab|default": false,
    "$is_right_most_tab|default": false,

    "variables": [
      {
        "requires": "($is_left_most_tab and not $is_right_most_tab)",
        "$unchecked_default_image": "textures/ui/TabLeftBackBottomMost",
    "$unchecked_hover_image": "textures/ui/TabLeftBackBottomMostHover",
    "$unchecked_locked_image": "textures/ui/TabLeftBackBottomMost",
    "$unchecked_locked_hover_image": "textures/ui/TabLeftBackBottomMost",
    "$checked_default_image": "textures/ui/TabLeftFrontBottomMost",
    "$checked_hover_image": "textures/ui/TabLeftFrontBottomMostHover",
    "$checked_locked_image": "textures/ui/TabLeftFrontBottomMost",
    "$checked_locked_hover_image": "textures/ui/TabLeftFrontBottomMost"
      },
      {
        "requires": "($is_right_most_tab and not $is_left_most_tab)",
        "$unchecked_default_image": "textures/ui/TabLeftBackBottomMost",
    "$unchecked_hover_image": "textures/ui/TabLeftBackBottomMostHover",
    "$unchecked_locked_image": "textures/ui/TabLeftBackBottomMost",
    "$unchecked_locked_hover_image": "textures/ui/TabLeftBackBottomMost",
    "$checked_default_image": "textures/ui/TabLeftFrontBottomMost",
    "$checked_hover_image": "textures/ui/TabLeftFrontBottomMostHover",
    "$checked_locked_image": "textures/ui/TabLeftFrontBottomMost",
    "$checked_locked_hover_image": "textures/ui/TabLeftFrontBottomMost"
      }
    ],

    "$unchecked_default_image": "textures/ui/TabLeftBackBottomMost",
    "$unchecked_hover_image": "textures/ui/TabLeftBackBottomMostHover",
    "$unchecked_locked_image": "textures/ui/TabLeftBackBottomMost",
    "$unchecked_locked_hover_image": "textures/ui/TabLeftBackBottomMost",
    "$checked_default_image": "textures/ui/TabLeftFrontBottomMost",
    "$checked_hover_image": "textures/ui/TabLeftFrontBottomMostHover",
    "$checked_locked_image": "textures/ui/TabLeftFrontBottomMost",
    "$checked_locked_hover_image": "textures/ui/TabLeftFrontBottomMost"
  }, 
    
   "hover_text_panel": {
   "ignored": "(not $hover_state)",
   "visible": "(not ($hover_text = ''))",
   "type": "panel",
   "allow_clipping": false,
   "$hover_text|default": "",
   "$use_hover_text_renderer|default": false,
   "controls": [
      {
         "hover_text_button@NeBux_Buttons.hover_text_button": {
            "ignored": "($touch or $use_hover_text_renderer)"
         }
      },
      {
         "hover_text_image_panel@NeBux_Buttons.hover_text_image_panel": {
            "ignored": "(not $touch or $use_hover_text_renderer)"
         }
      },
      {
         "hover_text_renderer@common.hover_text": {
            "ignored": "(not $use_hover_text_renderer)",
            "allow_clipping": false,
            "layer": 200,
            "property_bag": {
               "#hover_text_label": "$hover_text"
            },
            "bindings": [
               {
                  "binding_type": "view",
                  "source_property_name": "#hover_text_label",
                  "target_property_name": "#hover_text"
               }
            ]
         }
      }
   ]
},

"hover_text_image_panel": {
   "type": "image",
   "texture": "NeBux/NeBuxUI/Black",
   "size": [ "100%c + 10px", "100%c + 8px" ],
   "layer": 100,
   "anchor_from": "center",
   "anchor_to": "$hover_text_anchor",
   "offset": "$hover_text_offset",
   "$hover_text_shadow|default": false,
   "$hover_text_localize|default": true,
   "$hover_text_offset|default": [ 8, 2 ],
   "$hover_text_anchor|default": "left_middle",
   "$hover_text|default": "",
   "$hover_text_size|default": [ "default", "default" ],
   "$hover_text_max_size|default": [ "default", "default" ],
   "$hover_text_bindings|default": [],
   "controls": [
      {
         "hover_text@$hover_text_panel": {
            "layer": 1
         }
      }
   ]
},

"hover_text_button": {
   "type": "button",
   "size": [ 1, 1 ],
   "anchor_from": "center",
   "anchor_to": "center",
   "layer": 200,
   "follows_cursor": true,
   "consume_hover_events": false,
   "always_handle_pointer": true,
   "focus_enabled": false,
   "focus_magnet_enabled": false,
   "tts_ignore_count": true,
   "tts_skip_message": true,
   "tts_inherit_siblings": true,
   "allow_clipping": false,
   "controls": [
      {
         "hover@NeBux_Buttons.hover_text_image_panel": {}
      }
   ]
},
    
