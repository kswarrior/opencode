 "slider_panel": {
  "controls": [
   {
    "title_text": {
     "anchor_from": "top_middle",
     "anchor_to": "top_middle",
     "offset": [
      0,
      4
     ],
     "size": [
      "100% - 12px",
      10
     ],
     "text": "$title_text",
     "type": "label"
    }
   },
   {
    "$slider_name": {
     "anchor_from": "bottom_middle",
     "anchor_to": "bottom_middle",
     "bindings": [
      {
       "binding_name": "#slider_value"
      },
      {
       "binding_name": "#slider_steps"
      },
      {
       "binding_type": "view",
       "source_property_name": "(101 - #slider_value * 101)",
       "target_property_name": "#val_0"
      },
      {
       "binding_type": "view",
       "source_property_name": "(100 * (#val_0 > 100))",
       "target_property_name": "#val0"
      },
      {
       "binding_type": "view",
       "source_property_name": "(#val_0 - #val0)",
       "target_property_name": "#val_1"
      },
      {
       "binding_type": "view",
       "source_property_name": "(10 * ((#val_1 > 10) + (#val_1 > 20) + (#val_1 > 30) + (#val_1 > 40) + (#val_1 > 50) + (#val_1 > 60) + (#val_1 > 70) + (#val_1 > 80) + (#val_1 > 90)))",
       "target_property_name": "#val1"
      },
      {
       "binding_type": "view",
       "source_property_name": "(#val_1 - #val1)",
       "target_property_name": "#val_2"
      },
      {
       "binding_type": "view",
       "source_property_name": "(1 * ((#val_2 > 1) + (#val_2 > 2) + (#val_2 > 3) + (#val_2 > 4) + (#val_2 > 5) + (#val_2 > 6) + (#val_2 > 7) + (#val_2 > 8) + (#val_2 > 9)))",
       "target_property_name": "#val2"
      },
      {
       "binding_type": "view",
       "source_property_name": "(((#val0 + #val1 + #val2) - 100) * -1)",
       "target_property_name": "#slider_val"
      }
     ],
     "property_bag": {
      "#slider_steps": "$slider_steps",
      "#slider_value": "$slider_value"
     },
     "size": [
      "100% - 8px",
      10
     ],
     "slider_steps": "$slider_steps"
    }
   }
  ],
  "layer": 2,
  "size": [
   "100%",
   28
  ],
  "type": "panel"
 },
