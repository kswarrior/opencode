         {
          "binding_type": "view",
          "source_control_name": "('h' + $id + '_t')",
          "source_property_name": "#text",
          "target_property_name": "#t"
         },
         {
          "binding_type": "view",
          "source_property_name": "(#y + #x + #s + #t)",
          "target_property_name": "#h_val"
         }
        ],
        "controls": [
         {
          "$hx_c": {
           "$prop_get": "#y_value",
           "$variable_name": "('ksb_' + $id + '_x')"
          }
         },
         {
          "$hy_c": {
           "$prop_get": "#x_value",
           "$variable_name": "('ksb_' + $id + '_y')"
          }
         },
         {
          "$hs_c": {
           "$prop_get": "#s_value",
           "$variable_name": "('ksb_' + $id + '_s')"
          }
         },
         {
          "$ht_c": {
           "$prop_get": "#tog_value",
           "$variable_name": "('ksb_' + $id + '_v')"
          }
         }
        ],
        "type": "panel"
       }
      }
     ],
     "type": "panel"
    }
   }
  ],
  "size": [
   0,
   0
  ],
  "type": "panel",
  "visible": false
