  "controls": [
   {
    "contained": {
     "$hvv": "('hval_' + $id)",
     "controls": [
      {
       "$hvv": {
        "$hs_c": "('h' + $id + '_s@ksb_main.value_panel')",
        "$ht_c": "('h' + $id + '_t@ksb_main.value_panel')",
        "$hx_c": "('h' + $id + '_x@ksb_main.value_panel')",
        "$hy_c": "('h' + $id + '_y@ksb_main.value_panel')",
        "bindings": [
         {
          "binding_type": "view",
          "source_control_name": "('h' + $id + '_x')",
          "source_property_name": "#text",
          "target_property_name": "#y"
         },
         {
          "binding_type": "view",
          "source_control_name": "('h' + $id + '_y')",
          "source_property_name": "#text",
          "target_property_name": "#x"
