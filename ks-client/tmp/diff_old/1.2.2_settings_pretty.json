{
 "display_panel": {
  "bindings": [
   {
    "binding_type": "view",
    "source_control_name": "ksb_display_toggle",
    "source_property_name": "#toggle_state",
    "target_property_name": "#visible"
   }
  ],
  "controls": [
   {
    "head": {
     "controls": [
      {
       "t": {
        "size": [
         "100%",
         20
        ],
        "text": "DISPLAY",
        "text_alignment": "center",
        "type": "label"
       }
      }
     ],
     "size": [
      "100%",
      20
     ],
     "type": "panel"
    }
   },
   {
    "soon": {
     "controls": [
      {
       "t": {
        "size": [
         "100%",
         20
        ],
        "text": "Coming Soon",
        "text_alignment": "center",
        "type": "label"
       }
      }
     ],
     "size": [
      "100%",
      20
     ],
     "type": "panel"
    }
   }
  ],
  "size": [
   "100%",
   "100%c"
  ],
  "type": "stack_panel"
 },
 "editor_opacity_button_panel": {
  "anchor_from": "bottom_right",
  "anchor_to": "bottom_left",
  "controls": [
   {
    "button@common_toggles.light_content_toggle": {
     "$button_content": "ksb_main.editor_opacity_icon",
     "$default_border_visible": false,
     "$hover_border_visible": false,
     "$toggle_name": "ksb_editor_opacity",
     "$toggle_view_binding_name": "ksb_editor_opacity_tog",
     "layer": 8,
     "size": [
      18,
      18
     ]
    }
   },
   {
    "bg": {
     "size": [
      "100%sm + 8px",
      "100%sm + 8px"
     ],
     "texture": "textures/ui/TabRightFrontBottomMost",
     "type": "image"
    }
   }
  ],
  "layer": 4,
  "offset": [
   -5,
   0
  ],
  "prevent_touch_input": true,
  "size": [
   "100%cm",
   "100%cm"
  ],
  "type": "input_panel"
 },
 "editor_panel": {
  "anchor_from": "left_middle",
  "anchor_to": "left_middle",
  "bindings": [
   {
    "binding_type": "view",
    "source_control_name": "slot_hotbar_editor_toggle",
    "source_property_name": "#toggle_state",
    "target_property_name": "#visible"
   },
   {
    "binding_type": "view",
    "source_control_name": "ksb_editor_opacity_tog",
    "source_property_name": "#toggle_state",
    "target_property_name": "#toggle"
   },
   {
    "binding_type": "view",
    "source_property_name": "('#' + #toggle)",
    "target_property_name": "#alpha"
   }
  ],
  "controls": [
   {
    "background@common.dialog_background_hollow_4": {}
   },
   {
    "content@common.scrolling_panel": {
     "$scrolling_content": "ksb_main.editor_stack_content",
     "$show_background": false,
     "layer": 2,
     "size": [
      "100% - 18px",
      "100% - 18px"
     ]
    }
   },
   {
    "tab_navigation_panep@ksb_main.tab_navigation_panep": {}
   },
   {
    "editor_opacity_button@ksb_main.editor_opacity_button_panel": {}
   }
  ],
  "layer": 555,
  "offset": [
   40,
   0
  ],
  "prevent_touch_input": true,
  "propagate_alpha": true,
  "property_bag": {
   "#false": 1.0,
   "#true": 0.3
  },
  "size": [
   190,
   182
  ],
  "type": "input_panel"
 },
 "editor_stack_content": {
  "controls": [
   {
    "home@ksb_main.home_panel": {}
   },
   {
    "editor@ksb_main.editor_stack_panel": {}
   },
   {
    "display@ksb_main.display_panel": {}
   }
  ],
  "size": [
   "100%",
   "100%c"
  ],
  "type": "stack_panel"
 },
