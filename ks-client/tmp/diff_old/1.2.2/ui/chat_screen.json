              "ac_padd": {
                "type": "panel",
                "size": [
                  1,
                  1
                ]
              }
            },
            {
              "shift@ks_chat_tweaks.shift": {}
            },
            {
              "ac_padd1": {
                "type": "panel",
                "size": [
                  1,
                  1
                ]
              }
            },
            {
              "up@ks_chat_tweaks.up": {}
            },
            {
              "ac_padd2": {
                "type": "panel",
                "size": [
                  1,
                  1
                ]
              }
            },
            {
              "down@ks_chat_tweaks.down": {}
            }
          ]
        }
      }
    ],
    "size": [
      67,
      16
    ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [
      -11,
      -17
    ]
  },
  "close_icon": {
    "type": "label",
    "text": "x"
  },
  "host_icon": {
    "type": "label",
    "text": "/"
  },
  "gear_image": {
    "size": [
      12,
      12
    ]
  },
