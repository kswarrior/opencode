    "size": [
      "100%-4px",
      "100%"
    ],
    "controls": [
      {
        "bg_ovr": {
          "type": "image",
          "texture": "textures/ui/White",
          "layer": 77,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "size": [
            "100%sm",
            "100%sm"
          ],
          "color": [
            0.0,
            0.5,
            0.0
          ],
          "controls": [
            {
              "auto_complete_item_renderer@common.item_renderer": {
                "size": [
                  9,
                  9
                ],
                "offset": [
                  2,
                  0
                ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "bindings": [
                  {
                    "binding_name": "#auto_complete_item",
                    "binding_type": "collection",
                    "binding_name_override": "#item_id_aux",
                    "binding_collection_name": "auto_complete"
                  }
                ],
                "layer": 79
              }
            }
          ],
          "clips_children": true
        }
      },
      {
        "text": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "text": "#text",
          "bindings": [
            {
              "binding_type": "collection",
              "binding_name": "#auto_complete_text",
              "binding_name_override": "#text",
              "binding_collection_name": "auto_complete"
            }
          ],
          "layer": 78,
          "color": [
            1.0,
            1.0,
            1.0
          ]
        }
      }
    ],
    "texture": "textures/ui/null"
  },
  "auto_complete_panel_contents_with_item/text": {
    "controls": [
      {
        "bg_ovr": {
          "type": "image",
          "texture": "textures/ui/black_ovr",
          "alpha": 0.7,
          "layer": -1,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        "auto_complete_item_renderer@common.item_renderer": {
          "size": [
            9,
            9
          ],
          "offset": [
            2,
            0
          ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "bindings": [
            {
              "binding_name": "#auto_complete_item",
              "binding_type": "collection",
              "binding_name_override": "#item_id_aux",
              "binding_collection_name": "auto_complete"
            }
          ],
          "layer": 0
        }
      }
    ],
    "layer": 76
  },
  "auto_complete_panel_contents_with_item/autocomplete_button": {
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "message_text_box_display_text",
        "source_property_name": "#item_name",
        "target_property_name": "#item_text_box"
      },
      {
        "binding_type": "collection_details",
        "binding_collection_name": "auto_complete",
        "binding_condition": "always"
      },
      {
        "binding_type": "collection",
        "binding_name": "#auto_complete_text",
        "binding_collection_name": "auto_complete"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#auto_complete_text - \\'/\\')",
        "target_property_name": "#command_filter_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#auto_complete_text - #item_text_box) = #command_filter_text)) and ((not (#auto_complete_text = \\'\\'))",
        "target_property_name": "#visible"
      }
    ]
  },
  "text_edit_box": {
    "size": [
      "fill",
      14
    ],
    "max_length": 32767,
    "$alpha": 0.7,
    "$text_background_hover": "chat.black_ovr",
    "$text_background_default": "chat.black_ovr"
  },
  "black_ovr": {
    "type": "image",
    "texture": "textures/ui/black_ovr",
    "alpha": "$alpha",
    "$alpha|default": 1.0
  }
}