{
  "chat_background": {
    "ignored": true
  },
  "chat_screen": {
    "close_on_player_hurt": false,
    "cache_screen": true
  },
  "messages_text/text": {
    "controls": [
      {
        "bg_ovr": {
          "type": "image",
          "texture": "textures/ui/black_ovr",
          "alpha": 0.7,
          "layer": -1,
          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      }
    ],
    "layer": 76
  },
  "messages_text": {
    "size": [
      "50%",
      "100%c"
    ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle"
  },
  "messages_scrolling_panel": {
    "size": [
      "100%-2px",
      "100%-177px"
    ],
    "offset": [
      1,
      -20.5
    ],
    "$jump_to_bottom_on_update": true
  },
  "chat_header": {
    "controls": [
      {
        "title_panel": {
          "type": "panel",
          "size": [
            "100%",
            20
          ],
          "controls": [
            {
              "title@chat.title_text": {
                "bindings": [
                  {
                    "binding_name": "#chat_title_visible",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "popup_dialog_factory": {
                "type": "factory",
                "control_ids": {
                  "toast_message": "@chat.popup_toast"
                }
              }
            },
            {
              "chat_header_content_area": {
                "type": "stack_panel",
                "orientation": "horizontal",
                "size": [
                  "100%c",
                  60
                ],
                "offset": [
                  -24,
                  1
                ],
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "bindings": [
                  {
                    "binding_name": "#chat_coordinate_dropdown_visible",
                    "binding_name_override": "#visible",
                    "binding_type": "global"
                  }
                ],
                "controls": [
                  {
                    "coordinate_dropdown@chat.coordinate_dropdown": {
                      "size": [
                        100,
                        20
                      ]
                    }
                  },
                  {
                    "cdp_padd": {
                      "type": "panel",
                      "size": [
                        1,
                        1
                      ]
                    }
                  },
                  {
                    "coordinates_panel": {
                      "type": "panel",
                      "size": [
                        "100%c",
                        16
                      ],
                      "controls": [
                        {
                          "coordinates_background_image": {
                            "type": "image",
                            "anchor_to": "center",
                            "anchor_from": "center",
                            "size": [
                              "100%c + 14px",
                              16
                            ],
                            "min_size": [
                              160,
                              16
                            ],
                            "texture": "textures/ui/black_ovr",
                            "layer": 1,
                            "controls": [
                              {
                                "coordinates_text": {
                                  "type": "label",
                                  "size": [
                                    "default",
                                    10
                                  ],
                                  "text": "#text",
                                  "color": "$main_header_text_color",
                                  "layer": 2,
                                  "bindings": [
                                    {
                                      "binding_name": "#coordinates_text",
                                      "binding_name_override": "#text"
                                    }
                                  ]
                                }
                              }
                            ],
                            "alpha": 0.7
                          }
                        }
                      ]
                    }
                  },
                  {
                    "cdp_padd1": {
                      "type": "panel",
                      "size": [
                        1,
                        1
                      ]
                    }
                  },
                  {
                    "copy_coordinate_button@chat.copy_coordinate_button": {
                      "size": [
                        16,
                        16
                      ]
                    }
                  },
                  {
                    "cdp_padd2": {
                      "type": "panel",
                      "size": [
                        1,
                        1
                      ]
                    }
                  },
                  {
                    "icon@common.gamepad_helper_y": {
                      "$gamepad_helper_size": [
                        16,
                        16
                      ],
                      "$gamepad_helper_icon_size": [
                        16,
                        16
                      ],
                      "$gamepad_helper_icon_image_size": [
                        26,
                        26
                      ],
                      "$icon_description_bind_type": "none",
                      "$gamepad_helper_visible_binding_name": "#is_using_gamepad"
                    }
                  },
                  {
                    "paste_button@chat.paste_button": {
                      "size": [
                        16,
                        16
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "texture": "textures/ui/null"
  },
  "chat_bottom_panel": {
    "size": [
      "100%",
      16
    ],
    "min_size": [
      "100%",
      16
    ],
    "controls": [
      {
        "keyboard_button@chat.keyboard_button": {}
      },
      {
        "cbp_padd": {
          "type": "panel",
          "size": [
            1,
            1
          ]
        }
      },
      {
        "host_main_button@chat.new_host_main_button": {
          "ignored": "$is_pregame",
          "$focus_override_up": "coordinate_dropdown_focus_id"
        }
      },
      {
        "cbp_padd1": {
          "type": "panel",
          "size": [
            1,
            1
          ]
        }
      },
      {
        "chat_settings@chat.chat_settings_button": {}
      },
      {
        "cbp_padd2": {
          "type": "panel",
          "size": [
            1,
            1
          ]
        }
      },
      {
        "text_box@chat.text_edit_box": {}
      },
      {
        "cbp_padd4": {
          "type": "panel",
          "size": [
            1,
            1
          ]
        }
      },
      {
        "send_button@chat.new_send_button": {}
      }
    ]
  },
  "send_button": {
    "size": [
      "100%c",
      20
    ]
  },
  "small_button": {
    "size": [
      20,
      14
    ],
    "$pressed_button_texture": "textures/ui/bl_bt",
    "$hover_button_texture": "textures/ui/bl_bt",
    "$default_button_texture": "textures/ui/bl_bt",
    "alpha": 0.7
  },
  "chat_screen_content/host_main_panel": {
    "layer": 8192,
    "offset": [
      0,
      -20
    ]
  },
  "new_send_button@common_buttons.light_content_button": {
    "$pressed_button_name": "button.send",
    "size": [
      46,
      14
    ],
    "layer": 296,
    "$button_content": "chat.new_send",
    "$pressed_button_texture": "textures/ui/bl_bt",
    "$hover_button_texture": "textures/ui/bl_bt",
    "$default_button_texture": "textures/ui/bl_bt"
  },
  "new_send": {
    "type": "image",
    "texture": "textures/ui/.texture_assets/.chat_icons/new_send.png",
    "size": [
      16,
      14
    ]
  },
  "new_host_main_button@common_buttons.light_content_button": {
    "$pressed_button_name": "button.host_toggle",
    "size": [
      20,
      14
    ],
    "$button_type_panel": "host_options.host_image_panel",
    "bindings": [
      {
        "binding_name": "#cheats_on",
        "binding_name_override": "#visible"
      },
      {
        "binding_name": "#host_main_button_focus_override_up",
        "binding_name_override": "#focus_change_up"
      },
      {
        "binding_name": "#host_main_button_focus_override_down",
        "binding_name_override": "#focus_change_down"
      }
    ],
    "$button_content": "chat.host_icon",
    "alpha": 0.7,
    "$pressed_button_texture": "textures/ui/bl_bt",
    "$default_button_texture": "textures/ui/bl_bt",
    "$hover_button_texture": "textures/ui/bl_bt"
  },
  "chat_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "autocomplete@chat.br_autocomplete": {}
          },
          {
            "close@common_buttons.light_content_button": {
              "offset": [
                6,
                3
              ],
              "$default_button_texture": "textures/ui/bl_bt",
              "$hover_button_texture": "textures/ui/bl_bt",
              "$pressed_button_texture": "textures/ui/bl_bt",
              "size": [
                26,
                16
              ],
              "anchor_from": "top_left",
              "anchor_to": "top_left",
              "$pressed_button_name": "button.menu_exit",
              "$button_content": "chat.close_icon"
            }
          }
        ]
      }
    ],
    "$is_ccs": true
  },
