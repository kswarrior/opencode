{
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "force_close_screen@hud.force_close_screen": {} }, // Hotkey 3 + F1
          { "f1_redirect@hud.f1_redirect": {} }, // Hotkey 2 + F1
          { "f8_redirect@hud.f8_redirect": {} }, // Hotkey 2 + F8
          { "f8_function@hud.f8_function": {} }, // Hotkey 2 + F8
          { "mainhand_durability@hud.mainhand_durability": { "ignored": "(not $show_mainhand_durability)" } },
          { "_toggles@hud._toggles": {} },
          { "attack_crosshair@hud.attack_crosshair": { "ignored": "(not $show_attack_crosshair)" } }
        ]
      }
    ]
  },

  "_toggles": {
    "type": "panel",
    "size": [0, 0],
    "controls": [
      { "__durability__@inv_content.component_toggle": { "$activator": "button.toggle_main_durability" } },
      { "__counters__@inv_content.component_toggle": { "$activator": "button.toggle_counters" } },
      { "__crosshair__@inv_content.component_toggle": { "$activator": "button.toggle_crosshair" } }
    ]
  },

  "force_close_screen": { // closes the topmost screen from screen stack
    "type": "button",
    "size": [0, 0],
    "layer": 30,
    "pressed_control": "pressed",
    "controls": [
      {
        "pressed": {
          "type": "input_panel",
          "button_mappings": [
            {
              "mapping_type": "global",
              "from_button_id": "button.hide_gui",
              "to_button_id": "button.menu_exit"
            }
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "mapping_type": "global",
        "from_button_id": "button.slot3",
        "to_button_id": "button.menu_select",
        "consume_event": false
      }
    ]
  },

  "f1_redirect": {
    "type": "button",
    "size": [0, 0],
    "layer": 25,
    "default_control": "default",
    "pressed_control": "pressed",
    "controls": [
      {
        "default": {
          "type": "input_panel",
          "button_mappings": [
            {
              "mapping_type": "global",
              "from_button_id": "button.hide_gui",
              "to_button_id": "button.consume"
            }
          ]
        }
      },
      {
        "pressed": {
          "type": "input_panel",
          "button_mappings": [
            {
              "mapping_type": "global",
              "from_button_id": "button.hide_gui",
              "to_button_id": "button.hide_gui_all"
            }
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "mapping_type": "global",
        "from_button_id": "button.slot2",
        "to_button_id": "button.menu_select",
        "consume_event": false
      }
    ]
  },

  "f8_redirect": {
    "type": "button",
    "size": [0, 0],
    "layer": 25,
    "pressed_control": "pressed",
    "controls": [
      {
        "pressed": {
          "type": "input_panel",
          "button_mappings": [
            {
              "mapping_type": "global",
              "from_button_id": "button.hide_paperdoll",
              "to_button_id": "button.hide_paperdoll_hud"
            }
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "mapping_type": "global",
        "from_button_id": "button.slot2",
        "to_button_id": "button.menu_select",
        "consume_event": false
      }
    ]
  },

  "f8_function": {
    "type": "button",
    "size": [0, 0],
    "layer": 25,
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "pressed_control": "pressed",
    "controls": [
      {
        "pressed": {
          "type": "input_panel",
          "button_mappings": [
            {
              "mapping_type": "global",
              "scope": "global",
              "from_button_id": "button.slot3",
              "to_button_id": "button.toggle_main_durability"
            },
            {
              "mapping_type": "global",
              "scope": "global",
              "from_button_id": "button.slot4",
              "to_button_id": "button.toggle_counters"
            },
            {
              "mapping_type": "global",
              "scope": "global",
              "from_button_id": "button.slot5",
              "to_button_id": "button.toggle_crosshair"
            }
          ],
          "controls": [
            {
              "tip_label": {
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [0, 5],
                "type": "image",
                "texture": "textures/ui/hud_tip_text_background",
                "size": ["100%c + 10px", "100%c + 8px"],
                "alpha": 0.5,
                "controls": [
                  {
                    "tip_label": {
                      "type": "label",
                      "text": "Toggle: §31 §r- Armor Durability §32 §r- Offhand\n§33 §r- Mainhand Durability §34 §r- Counters §35 §r- Attack Crosshair",
                      "text_alignment": "center",
                      "shadow": true
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "mapping_type": "global",
        "from_button_id": "button.hide_paperdoll",
        "to_button_id": "button.menu_select"
      }
    ]
  },

  "attack_crosshair": {
    "type": "collection_panel",
    "size": [9, 9],
    "collection_name": "right_helper_collection",
    "controls": [
      {
        "crosshair": {
          "type": "image",
          "texture": "textures/c_ui/attack_crosshair",
          "offset": [-0.5, -0.5],
          "collection_index": 0,
          "bindings": [
            {
              "binding_name": "(#helper_description = 'hudScreen.tooltip.hit')",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "right_helper_collection",
              "binding_condition": "always"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "__crosshair__",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "mainhand_durability": {
    "type": "stack_panel",
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "size": ["100%cm", "100%cm"],
    "offset": [-5, -5],
    "$item_collection_name": "hotbar_items",
    "collection_name": "$item_collection_name",
    "controls": [
      { "slot_1@durability_unit": { "collection_index": 0 } },
      { "slot_2@durability_unit": { "collection_index": 1 } },
      { "slot_3@durability_unit": { "collection_index": 2 } },
      { "slot_4@durability_unit": { "collection_index": 3 } },
      { "slot_5@durability_unit": { "collection_index": 4 } },
      { "slot_6@durability_unit": { "collection_index": 5 } },
      { "slot_7@durability_unit": { "collection_index": 6 } },
      { "slot_8@durability_unit": { "collection_index": 7 } },
      { "slot_9@durability_unit": { "collection_index": 8 } }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "__durability__",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "durability_unit@inv_content.item_durability": {
    "$fallback_texture": "_",
    "bindings": [
      {
        "binding_name": "#item_durability_total_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_name": "#slot_selected",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#item_durability_total_amount > 0) and #slot_selected)",
        "target_property_name": "#visible"
      }
    ]
  },

  "hud_screen": {
    "always_accepts_input": true
  }
}