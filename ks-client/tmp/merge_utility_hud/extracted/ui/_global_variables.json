{
  // You can put item aux id of any item you want here
  // and the count for that item will be shown
  // These IDs often change in newer versions
  // so you need to change them if you see wrong items
  // Or wait for an update of this pack

  // AUX IDs of items
  "$golden_apple_item_id": 18808832,
  "$enchanted_golden_apple_item_id": 18874368,
  "$ender_pearls_item_id": 29753344,

  // Don't change these
  "$totem_item_id": 39780352,
  "$chest_item_id": 3538946,
  "$utility_hud::is_active": true,

  // Some config options
  /*
    <----Formats---->
    Offset: [x, y]  - Positive x value means shift towards right
                      Positive y value means shift downwards
    Size: [w, h]    - w means Width, h means height
    Alpha: n        - n is a decimal value from 0 to 1
  */
  "$totem_button_offset": [0, "25%"],
  "$totem_button_size": [40, 40],
  "$totem_button_alpha": 0.7,

  "$show_totem_button": true,
  "$show_offhand_switch_button": true,
  "$show_armor_durability": true,
  "$show_offhand": true,
  "$show_mainhand_durability": true,
  "$show_counters": true,
  "$show_attack_crosshair": true,
  "$effects_per_column": 10, // minimum - 8, maximum - 20
  // top_left, top_middle, top_right
  // left_middle, center, right_middle
  // bottom_left, bottom_middle, bottom_right
  "$effects_overlay_anchor": "right_middle"
}