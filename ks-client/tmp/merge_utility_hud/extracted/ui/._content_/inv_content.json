{
  "namespace": "inv_content",

  "inventory_content": {
    "type": "panel",
    "controls": [
      { "fast_totem@inv_content.fast_totem": { "ignored": "(not $show_totem_button)" } },
      {
        "offhand_switch": {
          "type": "collection_panel",
          "size": [0, 0],
          "$item_collection_name": "offhand_items",
          "collection_name": "$item_collection_name",
          "controls": [
            { "0@inv_content.offhand_switcher": { "collection_index": 0 } }
          ]
        }
      },
      {
        "inv_open_text@inv_content.tag": {
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [-5, 5],
          "ignored": "$touch"
        }
      },
      {
        "inv_close@common.light_close_button": {
          "ignored": "(not $touch)",
          "offset": [-10, 10],
          "size": [19, 19],
          "$close_button_panel_size": [19, 19],
          "prevent_touch_input": true,
          "controls": [
            {"default@common.close_button_panel": {
              "$close_button_texture": "textures/c_ui/close_default"
            }},
            {"hover@common.close_button_panel": {
              "$close_button_texture": "textures/c_ui/close_hover"
            }},
            {"pressed@common.close_button_panel": {
              "$close_button_texture": "textures/c_ui/close_hover"
            }}
          ]
        }
      },
      // for fast switch
      { "fast_switch@inv_content.fast_switch": { "ignored": "(not $show_offhand_switch_button or not $touch)" } },
      { "fast_switch_content@inv_content.fast_switch_content": { "ignored": "(not $show_offhand_switch_button or not $touch)" } },
      {
        "_offhand_preview@inv_content.offhand_grid": {
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [-120, -1.5],
          "ignored": "(not $show_offhand)",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "__offhand__",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "_durability_panel": {
          "type": "stack_panel",
          "size": ["100%cm", "100%c"],
          "anchor_from": "bottom_left",
          "anchor_to": "bottom_left",
          "offset": [5, -5],
          "ignored": "(not $show_armor_durability)",
          "$item_collection_name": "armor_items",
          "collection_name": "$item_collection_name",
          "controls": [
            { "0@inv_content.item_durability": { "collection_index": 0, "$fallback_texture": "textures/ui/empty_armor_slot_helmet" } },
            { "1@inv_content.item_durability": { "collection_index": 1, "$fallback_texture": "textures/ui/empty_armor_slot_chestplate" } },
            { "2@inv_content.item_durability": { "collection_index": 2, "$fallback_texture": "textures/ui/empty_armor_slot_leggings" } },
            { "3@inv_content.item_durability": { "collection_index": 3, "$fallback_texture": "textures/ui/empty_armor_slot_boots" } }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "__durability__",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "_toggles": {
          "type": "panel",
          "size": [0, 0],
          "controls": [
            { "__durability__@inv_content.component_toggle": { "$activator": "button.toggle_durability" } },
            { "__offhand__@inv_content.component_toggle": { "$activator": "button.toggle_offhand" } }
          ]
        }
      },
      {
        "f8_function": {
          "type": "button",
          "size": [0, 0],
          "layer": 25,
          "pressed_control": "pressed",
          "controls": [
            {
              "pressed": {
                "type": "input_panel",
                "button_mappings": [
                  {
                    "mapping_type": "global",
                    "scope": "global",
                    "from_button_id": "button.slot1",
                    "to_button_id": "button.toggle_durability"
                  },
                  {
                    "mapping_type": "global",
                    "scope": "global",
                    "from_button_id": "button.slot2",
                    "to_button_id": "button.toggle_offhand"
                  }
                ]
              }
            }
          ],
          "button_mappings": [
            {
              "mapping_type": "global",
              "from_button_id": "button.hide_paperdoll",
              "to_button_id": "button.menu_select"
            }
          ]
        }
      }
    ]
  },

  "fast_switch_content@inv_content.component_toggle": {
    "size": [0, 0],
    "layer": 10,
    "$radio_toggle_group": true,
    "$toggle_group_forced_index": 0,
    "$toggle_name": "___",
    "toggle_default_state": true,
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "controls": [
      { "hotbar_grid@inv_content._hotbar_grid": {} },
      {
        "offhand_grid": {
          "type": "grid",
          "size": [22, 22],
          "offset": [-120, -1.5],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "grid_dimensions": [1, 1],
          "$item_collection_name": "offhand_items",
          "collection_name": "$item_collection_name",
          "controls": [
            {"offhand_grid_interact@inv_content.interact_button": {"grid_position": [0, 0]}}
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "mapping_type": "global",
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select"
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "fast_switch",
        "resolve_sibling_scope": true,
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "fast_switch@inv_content.component_toggle": {
    "size": [21, 21],
    "offset": [120, -2],
    "layer": 10,
    "$radio_toggle_group": true,
    "$toggle_group_forced_index": 1,
    "$toggle_name": "___",
    "toggle_default_state": false,
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "prevent_touch_input": true,
    "controls": [
      {"unchecked": {
        "type": "image",
        "texture": "textures/c_ui/switch_default"
      }},
      {"checked": {
        "type": "image",
        "texture": "textures/c_ui/switch_pressed"
      }},
      {"unchecked_hover": {
        "type": "image",
        "texture": "textures/c_ui/switch_hover"
      }},
      {"checked_hover": {
        "type": "image",
        "texture": "textures/c_ui/switch_pressed_hover"
      }}
    ],
    "button_mappings": [
      {
        "mapping_type": "pressed",
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select"
      }
    ]
  },

  "_hotbar_grid@common.hotbar_grid_template": {
    "offset": [-10, -1.5],
    "size": [180, 22],
    "grid_item_template": "inv_content.grid_item_for_hotbar"
  },

  "grid_item_for_hotbar": {
    "type": "panel",
    "size": [20, 22],
    "$item_collection_name": "hotbar_items",
    "controls": [
      { "interact_button@inv_content.interact_button": {} }
    ]
  },

  "interact_button": {
    "type": "button",
    "prevent_touch_input": true,
    "size": [20, 20],
    "layer": 1,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$item_collection_name",
        "binding_condition": "once"
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      }
    ]
  },

  "fast_totem": {
    "type": "button",
    "layer": 40,
    "draggable": "both",
    "prevent_touch_input": true,
    "$size|default": [0, 0],
    "$press|default": "pressed_pc",
    "variables": [
      {
        "requires": "$touch",
        "$size": "$totem_button_size",
        "$press": "pressed_touch"
      }
    ],
    "size": "$size",
    "offset": "$totem_button_offset",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "$press",
    "controls": [
      { "inv_slots@inv_content.totem_slots": {} },
      { "hotbar_slots@inv_content.hotbar_totem_slots": {} },
      {
        "default": {
          "type": "image",
          "alpha": "$totem_button_alpha",
          "texture": "textures/c_ui/totem"
        }
      },
      {
        "hover": {
          "type": "image",
          "alpha": "$totem_button_alpha",
          "texture": "textures/c_ui/totem"
        }
      },
      {
        "pressed_touch": {
          "ignored": "(not $touch)",
          "type": "image",
          "alpha": "$totem_button_alpha",
          "texture": "textures/c_ui/totem_pressed"
        }
      },
      {
        "pressed_pc": {
          "ignored": "$touch",
          "type": "input_panel",
          "button_mappings": [
            {
              "from_button_id": "button.hide_gui",
              "to_button_id": "button.equip_totem",
              "mapping_type": "global",
              "scope": "global"
            }
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "ignored": "$touch",
        "mapping_type": "global",
        "from_button_id": "button.slot1",
        "to_button_id": "button.menu_select",
        "consume_event": false
      },
      {
        "ignored": "(not $touch)",
        "mapping_type": "pressed",
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select",
        "consume_event": false,
        "button_up_right_of_first_refusal": true
      }
    ]
  },

  "offhand_switcher": {
    "type": "button",
    "layer": 25,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$item_collection_name"
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_inventory_cancel",
        "to_button_id": "button.consume", // to avoid getting soft locked in the inventory
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.hide_gui",
        "to_button_id": "button.container_slot_hovered",
        "mapping_type": "global"
      }
    ]
  },

  "offhand_grid": {
    "type": "grid",
    "size": [22, 22],
    "grid_dimensions": [1, 1],
    "$item_collection_name": "offhand_items",
    "collection_name": "$item_collection_name",
    "controls": [
      {
        "offhand_grid_item@inv_content._offhand_slot": {
          "grid_position": [0, 0]
        }
      }
    ]
  },

  "_offhand_slot": {
    "type": "panel",
    "controls": [
      {
        "background": {
          "type": "image",
          "texture": "textures/c_ui/offhand_slot"
        }
      },
      {
        "offhand_item@common.container_item": {
          "$cell_overlay_ref": "common.empty_panel",
          "$button_ref": "inv_content.dummy_button",
          "$background_images": "common.empty_panel"
        }
      },
      {
        "0@inv_content.item_durability": {
          "$ignore_renderer": true,
          "anchor_from": "left_middle",
          "anchor_to": "right_middle",
          "offset": [-10, 0.5]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "(not (#item_id_aux = -1))",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      }
    ]
  },

  "dummy_button": {
    "type": "button"
  },

  "item_durability": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": ["100%c", "100%cm"],
    "$ignore_renderer|default": false,
    "$fallback_texture|default": "",
    "controls": [
      {
        "item_icon": {
          "type": "image",
          "size": [16, 16],
          "allow_debug_missing_texture": false,
          "texture": "$fallback_texture",
          "ignored": "($ignore_renderer or ($fallback_texture = ''))",
          "controls": [ { "icon@common.item_renderer": {} } ],
          "bindings": [
            {
              "binding_name": "#item_id_aux",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "view",
              "source_property_name": "(1 * (#item_id_aux = -1))",
              "target_property_name": "#alpha"
            }
          ]
        }
      },
      { "spacer": { "type": "panel", "size": [5, 0] } },
      {
        "text_panel": {
          "type": "panel",
          "size": ["100%c", "100%sm"],
          "bindings": [
            {
              "binding_name": "(#item_durability_total_amount > 0)",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            }
          ],
          "controls": [
            { "durability_text@inv_content.durability_text": {} },
            {
              "warning": {
                "type": "image",
                "texture": "textures/c_ui/alert",
                "size": [8, 7],
                "anchor_from": "right_middle",
                "anchor_to": "right_middle",
                "$limit": 0.225,
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "durability_text",
                    "resolve_sibling_scope": true,
                    "source_property_name": "(not (#item_durability_current_amount > (#item_durability_total_amount * $limit)))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "durability_text": {
    "type": "label",
    "text": "#text",
    "localize": false,
    "shadow": true,
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "$prefix|default": "§z",
    "bindings": [
      {
        "binding_name": "#item_durability_total_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_name": "#item_durability_current_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#total_durability + (#total_durability < #item_durability_total_amount) * 1 - (#total_durability > #item_durability_total_amount) * 1)",
        "target_property_name": "#total_durability"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#item_durability_current_amount > 0) * #total_durability)",
        "target_property_name": "#current_durability"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#current_durability - (#item_durability_current_amount < #current_durability) * 1)",
        "target_property_name": "#current_durability"
      },
      {
        "binding_type": "view",
        "source_property_name": "($prefix + #current_durability + '/' + #total_durability)",
        "target_property_name": "#text"
      }
    ]
  },

  "tag": {
    "type": "image",
    "texture": "textures/ui/White",
    "size": ["100%c + 8px", "100%c + 6px"],
    "color": [0.14, 0.55, 0.27],
    "$text": "Inv Open",
    "controls": [
      {
        "label": {
          "type": "label",
          "text": "$text",
          "layer": 1
        }
      }
    ]
  },

  "hotbar_totem_slots": {
    "type": "collection_panel",
    "$item_collection_name": "hotbar_items",
    "collection_name": "$item_collection_name",
    "controls": [
      { "0@inv_content.totem_slot": { "collection_index": 0 } },
      { "1@inv_content.totem_slot": { "collection_index": 1 } },
      { "2@inv_content.totem_slot": { "collection_index": 2 } },
      { "3@inv_content.totem_slot": { "collection_index": 3 } },
      { "4@inv_content.totem_slot": { "collection_index": 4 } },
      { "5@inv_content.totem_slot": { "collection_index": 5 } },
      { "6@inv_content.totem_slot": { "collection_index": 6 } },
      { "7@inv_content.totem_slot": { "collection_index": 7 } },
      { "8@inv_content.totem_slot": { "collection_index": 8 } },
      { "9@inv_content.totem_slot": { "collection_index": 9 } }
    ]
  },

  "totem_slots": {
    "type": "collection_panel",
    "$item_collection_name": "inventory_items",
    "collection_name": "$item_collection_name",
    "controls": [
      { "0@inv_content.totem_slot": { "collection_index": 0 } },
      { "1@inv_content.totem_slot": { "collection_index": 1 } },
      { "2@inv_content.totem_slot": { "collection_index": 2 } },
      { "3@inv_content.totem_slot": { "collection_index": 3 } },
      { "4@inv_content.totem_slot": { "collection_index": 4 } },
      { "5@inv_content.totem_slot": { "collection_index": 5 } },
      { "6@inv_content.totem_slot": { "collection_index": 6 } },
      { "7@inv_content.totem_slot": { "collection_index": 7 } },
      { "8@inv_content.totem_slot": { "collection_index": 8 } },
      { "9@inv_content.totem_slot": { "collection_index": 9 } },
      { "10@inv_content.totem_slot": { "collection_index": 10 } },
      { "11@inv_content.totem_slot": { "collection_index": 11 } },
      { "12@inv_content.totem_slot": { "collection_index": 12 } },
      { "13@inv_content.totem_slot": { "collection_index": 13 } },
      { "14@inv_content.totem_slot": { "collection_index": 14 } },
      { "15@inv_content.totem_slot": { "collection_index": 15 } },
      { "16@inv_content.totem_slot": { "collection_index": 16 } },
      { "17@inv_content.totem_slot": { "collection_index": 17 } },
      { "18@inv_content.totem_slot": { "collection_index": 18 } },
      { "19@inv_content.totem_slot": { "collection_index": 19 } },
      { "20@inv_content.totem_slot": { "collection_index": 20 } },
      { "21@inv_content.totem_slot": { "collection_index": 21 } },
      { "22@inv_content.totem_slot": { "collection_index": 22 } },
      { "23@inv_content.totem_slot": { "collection_index": 23 } },
      { "24@inv_content.totem_slot": { "collection_index": 24 } },
      { "25@inv_content.totem_slot": { "collection_index": 25 } },
      { "26@inv_content.totem_slot": { "collection_index": 26 } }
    ]
  },

  "totem_slot": {
    "type": "input_panel",
    "prevent_touch_input": true,
    "consume_hover_events": false,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#item_id_aux = $totem_item_id)",
        "target_property_name": "#visible"
      }
    ],
    "button_mappings": [
      {
        "ignored": "$touch",
        "mapping_type": "global",
        "from_button_id": "button.equip_totem",
        "to_button_id": "button.container_auto_place",
        "consume_event": false
      },
      {
        "ignored": "(not $touch)",
        "mapping_type": "pressed",
        "from_button_id": "button.menu_select",
        "to_button_id": "button.container_auto_place",
        "consume_event": false
      }
    ]
  },

  "component_toggle@common.toggle": {
    "$toggle_name": "_",
    "size": [0, 0],
    "sound_volume": 0,
    "$activator": "",
    "toggle_default_state": true,
    "controls": [],
    "button_mappings": [
      {
        "from_button_id": "$activator",
        "to_button_id": "button.menu_select",
        "mapping_type": "global"
      }
    ]
  }
}