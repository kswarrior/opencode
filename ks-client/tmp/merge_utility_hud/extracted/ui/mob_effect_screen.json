{
  "namespace": "mob_effect",

  "mob_effect_screen": {
    "absorbs_input": false,
    "always_accepts_input": true,
    "force_render_below": true,
    "is_showing_menu": false,
		"close_on_player_hurt": false,
    "low_frequency_rendering": true,
    "$screen_animations": [],
    "$background_animations": [],
    "button_mappings": [],
    "$screen_bg_content": "common.empty_panel"
  },

  "mob_effect_content": {
    "controls": [
      {
        "effect_stack": {
          "type": "stack_panel",
          "anchor_from": "right_middle",
          "anchor_to": "right_middle",
          "offset": [-5, 0],
          "orientation": "horizontal",
          "size": ["100%c", "100%cm"],
          "controls": [ // 37 total effects
            { "3@mob_effect.effect_stack_module": { "$cindex": 3 } },
            { "2@mob_effect.effect_stack_module": { "$cindex": 2 } },
            { "1@mob_effect.effect_stack_module": { "$cindex": 1 } },
            { "0@mob_effect.effect_stack_module": { "$cindex": 0 } }
          ]
        }
      },
      {
        "inv_close@common.light_close_button": {
          "size": [19, 19],
          "ignored": "(not $touch)",
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [-10, 10],
          "prevent_touch_input": true,
          "controls": [
            {"default@common.close_button_panel": {
              "$close_button_texture": "textures/c_ui/close_default"
            }},
            {"hover@common.close_button_panel": {
              "$close_button_texture": "textures/c_ui/close_hover"
            }},
            {"pressed@common.close_button_panel": {
              "$close_button_texture": "textures/c_ui/close_hover"
            }}
          ]
        }
      }
    ]
  },

  "effect_stack_module": {
    "type": "stack_panel",
    "size": ["100%cm", "100%c"],
    "collection_name": "mob_effects_collection",
    "controls": [
      { "0@mob_effect.mob_effect_item_wrapper": { "$rindex": 0 } },
      { "1@mob_effect.mob_effect_item_wrapper": { "$rindex": 1 } },
      { "2@mob_effect.mob_effect_item_wrapper": { "$rindex": 2 } },
      { "3@mob_effect.mob_effect_item_wrapper": { "$rindex": 3 } },
      { "4@mob_effect.mob_effect_item_wrapper": { "$rindex": 4 } },
      { "5@mob_effect.mob_effect_item_wrapper": { "$rindex": 5 } },
      { "6@mob_effect.mob_effect_item_wrapper": { "$rindex": 6 } },
      { "7@mob_effect.mob_effect_item_wrapper": { "$rindex": 7 } },
      { "8@mob_effect.mob_effect_item_wrapper": { "$rindex": 8, "ignored": "(not (8 < $effects_per_column))" } },
      { "9@mob_effect.mob_effect_item_wrapper": { "$rindex": 9, "ignored": "(not (9 < $effects_per_column))" } },
      { "10@mob_effect.mob_effect_item_wrapper": { "$rindex": 10, "ignored": "(not (10 < $effects_per_column))" } },
      { "11@mob_effect.mob_effect_item_wrapper": { "$rindex": 11, "ignored": "(not (11 < $effects_per_column))" } },
      { "12@mob_effect.mob_effect_item_wrapper": { "$rindex": 12, "ignored": "(not (12 < $effects_per_column))" } },
      { "13@mob_effect.mob_effect_item_wrapper": { "$rindex": 13, "ignored": "(not (13 < $effects_per_column))" } },
      { "14@mob_effect.mob_effect_item_wrapper": { "$rindex": 14, "ignored": "(not (14 < $effects_per_column))" } },
      { "15@mob_effect.mob_effect_item_wrapper": { "$rindex": 15, "ignored": "(not (15 < $effects_per_column))" } },
      { "16@mob_effect.mob_effect_item_wrapper": { "$rindex": 16, "ignored": "(not (16 < $effects_per_column))" } },
      { "17@mob_effect.mob_effect_item_wrapper": { "$rindex": 17, "ignored": "(not (17 < $effects_per_column))" } },
      { "18@mob_effect.mob_effect_item_wrapper": { "$rindex": 18, "ignored": "(not (18 < $effects_per_column))" } },
      { "19@mob_effect.mob_effect_item_wrapper": { "$rindex": 19, "ignored": "(not (19 < $effects_per_column))" } }
    ]
  },

  "mob_effect_item_wrapper": {
    "type": "panel",
    "size": ["100%c + 2px", 20],
    "collection_index": "($rindex + $cindex * $effects_per_column)",
    "bindings": [
      {
        "binding_name": "#texture",
        "binding_type": "collection",
        "binding_collection_name": "mob_effects_collection"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#texture = 'textures/ui/redX1'))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      { "mob_effect_grid_item@mob_effect.mob_effect_grid_item": {} }
    ]
  },

  "mob_effect_grid_item": {
    "type": "image",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [ "100%c + 9px", 18 ],
    "texture": "textures/c_ui/effect_bg",
    "alpha": 0.8,
    "controls": [
      { "timer@mob_effect.effect_timer": { "layer": 2 } },
      { "icon@mob_effect.effect_icon": { "layer": 1 } }
    ]
  },

  "effect_timer": {
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "offset": [ -3, 0.5 ],
    "shadow": true,
    "color": [1, 1, 1]
  },

  "effect_icon": {
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "size": [12, 12],
    "offset": [ 3, 0 ]
  }
}