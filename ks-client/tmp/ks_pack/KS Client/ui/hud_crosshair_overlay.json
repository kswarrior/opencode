{
  "namespace": "hud_crosshair",

  // KS Crosshair Indicator — rebranded PandaMine's Crosshair Indicator v1.1.
  // Dynamic default/entity switch via right_helper_collection 'hit' check.
  // Lives in hud_crosshair_overlay (engine screen), NOT hud_screen root_panel:
  // vanilla cursor_renderer hides in 3rd-person (1.2.1+), so this overlay is
  // 1st-person only. hud_screen panels are always-on and drew over the player
  // face in 2nd/3rd-person — do NOT move this back to hud_screen.
  // Config: $ks_crosshair_v/size/alpha/offset in ui/_global_variables.json.
  // Textures: textures/ui/ks_crosshair_default/entity.png (rebranded copies).
  // Vanilla fallback: textures/ui/crosshair.png + gui/newgui/HUD/crosshair.png
  // (same default art, engine-hidden in 3rd).

  "ks_crosshair_panel": {
    "type": "panel",
    "size": "$ks_crosshair_size",
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": "$ks_crosshair_offset",
    "visible": "$ks_crosshair_v",
    "layer": 4,
    "controls": [
      {
        "ks_default@hud_crosshair.ks_crosshair_default": {}
      },
      {
        "ks_entity@hud_crosshair.ks_crosshair_entity": {}
      }
    ]
  },

  "ks_crosshair_default": {
    "type": "image",
    "texture": "textures/ui/ks_crosshair_default",
    "size": [ "100%", "100%" ],
    "alpha": "$ks_crosshair_alpha",
    "bindings": [
      {
        "binding_type": "collection",
        "binding_name": "(#helper_description - 'hudScreen.tooltip.')",
        "binding_name_override": "#get",
        "binding_collection_name": "right_helper_collection",
        "binding_condition": "always"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#get = '') or (not (#get = 'hit'))",
        "target_property_name": "#visible"
      }
    ]
  },

  "ks_crosshair_entity": {
    "type": "image",
    "texture": "textures/ui/ks_crosshair_entity",
    "size": [ "100%", "100%" ],
    "alpha": "$ks_crosshair_alpha",
    "bindings": [
      {
        "binding_type": "collection",
        "binding_name": "(#helper_description - 'hudScreen.tooltip.')",
        "binding_name_override": "#get",
        "binding_collection_name": "right_helper_collection",
        "binding_condition": "always"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#get - (#get - 'hit')) = 'hit')",
        "target_property_name": "#visible"
      }
    ]
  },

  "hud_crosshair_screen": {
    "type": "screen",
    "render_game_behind": true,
    "render_only_when_topmost": false,
    "should_steal_mouse": false,
    "is_showing_menu": false,
    "is_modal": false,
    "absorbs_input": false,
    "low_frequency_rendering": false,
    "controls": [
      {
        "ks_panel@hud_crosshair.ks_crosshair_panel": {}
      }
    ]
  }
}
