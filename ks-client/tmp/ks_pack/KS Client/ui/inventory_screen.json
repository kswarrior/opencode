{
  "namespace": "crafting",
  // Utility HUD V-1.5 (EchoRif) merged in full and rebranded into ks_uhud:
  // durability, counters, content toggle, custom close, help and F8 hotkeys.
  // Inventory HUD, slot hotbar buttons, F1/F3 keys and the KS crosshair remain
  // KS-native (the old KS DV V-2.5 durability module was replaced).

  // ---------- Utility HUD V-1.5 inventory screen flags ----------
  // Upstream flags let the content toggle reveal the world/HUD cleanly.
  "inventory_screen": {
    "force_render_below": true,
    "is_showing_menu": false,
    "absorbs_input": false,
    "always_accepts_input": true,
    "low_frequency_rendering": true,
    "$screen_animations": [],
    "$background_animations": [],
    "$screen_content": "crafting._inventory_screen_content",
    "$screen_bg_content": "common.empty_panel",
    "$is_crafting_screen": false,
    "$is_inventory_screen": true
  },

  "crafting_screen": {
    "$is_crafting_screen": true,
    "$is_inventory_screen": false
  },

  "_inventory_screen_content": {
    "type": "panel",
    "controls": [
      // Utility HUD V-1.5 extras: fast totem, offhand switch/preview, custom
      // close, armor durability panel and F8 toggles.
      {
        "_extra_content@ks_uhud.ks_uhud_inventory_content": {}
      },
      {
        "_content@crafting.recipe_inventory_screen_content": {
          "type": "input_panel",
          "prevent_touch_input": true,
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "__content_toggle__",
              "resolve_sibling_scope": true,
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      // ESC always closes the screen, even in clean (content hidden) mode.
      {
        "esc_redirect": {
          "type": "input_panel",
          "size": [0, 0],
          "layer": 20,
          "button_mappings": [
            {
              "mapping_type": "global",
              "from_button_id": "button.menu_cancel",
              "to_button_id": "button.menu_exit"
            }
          ]
        }
      },
      // Content toggle: visible on touch (22x22), keyboard activator on PC.
      // Starts ON so the inventory opens normally; pressing it hides the
      // vanilla inventory content and reveals the world/HUD cleanly.
      {
        "__content_toggle__@ks_uhud.ks_uhud_content_toggle_visuals": {
          "$size|default": [0, 0],
          "variables": [
            {
              "requires": "$touch",
              "$size": [22, 22]
            }
          ],
          "size": "$size",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [90, -1.5],
          "toggle_default_state": true,
          "$toggle_name": "__content_toggle__",
          "$activator": "button.scoreboard",
          "button_mappings": [
            {
              "from_button_id": "$activator",
              "to_button_id": "button.menu_select",
              "mapping_type": "global"
            },
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.menu_select",
              "mapping_type": "pressed"
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.menu_select",
              "mapping_type": "focused"
            }
          ]
        }
      }
    ]
  },

  "_crafting_limiter_visuals@inv_content.component_toggle": {
    "controls": [
      {"unchecked": {
        "type": "image",
        "texture": "textures/c_ui/craft_1"
      }},
      {"checked": {
        "type": "image",
        "texture": "textures/c_ui/craft_all"
      }},
      {"unchecked_hover": {
        "type": "image",
        "texture": "textures/c_ui/craft_1_hover",
        "controls": [
          {
            "hover_text@common.hover_text": {
              "layer": 50,
              "property_bag": {
                "#hover_text": "Craft One"
              }
            }
          }
        ]
      }},
      {"checked_hover": {
        "type": "image",
        "texture": "textures/c_ui/craft_all_hover",
        "controls": [
          {
            "hover_text@common.hover_text": {
              "layer": 50,
              "property_bag": {
                "#hover_text": "Craft All at Once"
              }
            }
          }
        ]
      }}
    ]
  },

  // Utility HUD V-1.5 help (?) button with keyboard/mobile tips.
  "toolbar_panel/toolbar_background/toolbar_stack_panel/help_button_panel": {
    "$size|default": [ "100%c", "100%" ],
    "variables": [
      {
        "requires": "$touch",
        "$size": [ "100%c + 4px", "100%" ]
      }
    ],
    "size": "$size",
    "controls": [
      {
        "help_button": {
          "layer": 5,
          "size": [15, 15],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "type": "button",
          "default_control": "default",
          "hover_control": "hover",
          "$default_texture": "textures/ui/ks_uhud/help_default",
          "$hover_texture": "textures/ui/ks_uhud/help_hover",
          "controls": [
            {
              "default": {
                "type": "image",
                "texture": "$default_texture"
              }
            },
            {
              "hover": {
                "type": "image",
                "$keyboard_text": "§f> Keyboard Shortcuts:\n\n§3Tab §r= Toggle Inventory\n§3Esc §r= Close Inventory\n§3F1 §r+ §3Hotkeys §r= Offhand Swap\n§3F8 §r+ §3Hotkeys §r= Toggle Components\n§31 §r= Fast Totem\n§33 §r+ §3F1 §r= Force Close Screen\n",
                "$switch_text": "§f> Press on switch button and then on\nan item to switch the item from hotbar\nto offhand or vice versa\n\n§f> Press the totem button to equip a\ntotem from your inventory\n",
                "$container_text": "\n§f> Close the inventory screen before\nopening other container screens\n(e.g - Chests, Crafting Table etc.)",
                "controls": [
                  {
                    "hover_text@common.hover_text": {
                      "layer": 50,
                      "ignored": "$touch",
                      "property_bag": {
                        "#hover_text": "($keyboard_text + $container_text)"
                      }
                    }
                  },
                  {
                    "hover_text_mobile@common.hover_text": {
                      "layer": 50,
                      "ignored": "(not $touch)",
                      "property_bag": {
                        "#hover_text": "($switch_text + $container_text)"
                      }
                    }
                  }
                ],
                "texture": "$hover_texture"
              }
            }
          ]
        }
      }
    ]
  },

  "crafting_panel_2x2": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "craft_all_button@crafting.output_grid_2x2_all": {} }
        ]
      }
    ]
  },

  "output_craft_one_button@crafting.output_no_coalesce_container_slot_button": {
    "$button_take_all_place_all": "button.container_auto_place_one",
    "$button_take_half_place_one": "button.container_auto_place_one",
    "$button_auto_place": "button.container_auto_place_one"
  },

  "output_craft_all_button@crafting.output_no_coalesce_container_slot_button": {
    "$button_take_all_place_all": "button.crafting_output_tertiary",
    "$button_take_half_place_one": "button.crafting_output_tertiary",
    "$button_auto_place": "button.crafting_output_tertiary"
  },

  "output_grid_2x2": {
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "_crafting_toggle_",
        "source_property_name": "(not #toggle_state)",
        "target_property_name": "#visible"
      }
    ]
  },

  "output_grid_2x2/work_bench_output": {
    "$button_ref": "crafting.output_craft_one_button"
  },

  "output_grid_2x2_all@crafting.output_grid_2x2": {
    "offset": [ 64, 26 ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "_crafting_toggle_",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "work_bench_output@crafting.inventory_container_item": {
          "$item_collection_name": "crafting_output_items",
          "$button_ref": "crafting.output_craft_all_button",
          "$background_images": "crafting.crafting_container_cell_images",
          "$item_renderer_binding_condition": "always",
          "$stack_count_binding_condition": "always",

          "$focus_id_binding_type": "none",
          "$focus_id": "crafting_output_item",
          "$focus_override_left_binding_type": "none",
          "$focus_override_left": "crafting_input_top_right",
          "$focus_override_up_binding_type": "none",
          "$focus_override_up": "help_button"
        }
      }
    ]
  },

  "player_armor_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "_crafting_toggle_@crafting._crafting_limiter_visuals": {
              "toggle_default_state": false,
              "visible": "$touch",
              "size": [19, 19],
              "layer": 1,
              "anchor_from": "top_left",
              "anchor_to": "top_left",
              "offset": [ 100, 60.5 ],
              "button_mappings": [
                {
                  "from_button_id": "button.menu_select",
                  "to_button_id": "button.menu_select",
                  "mapping_type": "pressed"
                },
                {
                  "from_button_id": "button.menu_ok",
                  "to_button_id": "button.menu_select",
                  "mapping_type": "focused"
                }
              ]
            }
          }
        ]
      }
    ]
  },

  "tab_navigation_panel_layout/navigation_tabs/content/construction_tab_panel": {
    "controls": [
      { "construction_tab@crafting.construction_tab": {} }
    ]
  },

  "tab_navigation_panel_layout/navigation_tabs/content/equipment_tab_panel": {
    "controls": [
      { "equipment_tab@crafting.equipment_tab": {} }
    ]
  },

  "tab_navigation_panel_layout/navigation_tabs/content/items_tab_panel": {
    "controls": [
      { "items_tab@crafting.items_tab": {} }
    ]
  },

  "tab_navigation_panel_layout/navigation_tabs/content/nature_tab_panel": {
    "controls": [
      { "nature_tab@crafting.nature_tab": {} }
    ]
  },

  "construction_tab": {
    "variables": []
  },

  "equipment_tab": {
    "variables": []
  },

  "nature_tab": {
    "variables": []
  },

  "items_tab": {
    "variables": []
  }
}
