{
  "namespace": "crafting",
  "recipe_inventory_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "1@crafting.master_totem_panel": {} }
        ]
      }
    ]
  },

  // KS Durability Viewer (merged Durability Viewer V-2.5 [RP] by EchoRif/ya_rifat):
  // armor + offhand durability column next to the inventory content.
  "recipe_inventory_screen_content/content_stack_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          { "durability_panel@crafting.ks_dv_durability_panel": {} }
        ]
      }
    ]
  },

  // ---------- KS Durability Viewer armor/offhand column (merged DV V-2.5 [RP]) ----------
  // Ported from upstream dvrp::durability_panel / dvrp::durability, rebranded to
  // crafting.ks_dv_*. Shows the durability of each worn armor piece + the offhand
  // item next to the inventory content. Off via $ks_dv_inventory.
  "ks_dv_durability_panel": {
    "type": "panel",
    "size": [ 0, "100%sm" ],
    "visible": "$ks_dv_inventory",
    "controls": [
      {
        "stack": {
          "type": "stack_panel",
          "size": [ "100%cm", "100%c" ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 5, 0 ],
          "$item_collection_name": "armor_items",
          "collection_name": "$item_collection_name",
          "controls": [
            {
              "0@crafting.ks_dv_durability": {
                "collection_index": 0
              }
            },
            {
              "1@crafting.ks_dv_durability": {
                "collection_index": 1
              }
            },
            {
              "2@crafting.ks_dv_durability": {
                "collection_index": 2
              }
            },
            {
              "3@crafting.ks_dv_durability": {
                "collection_index": 3
              }
            },
            {
              "4": {
                "type": "collection_panel",
                "$item_collection_name": "offhand_items",
                "collection_name": "$item_collection_name",
                "size": [ "100%c", "100%c" ],
                "controls": [
                  {
                    "o@crafting.ks_dv_durability": {
                      "collection_index": 0
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "ks_dv_durability": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", "100%cm + 5px" ],
    "layer": 5,
    "bindings": [
      {
        "binding_name": "#item_durability_total_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#item_durability_total_amount = 0))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "icon_bg": {
          "type": "image",
          "size": [ 20, 20 ],
          "texture": "textures/ui/hud_tip_text_background",
          "alpha": 0.5,
          "controls": [
            {
              "renderer@common.item_renderer": {
                "size": [ 16, 16 ]
              }
            }
          ]
        }
      },
      {
        "wrapper": {
          "type": "panel",
          "size": [ "100%c", "100%sm" ],
          "controls": [
            {
              "durability_text": {
                "type": "label",
                "shadow": true,
                "text": "#text",
                "property_bag": {
                  "#current_durability": 0,
                  "#total_durability": 0
                },
                "bindings": [
                  {
                    "binding_name": "#item_durability_total_amount",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection_name"
                  },
                  {
                    "binding_name": "#item_durability_current_amount",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection_name"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "visible",
                    "source_property_name": "(#total_durability + (#total_durability < #item_durability_total_amount) * 1 - (#total_durability > #item_durability_total_amount) * 1)",
                    "target_property_name": "#total_durability"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "visible",
                    "source_property_name": "(#current_durability + (#current_durability < #item_durability_current_amount) * 1 - (#current_durability > #item_durability_current_amount) * 1)",
                    "target_property_name": "#current_durability"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "('\u00a7z ' + #current_durability + '/' + #total_durability)",
                    "target_property_name": "#text"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "master_totem_panel": {
    "type": "panel",
    "size": [ 30, 30 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ -125, -35 ],
    "layer": 100,
    "clips_children": true,
    "controls": [
      { "exit_button@crafting.exit_btn": {} },
      { "equip_system@crafting.equip_panel": {} }
    ]
  },

  "exit_btn": {
    "type": "button",
    "size": [ "100%", "100%" ],
    "consume_hover_events": false,
    "controls": [
      { "bg": { "type": "image", "texture": "textures/totem/close_button", "size": [ "100%", "100%" ] } }
    ],
    "button_mappings": [
      { "from_button_id": "button.menu_select", "to_button_id": "button.menu_exit", "mapping_type": "pressed" }
    ],
    "bindings": [
      { "binding_name": "#item_id_aux", "binding_type": "collection", "binding_collection_name": "offhand_items" },
      { "binding_type": "view", "source_property_name": "(not (#item_id_aux = -1))", "target_property_name": "#visible" }
    ]
  },

  "equip_panel": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "clips_children": true,
    "controls": [
      { "bg": { "type": "image", "texture": "textures/totem/totem_button", "size": [ "100%", "100%" ], "layer": 1 } },
      { "inv_scanner@crafting.inventory_scanner": { "layer": 2 } },
      { "hotbar_scanner@crafting.hotbar_scanner": { "layer": 2 } }
    ],
    "bindings": [
      { "binding_name": "#item_id_aux", "binding_type": "collection", "binding_collection_name": "offhand_items" },
      { "binding_type": "view", "source_property_name": "(#item_id_aux = -1)", "target_property_name": "#visible" }
    ]
  },

  "scanner_slot_template": {
    "type": "panel",
    "size": [ "100%", 0 ],
    "controls": [
      {
        "action_button": {
          "type": "button",
          "size": [ "100%", "100%x" ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "consume_hover_events": false,
          "bindings": [
            { "binding_type": "collection_details", "binding_collection_name": "$target_collection" },
            { "binding_name": "#hover_text", "binding_type": "collection", "binding_collection_name": "$target_collection" },
            { "binding_type": "view", "source_property_name": "(not ((#hover_text - 'Totem') = #hover_text))", "target_property_name": "#visible" }
          ],
          "button_mappings": [
            { "from_button_id": "button.menu_select", "to_button_id": "button.container_auto_place", "mapping_type": "pressed", "consume_event": false },
            { "from_button_id": "button.slot1", "to_button_id": "button.container_auto_place", "mapping_type": "global", "consume_event": false },
            { "from_button_id": "button.menu_ok", "to_button_id": "button.container_auto_place", "mapping_type": "focused", "consume_event": false }
          ]
        }
      }
    ]
  },

