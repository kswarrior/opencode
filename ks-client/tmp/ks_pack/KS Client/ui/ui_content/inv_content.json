{
  "namespace": "inv_content",

  // Utility HUD V-1.5 content lives in ui/ks_modules/ks_utility_hud/.
  // component_toggle base kept for the crafting limiter, content toggle and F8 toggles.
  "inventory_content": {
    "type": "panel",
    "size": [0, 0],
    "controls": []
  },

  "component_toggle@common.toggle": {
    "$toggle_name": "_",
    "size": [0, 0],
    "sound_volume": 0,
    "$activator": "",
    "toggle_default_state": true,
    "controls": [],
    "button_mappings": [
      {
        "from_button_id": "$activator",
        "to_button_id": "button.menu_select",
        "mapping_type": "global"
      }
    ]
  }
}