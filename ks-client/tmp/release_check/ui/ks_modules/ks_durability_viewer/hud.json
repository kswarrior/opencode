{
  "namespace": "ks_dv_hud",

  // KS Durability Viewer (merged Durability Viewer V-2.5 [RP] by EchoRif/ya_rifat,
  // rebranded to KS `ks_dv_*`). Selected hotbar-slot durability readout: one
  // tooltip-style text box next to the hotbar showing cur/total for the slot
  // that is selected and damageable. Anchors mirrored from upstream
  // bottom_right -> bottom_left so the KS Inventory HUD grid keeps the
  // bottom-right corner ($ks_dv_mainhand_* globals).

  "mainhand_durability": {
    "type": "panel",
    "size": "$ks_dv_mainhand_offset",
    "max_size": [
      "100% - 100%c",
      "100% - 100%c"
    ],
    "anchor_from": "$ks_dv_mainhand_anchor_from",
    "anchor_to": "$ks_dv_mainhand_anchor_to",
    "controls": [
      {
        "mainhand_durability_content@ks_dv_hud.mainhand_durability_content": {}
      }
    ]
  },

  "mainhand_durability_content": {
    "type": "stack_panel",
    "anchor_from": "top_right",
    "anchor_to": "bottom_left",
    "size": [
      "100%cm",
      "100%cm"
    ],
    "collection_name": "hotbar_items",
    "controls": [
      {
        "slot_1@ks_dv_hud.durability_text": {
          "collection_index": 0
        }
      },
      {
        "slot_2@ks_dv_hud.durability_text": {
          "collection_index": 1
        }
      },
      {
        "slot_3@ks_dv_hud.durability_text": {
          "collection_index": 2
        }
      },
      {
        "slot_4@ks_dv_hud.durability_text": {
          "collection_index": 3
        }
      },
      {
        "slot_5@ks_dv_hud.durability_text": {
          "collection_index": 4
        }
      },
      {
        "slot_6@ks_dv_hud.durability_text": {
          "collection_index": 5
        }
      },
      {
        "slot_7@ks_dv_hud.durability_text": {
          "collection_index": 6
        }
      },
      {
        "slot_8@ks_dv_hud.durability_text": {
          "collection_index": 7
        }
      },
      {
        "slot_9@ks_dv_hud.durability_text": {
          "collection_index": 8
        }
      }
    ]
  },

  "durability_text": {
    "type": "image",
    "size": [
      "100%c + 7px",
      "100%c + 4px"
    ],
    "texture": "textures/ui/hud_tip_text_background",
    "$item_collection_name": "hotbar_items",
    "offset": [
      -5,
      -5
    ],
    "alpha": 0.7,
    "controls": [
      {
        "text": {
          "type": "label",
          "shadow": true,
          "layer": 1,
          "offset": [
            1,
            0
          ],
          "text": "#text",
          "property_bag": {
            "#current_durability": 0,
            "#total_durability": 0
          },
          "bindings": [
            {
              "binding_name": "#item_durability_total_amount",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_name": "#item_durability_current_amount",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "view",
              "binding_condition": "visible",
              "source_property_name": "(#total_durability + (#total_durability < #item_durability_total_amount) * 1 - (#total_durability > #item_durability_total_amount) * 1)",
              "target_property_name": "#total_durability"
            },
            {
              "binding_type": "view",
              "binding_condition": "visible",
              "source_property_name": "(#current_durability + (#current_durability < #item_durability_current_amount) * 1 - (#current_durability > #item_durability_current_amount) * 1)",
              "target_property_name": "#current_durability"
            },
            {
              "binding_type": "view",
              "source_property_name": "('Durability: ' + #current_durability + '/' + #total_durability)",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#item_durability_total_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#item_durability_total_amount = 0) and #slot_selected)",
        "target_property_name": "#visible"
      },
      {
        "binding_name": "#slot_selected",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      }
    ]
  }
}
