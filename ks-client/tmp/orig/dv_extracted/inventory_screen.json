{
  "namespace": "crafting",
  "recipe_inventory_screen_content/content_stack_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "durability_panel@dvrp::durability_panel": {}
          }
        ]
      }
    ]
  },
  "dvrp::durability_panel": {
    "type": "panel",
    "size": [
      0,
      "100%sm"
    ],
    "controls": [
      {
        "stack": {
          "type": "stack_panel",
          "size": [
            "100%cm",
            "100%c"
          ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [
            5,
            0
          ],
          "$item_collection_name": "armor_items",
          "collection_name": "$item_collection_name",
          "controls": [
            {
              "0@dvrp::durability": {
                "collection_index": 0
              }
            },
            {
              "1@dvrp::durability": {
                "collection_index": 1
              }
            },
            {
              "2@dvrp::durability": {
                "collection_index": 2
              }
            },
            {
              "3@dvrp::durability": {
                "collection_index": 3
              }
            },
            {
              "4": {
                "type": "collection_panel",
                "$item_collection_name": "offhand_items",
                "collection_name": "$item_collection_name",
                "size": [
                  "100%c",
                  "100%c"
                ],
                "controls": [
                  {
                    "o@dvrp::durability": {
                      "collection_index": 0
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "dvrp::durability": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [
      "100%c",
      "100%cm + 5px"
    ],
    "layer": 5,
    "bindings": [
      {
        "binding_name": "#item_durability_total_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#item_durability_total_amount = 0))",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "icon_bg": {
          "type": "image",
          "size": [
            20,
            20
          ],
          "texture": "textures/ui/hud_tip_text_background",
          "alpha": 0.5,
          "controls": [
            {
              "renderer@common.item_renderer": {
                "size": [
                  16,
                  16
                ]
              }
            }
          ]
        }
      },
      {
        "wrapper": {
          "type": "panel",
          "size": [
            "100%c",
            "100%sm"
          ],
          "controls": [
            {
              "durability_text": {
                "type": "label",
                "shadow": true,
                "text": "#text",
                "property_bag": {
                  "#current_durability": 0,
                  "#total_durability": 0
                },
                "bindings": [
                  {
                    "binding_name": "#item_durability_total_amount",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection_name"
                  },
                  {
                    "binding_name": "#item_durability_current_amount",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection_name"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "visible",
                    "source_property_name": "(#total_durability + (#total_durability < #item_durability_total_amount) * 1 - (#total_durability > #item_durability_total_amount) * 1)",
                    "target_property_name": "#total_durability"
                  },
                  {
                    "binding_type": "view",
                    "binding_condition": "visible",
                    "source_property_name": "(#current_durability + (#current_durability < #item_durability_current_amount) * 1 - (#current_durability > #item_durability_current_amount) * 1)",
                    "target_property_name": "#current_durability"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "('\u00a7z ' + #current_durability + '/' + #total_durability)",
                    "target_property_name": "#text"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}