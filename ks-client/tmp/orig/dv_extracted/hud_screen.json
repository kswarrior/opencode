{
  "shield_durability": {
    "type": "panel",
    "size": "$shield_durability_offset",
    "max_size": [
      "100% - 100%c",
      "100% - 100%c"
    ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "controls": [
      {
        "shield_durability_content@hud.shield_durability_content": {}
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "shield_data_control",
        "resolve_sibling_scope": true,
        "source_property_name": "(not (#preserved_text = ''))",
        "target_property_name": "#visible"
      }
    ]
  },
  "shield_durability_content": {
    "type": "image",
    "size": [
      "100%c + 7px",
      "100%c + 4px"
    ],
    "texture": "textures/ui/hud_tip_text_background",
    "anchor_from": "top_right",
    "anchor_to": "bottom_left",
    "alpha": 0.7,
    "controls": [
      {
        "shield_preserved_text": {
          "type": "label",
          "text": "#text",
          "layer": 1,
          "shadow": true,
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "shield_data_control",
              "source_property_name": "(#preserved_text - 'durabilityShield:')",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ]
  },
  "armor_type": {
    "type": "panel",
    "size": "$armor_durability_offset",
    "max_size": [
      "100% - 100%c",
      "100% - 100%c"
    ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "controls": [
      {
        "armor_type_content@hud.armor_type_content": {}
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "armor_data_control",
        "resolve_sibling_scope": true,
        "source_property_name": "(not (#preserved_text = ''))",
        "target_property_name": "#visible"
      }
    ]
  },
  "armor_type_content": {
    "type": "image",
    "size": [
      "100%c - 41px",
      "100%cm + 4px"
    ],
    "texture": "textures/ui/hud_tip_text_background",
    "anchor_from": "top_right",
    "anchor_to": "bottom_left",
    "alpha": 0.7,
    "controls": [
      {
        "armor_type_panel": {
          "type": "stack_panel",
          "size": [
            "100%c",
            "100%c"
          ],
          "orientation": "vertical",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [
            3.5,
            0
          ],
          "$texture_path_custom": "textures/armor_icons_durability/",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "armor_data_control",
              "source_property_name": "(#texture_name_all - ('%.8s' * #texture_name_all))",
              "target_property_name": "#armor_durability_text"
            }
          ],
          "controls": [
            {
              "helmet_type": {
                "type": "image",
                "size": [
                  16,
                  16
                ],
                "allow_debug_missing_texture": false,
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "armor_data_control",
                    "source_property_name": "($texture_path_custom + '%.2s' * #texture_name_all)",
                    "target_property_name": "#texture"
                  }
                ]
              }
            },
            {
              "chestplate_type": {
                "type": "image",
                "size": [
                  16,
                  16
                ],
                "allow_debug_missing_texture": false,
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "armor_data_control",
                    "source_property_name": "($texture_path_custom + ('%.4s' * #texture_name_all - '%.2s' * #texture_name_all))",
                    "target_property_name": "#texture"
                  }
                ]
              }
            },
            {
              "leggings_type": {
                "type": "image",
                "size": [
                  16,
                  16
                ],
                "allow_debug_missing_texture": false,
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "armor_data_control",
                    "source_property_name": "($texture_path_custom + ('%.6s' * #texture_name_all - '%.4s' * #texture_name_all))",
                    "target_property_name": "#texture"
                  }
                ]
              }
            },
            {
              "boots_type": {
                "type": "image",
                "size": [
                  16,
                  16
                ],
                "allow_debug_missing_texture": false,
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "armor_data_control",
                    "source_property_name": "($texture_path_custom + ('%.8s' * #texture_name_all - '%.6s' * #texture_name_all))",
                    "target_property_name": "#texture"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "armor_durability_text": {
          "type": "label",
          "text": "#text",
          "shadow": true,
          "line_padding": 6,
          "layer": 1,
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [
            -3.5,
            2
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "armor_type_panel",
              "source_property_name": "#armor_durability_text",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ]
  },
  "mainhand_durability": {
    "type": "panel",
    "size": "$mainhand_durability_offset",
    "max_size": [
      "100% - 100%c",
      "100% - 100%c"
    ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "controls": [
      {
        "mainhand_durability_content@hud.mainhand_durability_content": {}
      }
    ]
  },
  "gui_hotbar_grid_item/hotbar_parent": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "replace",
        "control_name": "item_dura",
        "value": [
          {
            "item_dura@common.animated_durability_bar": {
              "$durability_bar_required|default": true,
              "$item_collection_name": "$hotbar_collection_name",
              "layer": 5
            }
          }
        ]
      }
    ]
  },
  "gui_hotbar_grid_item_pocket/hotbar_parent": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "replace",
        "control_name": "item_dura",
        "value": [
          {
            "item_dura@common.animated_durability_bar": {
              "$durability_bar_required|default": true,
              "$item_collection_name": "$hotbar_collection_name",
              "layer": 5
            }
          }
        ]
      }
    ]
  },
  "mainhand_durability_content": {
    "type": "stack_panel",
    "anchor_from": "top_left",
    "anchor_to": "bottom_right",
    "size": [
      "100%cm",
      "100%cm"
    ],
    "collection_name": "hotbar_items",
    "controls": [
      {
        "slot_1@durability_text": {
          "collection_index": 0
        }
      },
      {
        "slot_2@durability_text": {
          "collection_index": 1
        }
      },
      {
        "slot_3@durability_text": {
          "collection_index": 2
        }
      },
      {
        "slot_4@durability_text": {
          "collection_index": 3
        }
      },
      {
        "slot_5@durability_text": {
          "collection_index": 4
        }
      },
      {
        "slot_6@durability_text": {
          "collection_index": 5
        }
      },
      {
        "slot_7@durability_text": {
          "collection_index": 6
        }
      },
      {
        "slot_8@durability_text": {
          "collection_index": 7
        }
      },
      {
        "slot_9@durability_text": {
          "collection_index": 8
        }
      }
    ]
  },
  "durability_text": {
    "type": "image",
    "size": [
      "100%c + 7px",
      "100%c + 4px"
    ],
    "texture": "textures/ui/hud_tip_text_background",
    "$item_collection_name": "hotbar_items",
    "offset": [
      -5,
      -5
    ],
    "alpha": 0.7,
    "controls": [
      {
        "text": {
          "type": "label",
          "shadow": true,
          "layer": 1,
          "offset": [
            1,
            0
          ],
          "text": "#text",
          "property_bag": {
            "#current_durability": 0,
            "#total_durability": 0
          },
          "bindings": [
            {
              "binding_name": "#item_durability_total_amount",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_name": "#item_durability_current_amount",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "view",
              "binding_condition": "visible",
              "source_property_name": "(#total_durability + (#total_durability < #item_durability_total_amount) * 1 - (#total_durability > #item_durability_total_amount) * 1)",
              "target_property_name": "#total_durability"
            },
            {
              "binding_type": "view",
              "binding_condition": "visible",
              "source_property_name": "(#current_durability + (#current_durability < #item_durability_current_amount) * 1 - (#current_durability > #item_durability_current_amount) * 1)",
              "target_property_name": "#current_durability"
            },
            {
              "binding_type": "view",
              "source_property_name": "('Durability: ' + #current_durability + '/' + #total_durability)",
              "target_property_name": "#text"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#item_durability_total_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#item_durability_total_amount = 0) and #slot_selected)",
        "target_property_name": "#visible"
      },
      {
        "binding_name": "#slot_selected",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      }
    ]
  },
  "durability_root_panel": {
    "type": "panel",
    "size": [
      "100%",
      "100%"
    ],
    "controls": [
      {
        "shield_data_control": {
          "type": "panel",
          "$update_string": "durabilityShield:",
          "size": [
            0,
            0
          ],
          "bindings": [
            {
              "binding_name": "#hud_subtitle_text_string"
            },
            {
              "binding_name": "#hud_subtitle_text_string",
              "binding_name_override": "#preserved_text",
              "binding_condition": "visibility_changed"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#hud_subtitle_text_string = #preserved_text) and not ((#hud_subtitle_text_string - $update_string) = #hud_subtitle_text_string))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "armor_data_control": {
          "type": "panel",
          "$update_string": "durabilityArmor:",
          "size": [
            0,
            0
          ],
          "bindings": [
            {
              "binding_name": "#hud_title_text_string"
            },
            {
              "binding_name": "#hud_title_text_string",
              "binding_name_override": "#preserved_text",
              "binding_condition": "visibility_changed"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not (#hud_title_text_string = #preserved_text) and not ((#hud_title_text_string - $update_string) = #hud_title_text_string))",
              "target_property_name": "#visible"
            },
            {
              "binding_type": "view",
              "source_property_name": "(#preserved_text - 'durabilityArmor:')",
              "target_property_name": "#texture_name_all"
            }
          ]
        }
      },
      {
        "mainhand_durability@hud.mainhand_durability": {
          "ignored": "(not $view_mainhand_durability)"
        }
      },
      {
        "shield_durability@hud.shield_durability": {
          "ignored": "(not $view_shield_durability)"
        }
      },
      {
        "armor_durability@hud.armor_type": {
          "ignored": "(not $view_armor_durability)"
        }
      }
    ]
  },
  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "root_durability@hud.durability_root_panel": {}
          }
        ]
      }
    ]
  }
}