{
  "highlight_slot_panel/highlight": {
    "bindings": []
  },
  "highlight_slot_panel/highlight/hover_text": {
    "property_bag": {
      "#total_durability": 0
    },
    "$conditional_ignore|default": "$view_durability_in_inventory",
    "variables": [
      {
        "requires": "($item_collection_name = 'recipe_book')",
        "$conditional_ignore": "$view_durability_in_recipe_book"
      }
    ],
    "bindings": [
      {
        "binding_name": "$hover_text_binding_name",
        "binding_name_override": "#hover_text_pre",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "ignored": "$conditional_ignore",
        "binding_type": "view",
        "source_property_name": "#hover_text_pre",
        "target_property_name": "#hover_text"
      },
      {
        "ignored": "(not $conditional_ignore)",
        "binding_name": "#item_durability_total_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "ignored": "(not $conditional_ignore)",
        "binding_name": "#item_durability_current_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "ignored": "(not $conditional_ignore)",
        "binding_type": "view",
        "source_property_name": "(#total_durability + (#total_durability < #item_durability_total_amount) * 1 - (#total_durability > #item_durability_total_amount) * 1)",
        "target_property_name": "#total_durability"
      },
      {
        "ignored": "(not $conditional_ignore)",
        "binding_type": "view",
        "source_property_name": "((#item_durability_current_amount > 0) * #total_durability)",
        "target_property_name": "#current_durability"
      },
      {
        "ignored": "(not $conditional_ignore)",
        "binding_type": "view",
        "source_property_name": "(#current_durability - (#item_durability_current_amount < #current_durability) * 1)",
        "target_property_name": "#current_durability"
      },
      {
        "ignored": "(not $conditional_ignore)",
        "binding_type": "view",
        "source_property_name": "('\n\u00a77Durability: ' + #current_durability + '/' + #total_durability)",
        "target_property_name": "#durability"
      },
      {
        "ignored": "(not $conditional_ignore)",
        "binding_type": "view",
        "source_property_name": "(#hover_text_pre + (((#item_durability_total_amount = 0) + #durability) - ('true' + #durability) - 'false') + #item_durability_current_amount)",
        "target_property_name": "#hover_text"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#hover_text_pre = ''))",
        "target_property_name": "#visible"
      }
    ]
  },
  "blink_anim": {
    "anim_type": "alpha",
    "duration": 2,
    "from": 1,
    "to": 0,
    "next": "@common.blink_part_2"
  },
  "blink_part_2": {
    "anim_type": "alpha",
    "duration": 2,
    "from": 0,
    "to": 1,
    "next": "@common.blink_anim"
  },
  "animated_durability_bar": {
    "type": "panel",
    "size": [
      "100%cm",
      "100%cm"
    ],
    "controls": [
      {
        "durability_bar@common.durability_bar": {
          "bindings": [
            {
              "binding_name": "#item_durability_visible",
              "binding_name_override": "#touch_progress_bar_visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_name": "#item_durability_total_amount",
              "binding_name_override": "#progress_bar_total_amount",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_name": "#item_durability_current_amount",
              "binding_name_override": "#progress_bar_current_amount",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "view",
              "source_property_name": "((#progress_bar_current_amount / #progress_bar_total_amount * 100) > 20)",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "durability_bar_animated@common.durability_bar": {
          "alpha": "@common.blink_anim",
          "propagate_alpha": true,
          "bindings": [
            {
              "binding_name": "#item_durability_visible",
              "binding_name_override": "#touch_progress_bar_visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_name": "#item_durability_total_amount",
              "binding_name_override": "#progress_bar_total_amount",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_name": "#item_durability_current_amount",
              "binding_name_override": "#progress_bar_current_amount",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#progress_bar_current_amount / #progress_bar_total_amount * 100) > 20))",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },
  "selected_item_details_factory": {
    "ignored": true
  },
  "common_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "focus_grabber": {
              "ignored": "(not $touch)",
              "type": "button",
              "size": [
                0,
                0
              ],
              "focus_enabled": true,
              "default_focus_precedence": 8,
              "layer": 16
            }
          }
        ]
      }
    ]
  }
}