            "recovery_clock_and_compass_with_background": {
               "type": "stack_panel",
               "orientation": "horizonal",
               "anchor_from": "left_middle",
               "anchor_to": "left_middle",
               "layer": 3,
               "size": ["11%", 16],
               "controls": [
                    {
                     "recovery_clock_and_compass@f3nc.recovery_clock_and_compass": {
                      "layer": 4
                    }
                  }
               ]
            },
  
  
  "recovery_clock_and_compass": {
  "type": "panel",
  "size": ["60%", 18],
  "layer": 3,
  "anchor_from": "left_middle",
  "anchor_to": "left_middle",
  "controls": [
    {
      "stack_container": {
        "type": "stack_panel",
        "orientation": "horizontal",
        "size": ["60%", 18],
        "controls": [
          {
            "recovery_panel": {
              "type": "panel",
              "size": [16, 16],
              "controls": [
                {
                  "recovery_item": {
                    "type": "custom",
                    "renderer": "inventory_item_renderer",
                    "size": [16, 16],
                    "layer": 5,
                    "property_bag": { "#item_id_aux": "$recoverycompassid" }
                  }
                }
              ]
            }
          },
          {
            "padding1": { "type": "panel", "size": [3, 0] }
          },
          {
            "clock_panel": {
              "type": "panel",
              "size": [16, 16],
              "controls": [
                {
                  "clock_item": {
                    "type": "custom",
                    "renderer": "inventory_item_renderer",
                    "size": [16, 16],
                    "layer": 5,
                    "property_bag": { "#item_id_aux": 22740992 }
                  }
                }
              ]
            }
          },
          {
            "padding2": { "type": "panel", "size": [3, 0] }
          },
          {
            "compass_panel": {
              "type": "panel",
              "size": [16, 16],
              "controls": [
                {
                  "compass_item": {
                    "type": "custom",
                    "renderer": "inventory_item_renderer",
                    "size": [16, 16],
                    "layer": 5,
                    "property_bag": { "#item_id_aux": 22609920 }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
},


  
  
  
            "number_of_days_played": {
    "type": "image",
    "size": [ "100%c + 2px", "100%c" ],
    "texture": "textures/ui/Black",
    "alpha": "$f3alpha",
    "controls": [
      {
        "number_of_days_played_text": {
          "type": "label",
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "layer": 5,

          "enable_profanity_filter": false,
          "color": "$chat_text_color",
          "text": "#text",
          "shadow": true,

          "bindings": [
            {
              "binding_name": "#number_of_days_played_text",
              "binding_name_override": "#text",
              "binding_condition": "always_when_visible",
              "binding_type": "global"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#number_of_days_played_visible",
        "binding_name_override": "#visible",
        "binding_condition": "always",
        "binding_type": "global"
      }
    ]
  },
       
         
  "player_position": {
    "type": "image",
    "size": [ "100%c + 6px", "100%c + 2px" ],
    "texture": "textures/ui/Black",
    "alpha": "$f3alpha",
    "controls": [
      {
        "player_position_text": {
          "type": "label",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 1,

          "enable_profanity_filter": false,
          "color": "$chat_text_color",
          "text": "#text",
          "shadow": true,

          "bindings": [
            {
              "binding_name": "#player_position_text",
              "binding_name_override": "#text",
              "binding_condition": "always_when_visible",
              "binding_type": "global"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#player_position_visible",
        "binding_name_override": "#visible",
        "binding_condition": "always",
        "binding_type": "global"
      }
    ]
  },
  
  "world_name": {
      "type": "image",
      "texture": "textures/ui/Black",
      "size": [ "100%c + 2px", "100%c" ],
      "alpha": "$f3alpha",
      "layer": 4,
      "anchor_from": "left_middle",
      "anchor_to": "left_middle",
      
      "controls": [
      {
  "world_name_inner": {
  "type": "label",
  "layer": 5,
  "text": "#player_list_title_text",
  "anchor_from": "left_middle",
  "anchor_to": "left_middle",
  "max_size": [ "100%c", 14 ],
  "bindings": [
                {
                  "binding_name": "#player_list_title",
                  "binding_type": "global"
                },
                {
                  "binding_type": "view",
                  "source_property_name": "('World Name: ' + #player_list_title)",
                  "target_property_name": "#player_list_title_text"
                },
                {
                  "binding_name": "#player_list_title_visible",
                  "binding_type": "global",
                  "binding_name_override": "#visible"
                }
              ]
  }
  }
  ]
  },
  
  "nebux_xplevel": {
  "type": "stack_panel",
  "anchor_from": "left_middle",
  "anchor_to": "left_middle",
  "orientation": "horizontal",
  "size": ["100%c", "100%c"],

  "controls": [
    {
      "level_bg": {
        "type": "image",
        "texture": "textures/ui/Black",
        "size": [ "100%c + 2px", "100%c" ],
        "alpha": "$f3alpha",
        "layer": 1,
        "controls": [
          {
            "level_label_inner": {
              "type": "label",
              "shadow": true,
              "text": "#text",
              "layer": 2,
              "bindings": [
                {
                  "binding_name": "#level_number",
                  "binding_type": "global"
                },
                {
                  "binding_type": "view",
                  "source_property_name": "('§fXp Level:§a ' + #level_number)",
                  "target_property_name": "#text"
                },
                {
                  "binding_name": "#level_number_visible",
                  "binding_type": "global",
                  "binding_name_override": "#visible"
                }
              ]
            }
          }
        ]
      }
    }
  ]
},


