{
  "namespace": "hud_ds-dav",

  "armor_slot_panel": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%sm", "100%cm" ],
    "min_size": [ "100%c", "100%cm" ],
    "anchor_from": "$anchor",
    "anchor_to": "$anchor",
    "variables": [
      {
        "requires": "$is_left_content",
        "$anchor": "right_middle"
      },
      {
        "requires": "$is_right_content",
        "$anchor": "left_middle"
      }
    ],
    
    "$is_right_content|default": false,
    "$is_left_content|default": false,
    "controls": [
      {
        "durability_text_panel_left": {
          "ignored": "(not $is_left_content)",
          "type": "panel",
          "size": [ "100%c + 2px", "100%sm" ],
          "controls": [
            {
              "number@hud_common_ds-dav.durability_text_number": {
                "$configuration_source": "#option_5",
                "$configuration_data": "_2"
              }
            },
            {
              "percentage@hud_common_ds-dav.durability_text_percentage": {
                "$configuration_source": "#option_5",
                "$configuration_data": "_1"
              }
            }
          ]
        }
      },
      {
        "item_renderer@hud_common_ds-dav.item_renderer_panel": {
          "$configuration_source": "#option_6",
          "$configuration_data": "_1",
          "$additional_content": "hud_common_ds-dav.low_durability_indicator_panel",
          "$durability_bar_bindings": [
            {
              "binding_type": "view",
              "source_control_name": "dav_title_data_binding",
              "source_property_name": "(#option_5 = '_0')",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "durability_text_panel_right": {
          "ignored": "(not $is_right_content)",
          "type": "panel",
          "size": [ "100%c + 2px", "100%sm" ],
          "controls": [
            {
              "number@hud_common_ds-dav.durability_text_number": {
                "$configuration_source": "#option_5",
                "$configuration_data": "_2"
              }
            },
            {
              "percentage@hud_common_ds-dav.durability_text_percentage": {
                "$configuration_source": "#option_5",
                "$configuration_data": "_1"
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "dav_title_data_binding",
        "source_property_name": "((#option_7 = '_0') or not (($item_collection_data - '^') = ''))",
        "target_property_name": "#visible"
      }
    ]
  },

  "armor_panel_left": {
    "$is_left_content": true,
    "type": "stack_panel",
    "size": [ "100%cm", "100%c" ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_right",
    "use_child_anchors": true,
    "controls": [
      {
        "head_item@hud_ds-dav.armor_slot_panel": {
          "$item_collection_data": "#head_item",
          "$item_current_durability_source": "#head_current_durability",
          "$item_total_durability_source": "#head_total_durability",
          "$empty_slot_icon_texture": "textures/ui/durability_armor_viewer/empty_head_slot",

          "anchor_from": "right_middle",
          "anchor_to": "right_middle"
        }
      },
      {
        "chest_item@hud_ds-dav.armor_slot_panel": {
          "$item_collection_data": "#chest_item",
          "$item_current_durability_source": "#chest_current_durability",
          "$item_total_durability_source": "#chest_total_durability",
          "$empty_slot_icon_texture": "textures/ui/durability_armor_viewer/empty_chest_slot",

          "anchor_from": "right_middle",
          "anchor_to": "right_middle"
        }
      }
    ]
  },

  "armor_panel_right": {
    "$is_right_content": true,
    "type": "stack_panel",
    "size": [ "100%cm", "100%c" ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_left",
    "use_child_anchors": true,
    "controls": [
      {
        "legs_item@hud_ds-dav.armor_slot_panel": {
          "$item_collection_data": "#legs_item",
          "$item_current_durability_source": "#legs_current_durability",
          "$item_total_durability_source": "#legs_total_durability",
          "$empty_slot_icon_texture": "textures/ui/durability_armor_viewer/empty_legs_slot",

          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      },
      {
        "feet_item@hud_ds-dav.armor_slot_panel": {
          "$item_collection_data": "#feet_item",
          "$item_current_durability_source": "#feet_current_durability",
          "$item_total_durability_source": "#feet_total_durability",
          "$empty_slot_icon_texture": "textures/ui/durability_armor_viewer/empty_feet_slot",

          "anchor_from": "left_middle",
          "anchor_to": "left_middle"
        }
      }
    ]
  },
  
  "offhand_slot_panel": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [ "100%c", "100%cm" ],
    
    "$is_right_content|default": false,
    "$is_left_content|default": false,
    "controls": [
      {
        "durability_text_panel_left": {
          "ignored": "(not $is_left_content)",
          "type": "panel",
          "size": [ "100%c + 2px", "100%sm" ],
          "controls": [
            {
              "number@hud_common_ds-dav.durability_text_number": {
                "$configuration_source": "#option_5",
                "$configuration_data": "_2"
              }
            },
            {
              "percentage@hud_common_ds-dav.durability_text_percentage": {
                "$configuration_source": "#option_5",
                "$configuration_data": "_1"
              }
            }
          ]
        }
      },
      {
        "item_renderer": {
          "$configuration_source": "#option_6",
          "$configuration_data": "_1",
          "$empty_slot_icon_required": false,
          "$durability_bar_bindings": [
            {
              "binding_type": "view",
              "source_control_name": "dav_title_data_binding",
              "source_property_name": "(#option_5 = '_0')",
              "target_property_name": "#visible"
            }
          ],
          
          "type": "panel",
          "size": [ "100%cm", "100%cm" ],
          "controls": [
            {
              "item_background": {
                "type": "image",
                "texture": "textures/ui/durability_armor_viewer/offhand_slot",
                "size": [ 22, 22 ],
                "layer": 1,
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "dav_title_data_binding",
                    "source_property_name": "(#option_3 = '_1')",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "item@hud_common_ds-dav.item_renderer_panel": {
                "$additional_content": "hud_common_ds-dav.low_durability_indicator_panel",
                "size": [ 16, 22 ],
                "layer": 3
              }
            },
            {
              "stack_count@hud_common_ds-dav.offhand_stack_count_panel": {
                "layer": 5
              }
            }
          ]
        }
      },
      {
        "durability_text_panel_right": {
          "ignored": "(not $is_right_content)",
          "type": "panel",
          "size": [ "100%c + 2px", "100%sm" ],
          "controls": [
            {
              "number@hud_common_ds-dav.durability_text_number": {
                "$configuration_source": "#option_5",
                "$configuration_data": "_2"
              }
            },
            {
              "percentage@hud_common_ds-dav.durability_text_percentage": {
                "$configuration_source": "#option_5",
                "$configuration_data": "_1"
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "dav_title_data_binding",
        "source_property_name": "((#option_7 = '_0') or not ((#offhand_item - '^') = ''))",
        "target_property_name": "#visible"
      }
    ]
  },

  "offhand_panel": {
    "type": "panel",
    "size": [ "100%c", "100%c" ],
    "controls": [
      {
        "stack_panel@hud_ds-dav.offhand_slot_panel": {
          "$item_collection_data": "#offhand_item",
          "$item_current_durability_source": "#offhand_current_durability",
          "$item_total_durability_source": "#offhand_total_durability"
        }
      }
    ]
  },
  
  "hotbar_padding": {
    "type": "panel",
    "size": [ "94px + 100%c", "100%cm" ],
    "$is_dimz_inventory_button_hider|default": false,
    "controls": [
      {
        "inventory_button": {
          "ignored": "$is_dimz_inventory_button_hider",
          "type": "panel",
          "size": [ 10, "100%sm" ],
          "bindings": [
            {
              "binding_name": "#inventory_touch_button",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  "main_content": {
    "type": "panel",
    "controls": [
      {
        "panel_top": {
          "type": "panel",
          "size": [ "100%cm", "100%cm" ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [ 0, -25 ],
          "controls": [
            {
              "left_panel@hud_ds-dav.armor_panel_left": {}
            },
            {
              "hotbar_padding@hud_ds-dav.hotbar_padding": {
                "size": [ "188px + 200%c", "100%cm" ]
              }
            },
            {
              "right_panel@hud_ds-dav.armor_panel_right": {}
            }
          ],
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "dav_title_data_binding",
              "source_property_name": "((#option_4 = '_0') or (#option_4 = '_1'))",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "stack_panel_left": {
          "$is_left_content": true,
          
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%c", "100%cm" ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_right",
          "offset": [ 0, -1.5 ],
          "controls": [
            {
              "offhand@hud_ds-dav.offhand_panel": {
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "dav_title_data_binding",
                    "source_property_name": "((#option_1 = '_1') and ((#option_4 = '_0') or (#option_4 = '_2')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "extra_padding": {
                "type": "panel",
                "size": [ 3, 0 ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "dav_title_data_binding",
                    "source_property_name": "(#option_3 = '_1')",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "hotbar_padding@hud_ds-dav.hotbar_padding": {}
            }
          ]
        }
      },
      {
        "stack_panel_right": {
          "$is_right_content": true,

          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%c", "100%cm" ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_left",
          "offset": [ 0, -1.5 ],
          "controls": [
            {
              "hotbar_padding@hud_ds-dav.hotbar_padding": {}
            },
            {
              "extra_padding": {
                "type": "panel",
                "size": [ 3, 0 ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "dav_title_data_binding",
                    "source_property_name": "(#option_3 = '_1')",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "offhand@hud_ds-dav.offhand_panel": {
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "dav_title_data_binding",
                    "source_property_name": "((#option_1 = '_0') and ((#option_4 = '_0') or (#option_4 = '_2')))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "(not #is_spectator_mode)",
        "binding_name_override": "#visible"
      }
    ]
  },

  "subpack:identifier": { "$id": "on_hotbar" }
}