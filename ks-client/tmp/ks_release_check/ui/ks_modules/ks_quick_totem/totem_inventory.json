  "ks_qt_hotbar_scanner": {
    "type": "stack_panel",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "$target_collection": "hotbar_items",
    "collection_name": "hotbar_items",
    "controls": [
      { "8@crafting.ks_qt_scanner_slot_template": { "collection_index": 8 } },
      { "7@crafting.ks_qt_scanner_slot_template": { "collection_index": 7 } },
      { "6@crafting.ks_qt_scanner_slot_template": { "collection_index": 6 } },
