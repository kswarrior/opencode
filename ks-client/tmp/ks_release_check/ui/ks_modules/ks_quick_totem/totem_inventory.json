      { "25@crafting.ks_qt_scanner_slot_template": { "collection_index": 25 } },
      { "24@crafting.ks_qt_scanner_slot_template": { "collection_index": 24 } },
      { "23@crafting.ks_qt_scanner_slot_template": { "collection_index": 23 } },
