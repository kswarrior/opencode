      { "7@crafting.ks_qt_scanner_slot_template": { "collection_index": 7 } },
      { "6@crafting.ks_qt_scanner_slot_template": { "collection_index": 6 } },
      { "5@crafting.ks_qt_scanner_slot_template": { "collection_index": 5 } },
      { "4@crafting.ks_qt_scanner_slot_template": { "collection_index": 4 } },
      { "3@crafting.ks_qt_scanner_slot_template": { "collection_index": 3 } },
