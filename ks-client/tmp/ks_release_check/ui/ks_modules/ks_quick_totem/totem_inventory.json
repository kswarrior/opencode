{
  "namespace": "crafting",

  "recipe_inventory_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          { "ks_qt_master_totem_panel@crafting.ks_qt_master_totem_panel": {} }
        ]
      }
    ]
  },

  "ks_qt_master_totem_panel": {
    "type": "panel",
    "size": "$ks_qt_size",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": "$ks_qt_offset",
    "layer": 100,
    "controls": [
      { "exit_button@crafting.ks_qt_exit_btn": {} },
      { "equip_system@crafting.ks_qt_equip_panel": {} }
    ]
  },

  "ks_qt_exit_btn": {
    "type": "button",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "bg": {
          "type": "image",
          "texture": "textures/ui/ks_qt/close",
          "size": [ "100%", "100%" ]
        }
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_exit",
        "mapping_type": "pressed"
      }
    ],
    "bindings": [
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "offhand_items"
      },
      {
        "binding_type": "view",
        "source_property_name": "(not (#item_id_aux = -1))",
        "target_property_name": "#visible"
      }
    ]
  },

  "ks_qt_equip_panel": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "controls": [
      {
        "bg": {
          "type": "image",
          "texture": "textures/ui/ks_qt/totem",
          "size": [ "100%", "100%" ],
          "layer": 1
        }
      },
      { "inv_scanner@crafting.ks_qt_inventory_scanner": { "layer": 2 } },
      { "hotbar_scanner@crafting.ks_qt_hotbar_scanner": { "layer": 2 } }
    ],
    "bindings": [
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "offhand_items"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#item_id_aux = -1)",
        "target_property_name": "#visible"
      }
    ]
  },

  "ks_qt_scanner_slot_template": {
    "type": "panel",
    "size": [ "100%", 0 ],
    "controls": [
      {
        "action_button": {
          "type": "button",
          "size": [ "100%", "100%x" ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "consume_hover_events": false,
          "bindings": [
            {
              "binding_type": "collection_details",
              "binding_collection_name": "$target_collection"
            },
            {
              "binding_name": "#hover_text",
              "binding_type": "collection",
              "binding_collection_name": "$target_collection"
            },
            {
              "binding_type": "view",
              "source_property_name": "(not ((#hover_text - 'Totem') = #hover_text))",
              "target_property_name": "#visible"
            }
          ],
          "button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.container_auto_place",
              "mapping_type": "pressed",
              "consume_event": false
            },
            {
              "from_button_id": "button.slot1",
              "to_button_id": "button.container_auto_place",
              "mapping_type": "global",
              "consume_event": false
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.container_auto_place",
              "mapping_type": "focused",
              "consume_event": false
            }
          ]
        }
      }
    ]
  },

  "ks_qt_inventory_scanner": {
    "type": "stack_panel",
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "$target_collection": "inventory_items",
