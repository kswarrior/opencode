{
  "namespace": "gameplay",

  // ---------- Bundle Item Counter (ryBIC, rebranded) ----------
  // Draws the bundle stack-count label on the selected-item bundle panel and
  // hides the vanilla storage bar it replaces.
  "bundle_selected_item_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": {
          "item_count_bundle@ks_bundle_counter.bundle_item_counter_text": {
            "offset": [ 2, 3 ]
          }
        }
      }
    ]
  },

  "bundle_selected_item_panel/storage_bar": {
    "ignored": true
  }
}
