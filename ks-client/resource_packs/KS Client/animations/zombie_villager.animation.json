		"animation.zombie_villager.look_at": {
			"loop": true,
			"bones": {
				"head": {
					"relative_to": {
						"rotation": "entity"
					},
					"rotation": ["q.target_x_rotation/2", "math.clamp(q.target_y_rotation/1.5, -40, 40)", 0],
					"scale": "q.is_baby ? 1.35 : 1"
				},
				"pupil_right": {
					"position": ["math.clamp(-(q.target_y_rotation/75)+v.eye_random2, -1, 0)", "math.clamp(-(q.target_x_rotation/150)+v.eye_random1, -0.3, 0.5)", 0]
				},
				"pupil_left": {
					"position": ["math.clamp(-(q.target_y_rotation/75)+v.eye_random2, 0, 1)", "math.clamp(-(q.target_x_rotation/150)+v.eye_random1, -0.3, 0.5)", 0]
				},
				"pupil_right_up": {
					"scale": [1, "math.clamp(1-q.target_x_rotation/150+v.eye_random1, 0.7, 1)", 1]
				},
				"pupil_left_up": {
					"scale": [1, "math.clamp(1-q.target_x_rotation/150+v.eye_random1, 0.7, 1)", 1]
				},
				"pupil_right_in": {
					"scale": ["math.clamp(1+(q.target_y_rotation/75)-v.eye_random2, 0.7, 1)", 1, 1]
				},
				"pupil_left_in": {
					"scale": ["math.clamp(1-(q.target_y_rotation/75)+v.eye_random2, 0.7, 1)", 1, 1]
				},
				"nose": {
					"rotation": ["-q.target_x_rotation/5", 0, 0]
				},
				"eyelids": {
					"position": [0, "(math.abs(q.target_y_rotation)/375)+math.clamp(-q.target_x_rotation/150, -0.3, 0.3)", 0]
				},
				"eyebrow": {
					"rotation": [0, 0, "q.target_y_rotation/10"],
					"position": [0, "math.abs(q.target_y_rotation/110)+math.clamp(-q.target_x_rotation/150, -0.3, 0.3)", 0]
				},
				"rightLeg": {
					"rotation": ["q.is_riding ? (-72-this) : 0", "q.is_riding ? (13-this) : 0", "q.is_riding ? (0-this) : 0"]
				},
