{
    "format_version": "1.10.0",
    "render_controllers": {
        "controller.render.fps_counter": {
            "geometry": "Geometry.fps_counter",
            "materials": [ { "*": "Material.fps_counter" } ],
            "textures": [ "Texture.fps_counter" ],
            "part_visibility": [
                { "*": false },
                { "hundreds_0": "variable.rounded_fps >= 100 && variable.digit_hundreds == 0" },
                { "hundreds_1": "variable.rounded_fps >= 100 && variable.digit_hundreds == 1" },
                { "hundreds_2": "variable.rounded_fps >= 100 && variable.digit_hundreds == 2" },
                { "hundreds_3": "variable.rounded_fps >= 100 && variable.digit_hundreds == 3" },
                { "hundreds_4": "variable.rounded_fps >= 100 && variable.digit_hundreds == 4" },
                { "hundreds_5": "variable.rounded_fps >= 100 && variable.digit_hundreds == 5" },
                { "hundreds_6": "variable.rounded_fps >= 100 && variable.digit_hundreds == 6" },
                { "hundreds_7": "variable.rounded_fps >= 100 && variable.digit_hundreds == 7" },
                { "hundreds_8": "variable.rounded_fps >= 100 && variable.digit_hundreds == 8" },
                { "hundreds_9": "variable.rounded_fps >= 100 && variable.digit_hundreds == 9" },

                { "tens_0": "variable.rounded_fps >= 10 && variable.digit_tens == 0" },
                { "tens_1": "variable.rounded_fps >= 10 && variable.digit_tens == 1" },
                { "tens_2": "variable.rounded_fps >= 10 && variable.digit_tens == 2" },
                { "tens_3": "variable.rounded_fps >= 10 && variable.digit_tens == 3" },
                { "tens_4": "variable.rounded_fps >= 10 && variable.digit_tens == 4" },
                { "tens_5": "variable.rounded_fps >= 10 && variable.digit_tens == 5" },
                { "tens_6": "variable.rounded_fps >= 10 && variable.digit_tens == 6" },
                { "tens_7": "variable.rounded_fps >= 10 && variable.digit_tens == 7" },
                { "tens_8": "variable.rounded_fps >= 10 && variable.digit_tens == 8" },
                { "tens_9": "variable.rounded_fps >= 10 && variable.digit_tens == 9" },

                { "ones_0": "variable.digit_ones == 0" },
                { "ones_1": "variable.digit_ones == 1" },
                { "ones_2": "variable.digit_ones == 2" },
                { "ones_3": "variable.digit_ones == 3" },
                { "ones_4": "variable.digit_ones == 4" },
                { "ones_5": "variable.digit_ones == 5" },
                { "ones_6": "variable.digit_ones == 6" },
                { "ones_7": "variable.digit_ones == 7" },
                { "ones_8": "variable.digit_ones == 8" },
                { "ones_9": "variable.digit_ones == 9" },

                { "plus": "variable.display_fps >= 1000" }
            ]
        }
    }
}
