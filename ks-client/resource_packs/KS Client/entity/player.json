                "health_bar": "animation.health_bar",
                "ksd_hud": "animation.ksd_hud"
            },
            "render_controllers": [
                {
                    "controller.render.player.first_person_spectator": "variable.is_first_person && query.is_spectator"
                },
                {
                    "controller.render.player.third_person_spectator": "!variable.is_first_person && !variable.map_face_icon && query.is_spectator"
                },
                {
                    "controller.render.player.first_person": "variable.is_first_person && !query.is_spectator"
                },
                {
                    "controller.render.player.third_person": "!variable.is_first_person && !variable.map_face_icon && !query.is_spectator"
                },
                {
                    "controller.render.player.map": "variable.map_face_icon"
                },
                "controller.render.health_bar.bar",
                "controller.render.health_bar.heart",
                "controller.render.health_bar.digit1",
                "controller.render.health_bar.digit2",
                "controller.render.health_bar.digit3",
                { "controller.render.ksd_hud_helmet": "variable.ksd_hud_on && query.has_armor_slot(0)" },
                { "controller.render.ksd_hud_chestplate": "variable.ksd_hud_on && query.has_armor_slot(1)" },
                { "controller.render.ksd_hud_leggings": "variable.ksd_hud_on && query.has_armor_slot(2)" },
                { "controller.render.ksd_hud_boots": "variable.ksd_hud_on && query.has_armor_slot(3)" },
                { "controller.render.ksd_hud_offhand_frame": "variable.ksd_hud_on && query.is_item_equipped(1)" },
                { "controller.render.ksd_hud_offhand_item": "variable.ksd_hud_on && query.is_item_equipped(1)" },
                { "controller.render.ksd_hud_bars": "variable.ksd_hud_on" }
            ],
            "enable_attachables": true
