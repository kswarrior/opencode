{
  "namespace": "counter",

  "_slot_template": {
    "type": "panel",
    "$id_gapple": "$golden_apple_item_id",
    "$id_egapple": "$enchanted_golden_apple_item_id",
    "$id_pearls": "$ender_pearls_item_id",
    "$id_totem": "$totem_item_id",
    "bindings": [
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "hotbar_items"
      },
      {
        "binding_name": "#inventory_stack_count",
        "binding_type": "collection",
        "binding_collection_name": "hotbar_items"
      },
      {
        "binding_type": "view",
        "source_property_name": "('%.3s' * #inventory_stack_count)",
        "target_property_name": "#count"
      },
      {
        "binding_type": "view",
        "source_property_name": "(1 - (#item_id_aux = -1))",
        "target_property_name": "#_id"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#item_id_aux = $id_gapple) * #count)",
        "target_property_name": "#_ga1"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#item_id_aux = $id_egapple) * #count + #_ga1)",
        "target_property_name": "#_ga"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#item_id_aux = $id_pearls) * #count)",
        "target_property_name": "#_ep"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#item_id_aux = $id_totem) * #count)",
        "target_property_name": "#_t"
      }
    ]
  },

