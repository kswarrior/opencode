{
  "namespace": "pause",

  // Bottom-left Config button: icon (gear) + text "Config" on Asteroid cyan.
  // Tap toggles ks_config_state -> shows/hides the Coming-soon popup.
  // Touch-first ($toggle_focus_enabled:false), local ($toggle_binding_type:none).
  "ks_config_holder": {
    "type": "panel",
    "size": [ 140, 36 ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "offset": [ 8, -8 ],
    "layer": 10,
    "controls": [
      {
        "ks_config_bg": {
          "type": "image",
          "texture": "textures/ui/ks_btn_cyan",
          "size": [ "100%", "100%" ],
          "layer": 0
        }
      },
      {
        "ks_config_row": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100% - 16px", 28 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, 0 ],
          "layer": 1,
          "controls": [
            {
              "ks_config_icon": {
                "type": "image",
                "texture": "textures/ui/ks_icon_settings",
                "size": [ 24, 24 ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "layer": 1
              }
            },
            {
              "ks_config_gap": {
                "type": "panel",
                "size": [ 8, 28 ]
              }
            },
            {
              "ks_config_label": {
                "type": "label",
                "size": [ 80, 28 ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "color": [ 255, 255, 255 ],
                "shadow": true,
                "localize": false,
                "text_alignment": "left",
                "font_size": "normal",
                "font_scale_factor": 1.0,
                "layer": 1,
                "text": "Config"
              }
            }
          ]
        }
      },
      {
        "ks_config_state@common.toggle": {
          "size": [ "100%", "100%" ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ],
          "layer": 3,
          "enabled": true,
          "visible": true,
          "$toggle_name": "ks_config_open",
          "$toggle_default_state": false,
          "$toggle_binding_type": "none",
          "$toggle_focus_enabled": false,
          "$unchecked_control": "common.empty_panel",
          "$checked_control": "common.empty_panel",
          "$unchecked_hover_control": "common.empty_panel",
          "$checked_hover_control": "common.empty_panel",
          "$unchecked_locked_control": "common.empty_panel",
          "$unchecked_locked_hover_control": "common.empty_panel",
          "$checked_locked_control": "common.empty_panel",
          "$checked_locked_hover_control": "common.empty_panel"
        }
      }
    ]
  },

  // Coming-soon popup: Asteroid dark panel bg, centered. Visible <=> Config ON.
  "ks_config_popup": {
    "type": "panel",
    "size": [ 230, 130 ],
    "visible": false,
    "anchor_from": "center",
    "anchor_to": "center",
    "offset": [ 0, 0 ],
    "layer": 50,
    "bindings": [
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_control_name": "ks_config_state",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "ks_popup_bg": {
          "type": "image",
          "texture": "textures/ui/ks_config_bg",
          "size": [ "100%", "100%" ],
          "layer": 0
        }
      },
      {
        "ks_popup_title": {
          "type": "label",
          "size": [ "100% - 20px", 30 ],
          "anchor_from": "top_middle",
          "anchor_to": "top_middle",
          "offset": [ 0, 12 ],
          "color": [ 255, 255, 255 ],
          "shadow": true,
          "localize": false,
          "text_alignment": "center",
          "font_size": "normal",
          "font_scale_factor": 1.1,
          "layer": 1,
          "text": "Coming soon"
        }
      },
      {
        "ks_popup_hint": {
          "type": "label",
          "size": [ "100% - 20px", 40 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, 5 ],
          "color": [ 160, 220, 235 ],
          "shadow": true,
          "localize": false,
          "text_alignment": "center",
          "font_size": "small",
          "font_scale_factor": 0.9,
          "layer": 1,
          "text": "Config screen is not ready yet."
        }
      },
      {
        "ks_popup_close_row": {
          "type": "panel",
          "size": [ 120, 26 ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [ 0, -10 ],
          "layer": 1,
          "controls": [
            {
              "ks_popup_close_label": {
                "type": "label",
                "size": [ 84, 26 ],
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [ 0, 0 ],
                "color": [ 255, 255, 255 ],
                "shadow": true,
                "localize": false,
                "text_alignment": "center",
                "font_size": "normal",
                "font_scale_factor": 0.9,
                "layer": 1,
                "text": "Tap Config to close"
              }
            },
            {
              "ks_config_close_state@common.toggle": {
                "size": [ "100%", "100%" ],
                "anchor_from": "top_left",
                "anchor_to": "top_left",
                "offset": [ 0, 0 ],
                "layer": 2,
                "enabled": true,
                "visible": true,
                "$toggle_name": "ks_config_open",
                "$toggle_default_state": false,
                "$toggle_binding_type": "none",
                "$toggle_focus_enabled": false,
                "$unchecked_control": "common.empty_panel",
                "$checked_control": "common.empty_panel",
                "$unchecked_hover_control": "common.empty_panel",
                "$checked_hover_control": "common.empty_panel",
                "$unchecked_locked_control": "common.empty_panel",
                "$unchecked_locked_hover_control": "common.empty_panel",
                "$checked_locked_control": "common.empty_panel",
                "$checked_locked_hover_control": "common.empty_panel"
              }
            }
          ]
        }
      }
    ]
  },

  "pause_screen_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "ks_config_holder@pause.ks_config_holder": {}
          },
          {
            "ks_config_popup@pause.ks_config_popup": {}
          }
        ]
      }
    ]
  }
}
