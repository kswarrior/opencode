{
  "namespace": "start",

  // Paper doll: vanilla size/height, centered horizontally along the bottom.
  // Profile row stays removed (username lives in the profile button now).
  "skin_panel": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ "50% - 75px", 124 ],
    "offset": [ 0, "-10% - 4px" ],
    "anchor_to": "bottom_middle",
    "anchor_from": "bottom_middle",
    "layer": 1,
    "controls": [
      { "viewer_panel@start.skin_viewer_panel": { "size": [ "100%", "fill" ] } }
    ]
  },

  // Bottom strip: version ONLY, small, no black background, no Mojang.
  // Raised above the bottom corner buttons so it never hides behind them.
  // (Vanilla text_panel/copyright/development_version are fully replaced.)
  "text_panel": {
    "type": "panel",
    "size": [ "100%-2px", 10 ],
    "offset": [ 0, -52 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "controls": [
      { "version@start.version_small": {} }
    ]
  },

  "version_small": {
    "type": "panel",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [ "50%", "100%" ],
    "controls": [
      {
        "label": {
          "type": "label",
          "color": [ 150, 180, 210 ],
          "layer": 2,
          "font_size": "normal",
          "font_scale_factor": 0.75,
          "shadow": true,
          "text": "#version",
          "size": [ "default", 10 ],
          "max_size": [ "100%", "100%" ],
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "bindings": [
            {
              "binding_name": "#version"
            }
          ]
        }
      }
    ]
  },

  // Top-right cluster: [inbox bell][social]. Inbox keeps its vanilla
  // enabled-binding; both keep full behaviour.
  "friendsdrawer_button_panel": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -8, 8 ],
    "size": [ "100%c", "100%c" ],
    "controls": [
      {
        "ks_inbox_slot": {
          "type": "panel",
          "size": [ 28, 32 ],
          "controls": [
            { "inbox_icon_button@start.inbox_icon_button": {} }
          ],
          "bindings": [
            {
              "binding_name": "#inbox_enabled",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "friendsdrawer_button@friendsbutton.button_panel": {
          "$context": "start"
        }
      }
    ]
  },

  // Vanilla center buttons, minus the rows that were MOVED to corners:
  // play -> bottom-right, settings -> top-left, store+realms -> bottom-left.
  // Everything else (featured world, edu rows, buy game, editions) stays.
  "main_buttons_panel": {
    "type": "panel",
    "size": [ 150, "100%c" ],
    "controls": [
      {
        "stacked_rows": {
          "type": "stack_panel",
          "size": [ "100%", "100%c" ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "controls": [
            {
              "featured_world@start.stacked_row": {
                "ignored": "$featured_world_ignored",
                "controls": [
                  { "featured_world_button@start.featured_world_button": {} }
                ]
              }
            },
            {
              "ai_lesson_crafter_row@start.stacked_row": {
                "ignored": "(not $education_edition)",
                "bindings": [
                  {
                    "binding_name": "#edu_ai_lesson_crafter_on",
                    "binding_name_override": "#visible"
                  }
                ],
                "controls": [
                  {
                    "ai_lesson_crafter_button@start.ai_lesson_crafter_button": {}
                  },
                  {
                    "new_tag_content@common.empty_panel": {
                      "size": [ "100%", "100%" ],
                      "controls": [
                        {
                          "new_tag@start.new_tag": {
                            "anchor_from": "top_right",
                            "anchor_to": "top_right",
                            "offset": [ 5, -5 ]
                          }
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "edu_featured_button@start.stacked_row": {
                "ignored": "(not $education_edition)",
                "bindings": [
                  {
                    "binding_name": "#edu_signed_in_only_ui_visible",
                    "binding_name_override": "#visible"
                  }
                ],
                "controls": [
                  {
                    "new_and_featured_button@edu_featured.featured_button": {}
                  }
                ]
              }
            },
            {
              "unlock_full_game_row@start.stacked_row": {
                "ignored": "(not $education_edition)",
                "bindings": [
                  {
                    "binding_name": "#edu_demo_only_ui_visible",
                    "binding_name_override": "#visible"
                  }
                ],
                "controls": [
                  { "unlock_full_game@start.unlock_full_game_button": {} }
                ]
              }
            },
            {
              "buy_game@start.stacked_row": {
                "ignored": "$unlock_full_game_button_ignored",
                "controls": [
                  { "buy_game_button@start.buy_game_button": {} }
                ]
              }
            },
            {
              "launch_editions@start.stacked_row": {
                "ignored": "($trial or not $supports_launching_legacy_version)",
                "controls": [
                  {
                    "launch_editions_button@start.launch_editions_button": {}
                  }
                ],
                "bindings": [
                  {
                    "binding_name": "#editions_visible_and_not_realms_promo_visible",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  // Vanilla bottom-left online stack minus its profile button
  // (Profile was moved to the top-left bar).
  "lower_online_buttons_panel": {
    "type": "stack_panel",
    "anchor_to": "bottom_left",
    "anchor_from": "bottom_left",
    "size": [ "100%", "100%c" ],
    "variables": [
      {
        "requires": "($showing_new_player_flow_buttons)",
        "$anim_type": "@start.anim_main_buttons_panel_alpha"
      },
      {
        "requires": "(not $showing_new_player_flow_buttons)",
        "$anim_type": 1.0
      }
    ],
    "alpha": "$anim_type",
    "controls": [
      {
        "stacked_column": {
          "type": "stack_panel",
          "size": [ "100%", 32 ],
          "offset": [ "5%", 0 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "orientation": "horizontal",
          "controls": [
            {
              "feedback_padding": {
                "ignored": "$feedback_ignored",
                "type": "panel",
                "size": [ 3, "100%" ],
                "bindings": [
                  {
                    "binding_name": "#feedback_visible",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "feedback_btn@start.column_frame": {
                "ignored": "$feedback_ignored",
                "size": [ 28, 32 ],
                "controls": [
                  { "feedback_button@start.feedback_button": {} }
                ],
                "bindings": [
                  {
                    "binding_name": "#feedback_visible",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            // (sign-in status text removed: text-free screen, username stays in profile card)
            {
              "achievements_padding": {
                "ignored": "$achievements_ignored",
                "type": "panel",
                "size": [ 3, "100%" ],
                "bindings": [
                  {
                    "binding_name": "#achievements_icon_visible",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "achievements_btn@start.column_frame": {
                "ignored": "$achievements_ignored",
                "size": [ 28, 32 ],
                "controls": [
                  { "achievements_icon_button@start.achievements_icon_button": {} }
                ],
                "bindings": [
                  {
                    "binding_name": "#achievements_icon_visible",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
            // (inbox bell moved to the top-right cluster next to social)
          ]
        }
      }
    ]
  },

  // ---------- Play button rebuilt borderless (same engine press path) ----------
  // Vanilla frame/text/hold art replaced by our art; $pressed_button_name is
  // passed through exactly like vanilla. Press shift forced to zero.
  // play_button_art (hover gif layer) is disabled: exclusive to this stack.
  "play_button@common_buttons.no_background_content_button": {
    "size": [ 95, 32 ],
    "$button_text": "",
    "$button_content": "start.play_button_art_custom",
    "$pressed_button_name": "$play_button_target",
    "$button_offset": [ 0, 0 ],
    "$button_pressed_offset": [ 0, 0 ],
    "$pressed_button_offset": [ 0, 0 ],
    "$focus_override_right": "profile_button",
    "default_focus_precedence": 1,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$pressed_button_name",
        "mapping_type": "pressed"
      },
      {
        "to_button_id": "play_button.is_hovered",
        "mapping_type": "pressed"
      }
    ]
  },

  "play_button_art_custom": {
    "type": "panel",
    "size": [ 95, 32 ],
    "controls": [
      {
        "play_art_img": {
          "type": "image",
          "texture": "textures/ui/ks_art_play",
          "size": [ 95, 32 ]
        }
      }
    ]
  },

  "play_button_art": {
    "ignored": true
  },

  // Center buttons raised upward (bottom but some upward).
  // Only this control is replaced, all other start.* controls
  // resolve from vanilla. Inserts KS Client row directly under
  // the vanilla main buttons, before the new-player-flow panel.
  "main_buttons_stack_panel": {
    "type": "stack_panel",
    "size": [ "100%", "100%" ],
    "orientation": "vertical",
    "$title_offset_padding|default": [ "100%", "12%" ],
    "variables": [
      {
        "requires": "($pocket_screen)",
        "$title_offset_padding": [ "100%", "12%" ]
      }
    ],
    "controls": [
      {
        "title_offset_padding": {
          "type": "panel",
          "size": "$title_offset_padding"
        }
      },
      // (vanilla Minecraft title image removed: text-free screen)
      {
        "title_spacer": {
          "type": "panel",
          "size": [ "100%", "100%c" ]
        }
      },
      {
        "padding_fill_1": {
          "type": "panel",
          "size": [ "100%", "fill" ]
        }
      },
      {
        "main_buttons_panel": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "offset": [ 0, -16 ],
          "variables": [
            {
              "requires": "($showing_new_player_flow_buttons)",
              "$anim_type": "@start.anim_main_buttons_panel_alpha"
            },
            {
              "requires": "(not $showing_new_player_flow_buttons)",
              "$anim_type": 1.0
            }
          ],
          "bindings": [
            {
              "binding_name": "(not #showing_new_player_flow_buttons)",
              "binding_name_override": "#visible"
            }
          ],
          "alpha": "$anim_type",
          "propagate_alpha": true,
          "controls": [
            {
              "main_buttons_panel@start.main_buttons_panel": {}
            }
          ]
        }
      },
      // (KS icon lives in the top-left bar; no center row)
      {
        "main_buttons_panel_new_player_flow": {
          "type": "panel",
          "size": [ "100%", "100%c" ],
          "bindings": [
            {
              "binding_name": "#showing_new_player_flow_buttons",
              "binding_name_override": "#visible"
            }
          ],
          "alpha": "@start.anim_new_player_buttons_panel_alpha",
          "propagate_alpha": true,
          "controls": [
            {
              "main_buttons_panel_new_player_flow@start.main_buttons_panel_new_player_flow": {}
            }
          ]
        }
      },
      {
        "padding_fill_2": {
          "type": "panel",
          "size": [ "100%", "fill" ]
        }
      },
      {
        "padding_3": {
          "type": "panel",
          "size": [ "100%", 10 ]
        }
      }
    ]
  },

  // Full content with KS premium overlays. Button POSITIONS unchanged -
  // only cinematic scrims + brand + glass frames are layered around them.
  "start_screen_content": {
    "type": "panel",
    "$achievements_ignored|default": false,
    "$feedback_ignored|default": false,
    "$store_ignored|default": false,
    "variables": [
      {
        "requires": "$education_edition",
        "$achievements_ignored": true,
        "$store_ignored|default": true
      },
      {
        "requires": "$nx_os",
        "$feedback_ignored": true
      },
      {
        "requires": "(not $supports_xbl_achievements)",
        "$achievements_ignored": true,
        "$feedback_ignored": true
      },
      {
        "requires": "$trial",
        "$achievements_ignored": true
      }
    ],
    "bindings": [
      {
        "binding_name": "(not #screen_needs_rebuild)",
        "binding_name_override": "#visible"
      }
    ],
    "controls": [
      { "ks_bg@ks_client.ks_bg": {} },
      { "ks_scrim_top@ks_client.ks_scrim_top": {} },
      { "ks_scrim_bottom@ks_client.ks_scrim_bottom": {} },
      { "ks_edge_left@ks_client.ks_edge_left": {} },
      { "ks_edge_right@ks_client.ks_edge_right": {} },
      {
        "main_buttons_and_title_panel@start.main_buttons_stack_panel": {}
      },
      {
        "online_button_stack": {
          "type": "stack_panel",
          "orientation": "vertical",
          "anchor_to": "bottom_left",
          "anchor_from": "bottom_left",
          "size": [ "50% - 75px", "100%c" ],
          "offset": [ 0, "-10%" ],
          "variables": [
            {
              "requires": "($showing_new_player_flow_buttons)",
              "$anim_type": "@start.anim_main_buttons_panel_alpha"
            },
            {
              "requires": "(not $showing_new_player_flow_buttons)",
              "$anim_type": 1.0
            }
          ],
          "alpha": "$anim_type",
          "controls": [
            {
              "gathering_panel@start.gathering_panel": {}
            },
            {
              "upper_online_buttons_panel@start.upper_online_buttons_panel": {}
            },
            {
              "lower_online_buttons_panel@start.lower_online_buttons_panel": {}
            }
          ],
          "bindings": [
            {
              "binding_name": "#online_stack_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      },
      {
        "skin_panel@start.skin_panel": { "layer": 1 }
      },
      {
        "text_panel@start.text_panel": {}
      },
      {
        "friendsdrawer_button_panel@start.friendsdrawer_button_panel": {
          "$focus_id": "friendsdrawer_button"
        }
      },
      { "edu_external_link_popup_factory@start.edu_external_link_popup_factory": {} },
      { "ks_top_bar@ks_client.ks_top_bar": {} },
      { "ks_bottom_left_row@ks_client.ks_bottom_left_row": {} },
      { "ks_bottom_right_play@ks_client.ks_bottom_right_play": {} },
      { "ks_page_overlay@ks_client.ks_page_overlay": {} }
    ]
  }
}
