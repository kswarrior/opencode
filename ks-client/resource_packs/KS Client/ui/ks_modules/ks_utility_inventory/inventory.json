  "quick_items_item@common_toggles.light_content_toggle": {
    "$toggle_name": "quick_items",
    "$radio_toggle_group": true,
    "$toggle_view_binding_name": "($mode_name + '_mode_tog')",
    "$button_content": "ksui_inventory.quick_items_icon",
    "$default_border_visible": false,
    "$hover_border_visible": false,
    "size": [
      18,
      18
    ]
  },
  "quick_items_icon": {
    "type": "image",
    "texture": "('textures/ui/ks_utility_inventory/' + $mode_name)",
    "color": "$text_color"
