{
  "namespace": "ksui_inventory",
  "center_fold@common.empty_panel": {
    "size": [
      4,
      "100%sm"
    ],
    "controls": [
      {
        "center_bg": {
          "type": "image",
          "texture": "textures/ui/recipe_back_panel",
          "size": [
            "100% + 8px",
            "100% - 6px"
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "recipe_book_tog",
        "source_property_name": "#toggle_state",
        "target_property_name": "#inventory"
      },
      {
        "binding_type": "view",
        "source_control_name": "inventory_UI_tog",
        "source_property_name": "#toggle_state",
        "target_property_name": "#recipe_book"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#inventory and #recipe_book)",
        "target_property_name": "#visible"
      }
    ]
  },
  "crafting_panel@ksui_common.touch_input": {
    "size": [
      84,
      44
    ],
    "controls": [
      {
        "stack@ksui_common.stack_horizontal": {
          "size": [
            76,
            36
          ],
          "controls": [
            {
              "crafting_grid_2x2@ksui_common.crafting_grid_2x2": {}
            },
            {
              "quick_craft_panel@common.empty_panel": {
                "size": [
                  22,
                  "100%"
                ],
                "controls": [
                  {
                    "quick_craft_button@common_buttons.light_text_button": {
                      "$button_text": "QC",
                      "$button_font_scale_factor": 0.8,
                      "size": [
                        18,
                        16
                      ],
                      "property_bag": {
                        "#collection_index": 0,
                        "#collection_name": "crafting_output_items"
                      },
                      "button_mappings": [
                        {
                          "from_button_id": "button.menu_select",
                          "mapping_type": "pressed",
                          "to_button_id": "button.crafting_output_tertiary"
                        },
                        {
                          "from_button_id": "button.menu_ok",
                          "mapping_type": "pressed",
                          "to_button_id": "button.crafting_output_tertiary"
                        }
                      ]
                    }
                  }
                ]
              }
            },
            {
              "output_panel@common.empty_panel": {
                "size": [
                  18,
                  36
                ],
                "controls": [
                  {
                    "output_grid_3x3@ksui_common.output_grid_3x3": {}
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "background@common.dialog_background_opaque": {}
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "crafting_tog",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },
  "recipe_book@common.root_panel": {
    "prevent_touch_input": true,
    "size": [
      142,
      116
    ],
    "controls": [
      {
        "recipe_book_tabs@ksui_common.touch_input": {
          "size": [
            "100%c",
            "100%"
          ],
          "anchor_from": "top_left",
          "anchor_to": "top_right",
          "offset": [
            4,
            0
          ],
          "controls": [
            {
              "tabs@ksui_inventory.recipe_book_tabs": {}
            }
          ]
        }
      },
      {
        "content": {
          "type": "stack_panel",
          "size": [
            "100% - 8px",
            "100% - 8px"
          ],
          "controls": [
            {
              "search_bar_panel@ksui_inventory.search_bar_panel": {}
            },
            {
              "padding@ksui_common.pad_2px_y": {}
            },
            {
              "grid_panel@ksui_inventory.recipe_book_scrolling_panel": {}
            }
          ]
        }
      },
      {
        "background@common.dialog_background_opaque": {}
      }
    ]
  },
  "recipe_book_scrolling_panel@common.container_scroll_panel": {
    "size": [
      "100%",
      "fill"
    ],
    "$scroll_view_port_offset": [
      -2,
      0
    ],
    "$touch": false,
    "$show_background": false,
    "$scroll_bar_contained": true,
    "$scrolling_content": "ksui_inventory.scroll_grid",
    "$collection_name": "recipe_book",
    "$scrolling_panel_base_button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.destroy_selection",
        "mapping_type": "pressed"
      }
    ]
  },
  "scroll_grid": {
    "type": "grid",
    "size": [
      "100%",
      "default"
    ],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "$binding_condition|default": "visible",
    "$grid_item_precache_count|default": 0,
    "$grid_item_template|default": "ksui_inventory.grid_item_for_recipe_book",
    "collection_name": "$collection_name",
    "grid_rescaling_type": "horizontal",
    "grid_item_template": "$grid_item_template",
    "bindings": [
      {
        "binding_name": "#recipe_book_total_items",
        "binding_name_override": "#maximum_grid_items",
        "binding_condition": "$binding_condition",
        "binding_type": "collection",
        "binding_collection_name": "$collection_name"
      }
    ]
  },
  "grid_item_for_recipe_book@ksui_common.container_item": {
    "$is_recipe_book_slot": true,
    "$button_ref": "ksui_common.creative_no_coalesce_container_slot_button",
    "$background_images": "crafting.recipe_container_cell_images",
    "$slot_selected_binding_name": "#is_creative_selected_slot",
    "$stack_count_binding_name": "#recipe_craftable_count",
    "$item_collection_name": "recipe_book",
    "$hover_text_binding_name": "#recipe_hover_text",
    "$item_renderer_binding_condition": "visible",
    "size": [
      18,
      18
    ]
  },
  "filter_toggle@common_toggles.switch_toggle": {
    "size": [
      29,
      16
    ],
    "$default_texture": "textures/ui/craft_toggle_off",
    "$hover_texture": "textures/ui/craft_toggle_on",
    "$pressed_texture": "textures/ui/craft_toggle_off_hover",
    "$pressed_no_hover_texture": "textures/ui/craft_toggle_on_hover",
    "$unchecked_locked_texture": "textures/ui/craft_toggle_off",
    "$checked_locked_texture": "textures/ui/craft_toggle_on",
    "$toggle_name": "toggle.enableFiltering",
    "$toggle_binding_type": "global",
    "$default_border_visible": false,
    "$hover_border_visible": false,
    "$toggle_state_binding_name": "#filtering_enabled",
    "$button_mappings": [
      {
        "to_button_id": "button.filter_toggle_hovered",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.menu_ok",
        "mapping_type": "focused"
      }
    ]
  },
  "search_bar_panel@ksui_common.stack_horizontal": {
    "size": [
      "100%",
      16
    ],
    "controls": [
      {
        "text_box_panel@ksui_inventory.text_box_panel": {
          "size": [
            "fill",
            "100%"
          ]
        }
      },
      {
        "filter_toggle@ksui_inventory.filter_toggle": {}
      },
      {
        "info_recipe_button@common_buttons.light_content_button": {
          "$pressed_button_name": "button.menu_select",
          "$button_content": "ksui_inventory.info_recipe_button_icon",
          "$default_state_border_visible": false,
          "size": [
            16,
            16
          ]
        }
      }
    ]
  },
  "info_recipe_button_icon": {
    "type": "panel",
    "$hover_state|default": false,
    "controls": [
      {
        "icon": {
          "type": "image",
          "texture": "textures/ui/infobulb",
          "size": [
            10,
            10
          ]
        }
      },
      {
        "hover_text@common.hover_text": {
          "ignored": "(not $hover_state)",
          "allow_clipping": false,
          "layer": 64,
          "property_bag": {
            "#hover_text_label": "Double press on recipe book slot\nto get item faster"
          },
          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "#hover_text_label",
              "target_property_name": "#hover_text"
            }
          ]
        }
      }
    ]
  },
  "text_box_panel": {
    "type": "panel",
    "controls": [
      {
        "text_edit_control@common.text_edit_box": {
          "size": [
            "100%",
            "100%"
          ],
          "layer": 3,
          "property_bag": {
            "#property_field": "#item_name"
          },
          "max_length": 30,
          "$text_edit_binding_name": "#text_box_item_name",
          "$text_edit_box_label_size": [
            "default",
            10
          ],
          "$text_edit_box_label_offset": [
            2,
            0
          ],
          "$place_holder_text": "Search Items...",
          "$text_edit_box_hovered_button_id": "button.search_bar_hovered",
          "$text_edit_box_clear_to_button_id": "button.search_bar_clear",
          "$text_edit_box_selected_to_button_id": "button.search_bar_selected",
          "$text_edit_box_deselected_to_button_id": "button.search_bar_deselected",
          "$text_clear_button_enabled": true,
          "$text_clear_button_size": [
            15,
            15
          ],
          "$text_clear_button_offset": [
            0,
            0
          ],
          "focus_wrap_enabled": false
        }
      },
      {
        "search_tab_button@common_toggles.light_content_toggle": {
          "$toggle_name": "navigation_tab",
          "$toggle_binding_type": "global",
          "$toggle_state_binding_name": "#is_left_tab_search",
          "$tab_view_binding_name": "search_tab_toggle",
          "$toggle_group_forced_index": "$search_index",
          "$toggle_group_default_selected": "$construction_index",
          "$toggle_consume_hover_events": false,
          "$toggle_focus_enabled": false,
          "$button_content": "common.empty_panel",
          "$toggle_sound_volume": 0,
          "$button_mappings": [
            {
              "from_button_id": "button.menu_select",
              "to_button_id": "button.menu_select",
              "mapping_type": "pressed",
              "consume_event": false
            },
            {
              "from_button_id": "button.menu_ok",
              "to_button_id": "button.menu_ok",
              "mapping_type": "focused"
            }
          ],
          "layer": 5,
          "propagate_alpha": true,
          "alpha": 0,
          "bindings": [
            {
              "binding_name": "(not #is_left_tab_search)",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },
  "recipe_book_tabs": {
    "type": "stack_panel",
    "size": [
      "100%cm",
      "100%"
    ],
    "controls": [
      {
        "construction_tab@ksui_inventory.construction_tab": {}
      },
      {
        "padding_1@ksui_common.pad_2px_y": {}
      },
      {
        "equipment_tab@ksui_inventory.equipment_tab": {}
      },
      {
        "padding_2@ksui_common.pad_2px_y": {}
      },
      {
        "items_tab@ksui_inventory.items_tab": {}
      },
      {
        "padding_3@ksui_common.pad_2px_y": {}
      },
      {
        "nature_tab@ksui_inventory.nature_tab": {}
      }
    ]
  },
  "recipe_tab@common_tabs.tab_left": {
    "$toggle_name": "navigation_tab",
    "$toggle_group_default_selected": "$construction_index",
    "$tab_content": "ksui_inventory.tab_icon",
    "size": [
      27,
      25
    ]
  },
  "tab_icon": {
    "type": "panel",
    "size": [
      24,
      25
    ],
    "controls": [
      {
        "icon": {
          "type": "image",
          "texture": "$icon_texture",
          "size": [
            17,
            17
          ]
        }
      }
    ]
  },
  "construction_tab@ksui_inventory.recipe_tab": {
    "$is_top_most_tab": true,
    "$tab_view_binding_name": "construction_tab_toggle",
    "$toggle_group_forced_index": "$construction_index",
    "$toggle_binding_type": "global",
    "$toggle_state_binding_name": "#is_left_tab_construct",
    "$icon_texture": "textures/ui/icon_recipe_construction"
  },
  "equipment_tab@ksui_inventory.recipe_tab": {
    "$tab_view_binding_name": "equipment_tab_toggle",
    "$tab_icon": "crafting.equipment_icon",
    "$toggle_group_forced_index": "$equipment_index",
    "$toggle_binding_type": "global",
    "$toggle_state_binding_name": "#is_left_tab_equipment",
    "$icon_texture": "textures/ui/icon_recipe_equipment"
  },
  "nature_tab@ksui_inventory.recipe_tab": {
    "$tab_view_binding_name": "nature_tab_toggle",
    "$tab_icon": "crafting.nature_icon",
    "$toggle_group_forced_index": "$nature_index",
    "$toggle_binding_type": "global",
    "$toggle_state_binding_name": "#is_left_tab_nature",
    "$is_bottom_most_tab": true,
    "$icon_texture": "textures/ui/icon_recipe_nature"
  },
  "items_tab@ksui_inventory.recipe_tab": {
    "$tab_view_binding_name": "items_tab_toggle",
    "$tab_icon": "crafting.items_icon",
    "$toggle_group_forced_index": "$items_index",
    "$toggle_binding_type": "global",
    "$toggle_state_binding_name": "#is_left_tab_items",
    "$icon_texture": "textures/ui/icon_recipe_item"
  },
