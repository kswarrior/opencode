  "quick_items_buttons@ksui_common.stack_horizontal": {
    "size": [
      "100%c",
      18
    ],
    "controls": [
      {
        "destroy@ksui_inventory.quick_items_item": {
          "$mode_name": "destroy",
          "$toggle_group_forced_index": 3,
          "bindings": [
            {
              "binding_name": "#is_creative_mode",
              "binding_name_override": "#enabled"
            }
          ]
        }
      },
      {
        "drop@ksui_inventory.quick_items_item": {
          "$mode_name": "drop",
          "$toggle_group_forced_index": 2
