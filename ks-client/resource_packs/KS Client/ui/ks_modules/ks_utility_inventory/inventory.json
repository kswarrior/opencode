    "controls": [
      {
        "extra_slot_grid@ksui_common.extra_slot_grid": {}
      },
      {
        "ea835b2d-2da@common_toggles.light_content_toggle": {
          "$toggle_name": "0a36-5def5af",
          "$toggle_view_binding_name": "ed29ef-a7607",
          "$button_content": "ksui_common.icon_content",
          "$icon_texture": "textures/ui/ks_utility_inventory/icons/gear",
          "size": [
            18,
