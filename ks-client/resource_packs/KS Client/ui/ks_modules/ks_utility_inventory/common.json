{
  "namespace": "ksui_common",
  "exit_button_overlay": {
    "type": "button",
    "layer": -1,
    "consume_hover_events": false,
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_exit",
        "mapping_type": "pressed",
        "consume_event": false
      }
    ]
  },
  "saved_state_toggle": {
    "type": "panel",
    "$source_toggle_controls": "common_toggles.light_content_toggle",
    "$toggle_name|default": "unset",
    "$toggle_view_name|default": "unset_toggle",
    "$toggle_default_state|default": false,
    "$tmS": "#toggle_state",
    "$UxG": "(not #toggle_state)",
    "$dLu": "common_toggles.toggle_unchecked",
    "$go2": "common_toggles.toggle_unchecked_hover",
    "$rJO": "common_toggles.toggle_checked",
    "$eWq": "common_toggles.toggle_checked_hover",
    "variables": [
      {
        "requires": "$toggle_default_state",
        "$tmS": "(not #toggle_state)",
        "$UxG": "#toggle_state",
        "$dLu": "common_toggles.toggle_checked",
        "$go2": "common_toggles.toggle_checked_hover",
        "$rJO": "common_toggles.toggle_unchecked",
        "$eWq": "common_toggles.toggle_unchecked_hover"
      }
    ],
    "controls": [
      {
        "unchecked_state@$source_toggle_controls": {
          "$unchecked_control": "$rJO",
          "$checked_control": "$rJO",
          "$unchecked_hover_control": "$eWq",
          "$checked_hover_control": "$eWq",
          "$toggle_view_binding_name": "('n' + $toggle_view_name)",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$toggle_view_name",
              "source_property_name": "$tmS",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "checked_state@$source_toggle_controls": {
          "$unchecked_control": "$dLu",
          "$checked_control": "$dLu",
          "$unchecked_hover_control": "$go2",
          "$checked_hover_control": "$go2",
          "$toggle_view_binding_name": "('y' + $toggle_view_name)",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$toggle_view_name",
              "source_property_name": "$UxG",
              "target_property_name": "#visible"
            }
          ]
        }
      },
      {
        "$toggle_view_name": {
          "type": "panel",
          "property_bag": {
            "#data": ""
          },
          "$input": "a",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "('y' + $toggle_view_name)",
              "source_property_name": "($input + #toggle_state - #toggle_state)",
              "target_property_name": "#data"
            },
            {
              "binding_type": "view",
              "source_control_name": "('n' + $toggle_view_name)",
              "source_property_name": "(#toggle_state - #toggle_state)",
              "target_property_name": "#data"
            },
            {
              "ignored": "$toggle_default_state",
              "binding_type": "view",
              "source_property_name": "(#data = 'a')",
              "target_property_name": "#toggle_state"
            },
            {
              "ignored": "(not $toggle_default_state)",
              "binding_type": "view",
              "source_property_name": "(not (#data = 'a'))",
              "target_property_name": "#toggle_state"
            }
          ]
        }
      }
    ]
  },
  "slot_input": {
    "$button_id": "button.container_auto_place",
    "$source_property|default": "(not (#item_id_aux = -1))",
    "$property_bag|default": {},
    "type": "button",
    "consume_hover_events": false,
    "property_bag": "$property_bag",
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_name": "#item_id_aux",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "$source_property",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_property_name": "(':' + (#item_id_aux / 65536) + ':')",
        "target_property_name": "#item_id_class"
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$button_id",
        "mapping_type": "pressed",
        "consume_event": false,
        "button_up_right_of_first_refusal": true
      }
    ]
  },
  "main_toggle@common_toggles.light_content_toggle": {
    "$button_content": "ksui_common.main_toggle_icon",
    "size": [
      20,
      20
    ]
  },
  "main_toggle_icon_text_color@ksui_common.main_toggle_icon": {
    "color": "$text_color"
  },
  "main_toggle_icon": {
    "type": "image",
    "texture": "$icon_texture",
    "size": "$size",
    "$size|default": [
      16,
      16
    ],
    "$hover_text|default": "tempe_goreng",
    "$hover_test_c|default": "ksui_common.main_tog_hover_text",
    "controls": [
      {
        "hover_trxt@$hover_test_c": {}
      }
    ]
  },
  "main_tog_hover_text_btton@ksui_common.main_tog_hover_text": {
    "ignored": "(not $hover_state)"
  },
  "main_tog_hover_text": {
    "ignored": "(not ($toggle_unchecked_hover - $toggle_checked_hover))",
    "type": "image",
    "texture": "textures/ui/purpleBorder",
    "size": [
      "100%c + 8px",
      "100%c + 6px"
    ],
    "anchor_from": "top_middle",
    "anchor_to": "bottom_middle",
    "offset": [
      0,
      -6
    ],
    "visible": "(not ($hover_text = 'tempe_goreng'))",
    "controls": [
      {
        "text": {
          "type": "label",
          "text": "$hover_text",
          "size": [
            "default",
            "default"
          ]
        }
      }
    ]
  },
  "selected_item_details_factory": {
    "type": "factory",
    "control_name": "@ksui_common.selected_item_details"
  },
  "selected_item_details@common.selected_item_details": {
