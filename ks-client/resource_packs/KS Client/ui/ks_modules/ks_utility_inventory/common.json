  "container_item@common.container_item": {
    "$highlight_control": "common.empty_panel",
    "$button_ref|default": "ksui_common.item_button_reff",
    "$add_control_c|default": "common.empty_panel",
    "$is_recipe_book_slot|default": false,
    "controls": [
