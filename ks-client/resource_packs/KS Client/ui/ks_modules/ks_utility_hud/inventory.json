  "ks_uhud_inventory_content": {
    "type": "panel",
    "controls": [
      {
        "fast_totem@ks_uhud.ks_uhud_fast_totem": {
          "ignored": "(not $ks_uhud_totem_v)"
        }
      },
      {
        "offhand_switch": {
          "type": "collection_panel",
          "size": [
            0,
            0
          ],
          "$item_collection_name": "offhand_items",
          "collection_name": "$item_collection_name",
          "controls": [
            {
              "0@ks_uhud.ks_uhud_offhand_switcher": {
                "collection_index": 0
              }
            }
          ]
        }
      },
      {
        "inv_open_text@ks_uhud.ks_uhud_tag": {
          "anchor_from": "top_right",
          "anchor_to": "top_right",
          "offset": [
            -5,
            5
          ],
          "ignored": "$touch"
        }
      },
      {
        "fast_switch@ks_uhud.ks_uhud_fast_switch": {
          "ignored": "(not $ks_uhud_switch_v or not $touch)"
        }
      },
      {
        "fast_switch_content@ks_uhud.ks_uhud_fast_switch_content": {
          "ignored": "(not $ks_uhud_switch_v or not $touch)"
        }
      },
      {
        "_offhand_preview@ks_uhud.ks_uhud_offhand_grid": {
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [
            -120,
            -1.5
          ],
          "ignored": "(not $ks_uhud_offhand_v)"
        }
      }
    ]
  }
