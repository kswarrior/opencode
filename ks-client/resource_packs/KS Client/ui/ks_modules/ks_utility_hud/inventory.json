{
  "namespace": "ks_uhud",
  "fast_switch_content@inv_content.component_toggle": {
    "size": [
      0,
      0
    ],
    "layer": 10,
    "$radio_toggle_group": true,
    "$toggle_group_forced_index": 0,
    "$toggle_name": "___",
    "toggle_default_state": true,
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "controls": [
      {
        "hotbar_grid@ks_uhud.ks_uhud_hotbar_grid": {}
      },
      {
        "ks_uhud_offhand_grid": {
          "type": "grid",
          "size": [
            22,
            22
          ],
          "offset": [
            -120,
            -1.5
          ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "grid_dimensions": [
            1,
            1
          ],
          "$item_collection_name": "offhand_items",
          "collection_name": "$item_collection_name",
          "controls": [
            {
              "offhand_grid_interact@ks_uhud.ks_uhud_interact_button": {
                "grid_position": [
                  0,
                  0
                ]
              }
            }
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "mapping_type": "global",
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select"
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "ks_uhud_fast_switch",
        "resolve_sibling_scope": true,
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },
  "fast_switch@inv_content.component_toggle": {
    "size": [
      21,
      21
    ],
    "offset": [
      120,
      -2
    ],
    "layer": 10,
    "$radio_toggle_group": true,
    "$toggle_group_forced_index": 1,
    "$toggle_name": "___",
    "toggle_default_state": false,
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "prevent_touch_input": true,
    "controls": [
      {
        "unchecked": {
          "type": "image",
          "texture": "textures/ui/ks_uhud/switch_default"
        }
      },
      {
        "checked": {
          "type": "image",
          "texture": "textures/ui/ks_uhud/switch_pressed"
        }
      },
      {
        "unchecked_hover": {
          "type": "image",
          "texture": "textures/ui/ks_uhud/switch_hover"
        }
      },
      {
        "checked_hover": {
          "type": "image",
          "texture": "textures/ui/ks_uhud/switch_pressed_hover"
        }
      }
    ],
    "button_mappings": [
      {
        "mapping_type": "pressed",
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select"
      }
    ]
  },
  "_hotbar_grid@common.hotbar_grid_template": {
    "offset": [
      -10,
      -1.5
    ],
    "size": [
      180,
      22
    ],
    "grid_item_template": "ks_uhud.ks_uhud_grid_item_for_hotbar"
  },
  "ks_uhud_grid_item_for_hotbar": {
    "type": "panel",
    "size": [
      20,
      22
    ],
    "$item_collection_name": "hotbar_items",
    "controls": [
      {
        "interact_button@ks_uhud.ks_uhud_interact_button": {}
      }
    ]
  },
  "ks_uhud_interact_button": {
    "type": "button",
    "prevent_touch_input": true,
    "size": [
      20,
      20
    ],
    "layer": 1,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$item_collection_name",
        "binding_condition": "once"
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.container_auto_place",
        "mapping_type": "pressed"
      }
    ]
  },
  "ks_uhud_fast_totem": {
    "type": "button",
    "layer": 40,
    "draggable": "both",
    "prevent_touch_input": true,
    "$size|default": [
      0,
      0
    ],
    "$press|default": "pressed_pc",
    "variables": [
      {
        "requires": "$touch",
        "$size": "$ks_uhud_totem_size",
        "$press": "pressed_touch"
      }
    ],
    "size": "$size",
    "offset": "$ks_uhud_totem_offset",
    "default_control": "default",
    "hover_control": "hover",
    "pressed_control": "$press",
    "controls": [
      {
        "inv_slots@ks_uhud.ks_uhud_totem_slots": {}
      },
      {
        "hotbar_slots@ks_uhud.ks_uhud_hotbar_totem_slots": {}
      },
      {
        "default": {
          "type": "image",
          "alpha": "$ks_uhud_totem_alpha",
          "texture": "textures/ui/ks_uhud/totem"
        }
      },
      {
        "hover": {
          "type": "image",
          "alpha": "$ks_uhud_totem_alpha",
          "texture": "textures/ui/ks_uhud/totem"
        }
      },
      {
        "pressed_touch": {
          "ignored": "(not $touch)",
          "type": "image",
          "alpha": "$ks_uhud_totem_alpha",
          "texture": "textures/ui/ks_uhud/totem_pressed"
        }
      },
      {
        "pressed_pc": {
          "ignored": "$touch",
          "type": "input_panel",
          "button_mappings": [
            {
              "from_button_id": "button.hide_gui",
              "to_button_id": "button.equip_totem",
              "mapping_type": "global",
              "scope": "global"
            }
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "ignored": "$touch",
        "mapping_type": "global",
        "from_button_id": "button.slot1",
        "to_button_id": "button.menu_select",
        "consume_event": false
      },
      {
        "ignored": "(not $touch)",
        "mapping_type": "pressed",
        "from_button_id": "button.menu_select",
        "to_button_id": "button.menu_select",
        "consume_event": false,
        "button_up_right_of_first_refusal": true
      }
    ]
  },
  "ks_uhud_offhand_switcher": {
    "type": "button",
    "layer": 25,
    "bindings": [
      {
        "binding_type": "collection_details",
        "binding_collection_name": "$item_collection_name"
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_inventory_cancel",
        "to_button_id": "button.consume",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.hide_gui",
        "to_button_id": "button.container_slot_hovered",
        "mapping_type": "global"
      }
    ]
  },
  "ks_uhud_offhand_grid": {
    "type": "grid",
    "size": [
      22,
      22
    ],
    "grid_dimensions": [
      1,
      1
    ],
    "$item_collection_name": "offhand_items",
    "collection_name": "$item_collection_name",
    "controls": [
      {
        "offhand_grid_item@ks_uhud.ks_uhud_offhand_slot": {
          "grid_position": [
            0,
            0
          ]
        }
      }
    ]
  },
  "ks_uhud_offhand_slot": {
    "type": "panel",
    "controls": [
      {
        "background": {
          "type": "image",
          "texture": "textures/ui/ks_uhud/offhand_slot"
        }
      },
      {
        "offhand_item@common.container_item": {
          "$cell_overlay_ref": "common.empty_panel",
          "$button_ref": "ks_uhud.ks_uhud_dummy_button",
          "$background_images": "common.empty_panel"
        }
      },
      {
        "0@ks_uhud.ks_uhud_item_durability": {
          "$ignore_renderer": true,
          "anchor_from": "left_middle",
          "anchor_to": "right_middle",
          "offset": [
            -10,
            0.5
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "(not (#item_id_aux = -1))",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      }
    ]
  },
  "ks_uhud_dummy_button": {
    "type": "button"
  },
  "ks_uhud_item_durability": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "size": [
      "100%c",
      "100%cm"
    ],
    "$ignore_renderer|default": false,
    "$fallback_texture|default": "",
    "controls": [
      {
        "item_icon": {
          "type": "image",
          "size": [
            16,
            16
          ],
          "allow_debug_missing_texture": false,
          "texture": "$fallback_texture",
          "ignored": "($ignore_renderer or ($fallback_texture = ''))",
          "controls": [
            {
              "icon@common.item_renderer": {}
            }
          ],
          "bindings": [
            {
              "binding_name": "#item_id_aux",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            },
            {
              "binding_type": "view",
              "source_property_name": "(1 * (#item_id_aux = -1))",
              "target_property_name": "#alpha"
            }
          ]
        }
      },
      {
        "spacer": {
          "type": "panel",
          "size": [
            5,
            0
          ]
        }
      },
      {
        "text_panel": {
          "type": "panel",
          "size": [
            "100%c",
            "100%sm"
          ],
          "bindings": [
            {
              "binding_name": "(#item_durability_total_amount > 0)",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "$item_collection_name"
            }
          ],
          "controls": [
            {
              "durability_text@ks_uhud.ks_uhud_durability_text": {}
            },
            {
              "warning": {
                "type": "image",
                "texture": "textures/ui/ks_uhud/alert",
                "size": [
                  8,
                  7
                ],
                "anchor_from": "right_middle",
                "anchor_to": "right_middle",
                "$limit": 0.225,
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "ks_uhud_durability_text",
                    "resolve_sibling_scope": true,
                    "source_property_name": "(not (#item_durability_current_amount > (#item_durability_total_amount * $limit)))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  "ks_uhud_durability_text": {
    "type": "label",
    "text": "#text",
    "localize": false,
    "shadow": true,
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "$prefix|default": "§z",
    "bindings": [
      {
        "binding_name": "#item_durability_total_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_name": "#item_durability_current_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#total_durability + (#total_durability < #item_durability_total_amount) * 1 - (#total_durability > #item_durability_total_amount) * 1)",
        "target_property_name": "#total_durability"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#item_durability_current_amount > 0) * #total_durability)",
        "target_property_name": "#current_durability"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#current_durability - (#item_durability_current_amount < #current_durability) * 1)",
        "target_property_name": "#current_durability"
      },
      {
        "binding_type": "view",
        "source_property_name": "($prefix + #current_durability + '/' + #total_durability)",
        "target_property_name": "#text"
      }
    ]
  },
  "ks_uhud_tag": {
    "type": "image",
    "texture": "textures/ui/white",
    "size": [
      "100%c + 8px",
      "100%c + 6px"
    ],
    "color": [
      0.14,
      0.55,
      0.27
    ],
    "$text": "Inv Open",
    "controls": [
      {
        "label": {
          "type": "label",
          "text": "$text",
          "layer": 1
        }
      }
    ]
  },
