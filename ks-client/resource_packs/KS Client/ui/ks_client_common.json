{
  "namespace": "ks_client",

  // ---------- Page open/close: radio group "ks_client_page" (open=0, close=1) ----------
  // Tapping the KS icon selects OPEN (page shows); tapping X selects CLOSE.
  // Default selected = 1 (closed), so the page starts hidden.
  "ks_page_open_toggle@common_toggles.light_text_toggle": {
    "size": [ "100% - 2px", "100% - 2px" ],
    "$button_text": "",
    "$toggle_name": "ks_client_page",
    "$toggle_view_binding_name": "ks_page_open_state",
    "$radio_toggle_group": true,
    "$toggle_group_forced_index": 0,
    "$toggle_group_default_selected": 1
  },

  "ks_page_close_toggle@common_toggles.light_text_toggle": {
    "size": [ 30, 30 ],
    "$button_text": "",
    "$toggle_name": "ks_client_page",
    "$toggle_view_binding_name": "ks_page_close_state",
    "$radio_toggle_group": true,
    "$toggle_group_forced_index": 1,
    "$toggle_group_default_selected": 1
  },

  // ---------- Center row: SAME 150x32 footprint, KS icon opens the KS page ----------
  // The toggle underneath flips the page overlay (radio group); the opaque
  // icon cover hides the toggle frame. Clicks pass through images.
  // (Minecraft Settings stays on the top-left gear icon.)
  "ks_client_start_row": {
    "type": "panel",
    "size": [ 150, 32 ],
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "controls": [
      {
        "ks_center_glow": {
          "type": "image",
          "texture": "textures/ui/ks_glow_play",
          "size": [ 190, 48 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, 2 ],
          "alpha": 0.35,
          "layer": 0
        }
      },
      {
        "ks_page_open_toggle@ks_client.ks_page_open_toggle": {
          "layer": 1
        }
      },
      {
        "ks_cover_ks": {
          "type": "image",
          "texture": "textures/ui/ks_cover_ks",
          "size": [ 150, 32 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, 0 ],
          "layer": 5
        }
      }
    ]
  },

  "ks_client_panel": {
    "type": "panel",
    "size": [ "100%", "100%c" ],
    "offset": [ 0, -16 ],
    "bindings": [
      {
        "binding_name": "(not #showing_new_player_flow_buttons)",
        "binding_name_override": "#visible"
      }
    ],
    "controls": [
      {
        "ks_client_row@ks_client.ks_client_start_row": {}
      }
    ]
  },

  // ---------- Cinematic scrims (readability + immersion, behind everything) ----------
  "ks_scrim_top": {
    "type": "panel",
    "size": [ "100%", 96 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 0, 0 ],
    "layer": 0,
    "controls": [
      {
        "ks_scrim_top_img": {
          "type": "image",
          "texture": "textures/ui/ks_scrim_top",
          "size": [ "100%", 96 ],
          "layer": 0
        }
      }
    ]
  },

  "ks_scrim_bottom": {
    "type": "panel",
    "size": [ "100%", 160 ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "offset": [ 0, 0 ],
    "layer": 0,
    "controls": [
      {
        "ks_scrim_bottom_img": {
          "type": "image",
          "texture": "textures/ui/ks_scrim_bottom",
          "size": [ "100%", 160 ],
          "layer": 0
        }
      }
    ]
  },

  // ---------- (brand header removed: text-free screen) ----------

  // ---------- (footer removed: text-free screen) ----------

  // ---------- Futuristic side rails (subtle, non-interactive) ----------
  "ks_edge_left": {
    "type": "panel",
    "size": [ 2, "28%" ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [ 3, 0 ],
    "layer": 1,
    "alpha": 0.6,
    "controls": [
      {
        "ks_edge_left_img": {
          "type": "image",
          "texture": "textures/ui/ks_divider_v",
          "size": [ 2, "100%" ],
          "layer": 1
        }
      }
    ]
  },

  "ks_edge_right": {
    "type": "panel",
    "size": [ 2, "28%" ],
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "offset": [ -3, 0 ],
    "layer": 1,
    "alpha": 0.6,
    "controls": [
      {
        "ks_edge_right_img": {
          "type": "image",
          "texture": "textures/ui/ks_divider_v",
          "size": [ 2, "100%" ],
          "layer": 1
        }
      }
    ]
  },

  // ---------- Top-left quick bar: SAME 224x30 at (8,8), settings is now an icon ----------
  // Vanilla settings button stays underneath (full behaviour); the opaque
  // gear cover hides its text. Clicks pass through images.
  "ks_top_bar": {
    "type": "panel",
    "size": [ 224, 30 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 8, 8 ],
    "layer": 2,
    "controls": [
      {
        "ks_top_bg": {
          "type": "image",
          "texture": "textures/ui/ks_pill_dark",
          "size": [ 224, 30 ],
          "layer": 0,
          "alpha": 0.92
        }
      },
      {
        "ks_top_accent": {
          "type": "image",
          "texture": "textures/ui/ks_accent_cyan",
          "size": [ 224, 2 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ],
          "layer": 1,
          "alpha": 0.9
        }
      },
      {
        "ks_top_stack": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ 224, 30 ],
          "layer": 2,
          "controls": [
            {
              "ks_settings_slot": {
                "type": "panel",
                "size": [ 100, 30 ],
                "controls": [
                  {
                    "ks_settings_button@start.settings_button": {}
                  },
                  {
                    "ks_cover_settings": {
                      "type": "image",
                      "texture": "textures/ui/ks_cover_settings",
                      "size": [ 100, 30 ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "offset": [ 0, 0 ],
                      "layer": 5
                    }
                  }
                ]
              }
            },
            {
              "ks_top_gap": {
                "type": "panel",
                "size": [ 4, 30 ]
              }
            },
            {
              "ks_profile_slot": {
                "type": "panel",
                "size": [ 120, 30 ],
                "controls": [
                  {
                    "ks_profile_button@start.profile_button": {}
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  // ---------- Profile card: SAME 224x64 at (8,42), avatar + username only ----------
  "ks_profile_card": {
    "type": "panel",
    "size": [ 224, 64 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 8, 42 ],
    "layer": 2,
    "controls": [
      {
        "ks_card_bg": {
          "type": "image",
          "texture": "textures/ui/ks_glass_panel",
          "size": [ 224, 64 ],
          "layer": 0,
          "alpha": 0.94
        }
      },
      {
        "ks_card_rail": {
          "type": "image",
          "texture": "textures/ui/ks_accent_gold",
          "size": [ 4, 64 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ],
          "layer": 1
        }
      },
      {
        "ks_card_content": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100% - 20px", 44 ],
          "offset": [ 12, 0 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "layer": 2,
          "controls": [
            {
              "ks_gamerpic_with_border": {
                "type": "panel",
                "size": [ 26, 44 ],
                "controls": [
                  {
                    "gamerpic@start.gamerpic": {
                      "$gamerpic_visible": "#show_gamerpic"
                    }
                  },
                  {
                    "alex_icon@start.alex_icon": {
                      "bindings": [
                        {
                          "binding_name": "(not #show_gamerpic)",
                          "binding_name_override": "#visible"
                        }
                      ]
                    }
                  },
                  {
                    "border_black@common.focus_border_black": {
                      "layer": 3,
                      "size": [ 24, 24 ],
                      "anchor_from": "top_middle",
                      "anchor_to": "top_middle",
                      "offset": [ 0, 0 ]
                    }
                  }
                ]
              }
            },
            {
              "ks_name_gap": {
                "type": "panel",
                "size": [ 8, 44 ]
              }
            },
            {
              "ks_name_column": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ "fill", 44 ],
                "controls": [
                  {
                    "ks_player_name": {
                      "type": "label",
                      "size": [ "100%", 20 ],
                      "color": [ 255, 255, 255 ],
                      "shadow": true,
                      "text": "",
                      "bindings": [
                        {
                          "binding_name": "#playername",
                          "binding_name_override": "#text"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  // ---------- Bottom-left row: SAME 264x32 at (8,-8), glass pill + divider ----------
  "ks_bottom_left_row": {
    "type": "panel",
    "size": [ 264, 32 ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "offset": [ 8, -8 ],
    "layer": 2,
    "controls": [
      {
        "ks_bl_bg": {
          "type": "image",
          "texture": "textures/ui/ks_pill_dark",
          "size": [ 264, 32 ],
          "layer": 0,
          "alpha": 0.92
        }
      },
      {
        "ks_bl_accent": {
          "type": "image",
          "texture": "textures/ui/ks_accent_cyan",
          "size": [ 264, 2 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ],
          "layer": 1,
          "alpha": 0.85
        }
      },
      {
        "ks_bl_stack": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ 264, 32 ],
          "layer": 2,
          "controls": [
            {
              "ks_store_slot": {
                "type": "panel",
                "size": [ 160, 32 ],
                "ignored": "$store_ignored",
                "controls": [
                  {
                    "ks_store_stack@start.store_button_stack": {}
                  }
                ]
              }
            },
            {
              "ks_bl_divider": {
                "type": "panel",
                "size": [ 4, 32 ],
                "controls": [
                  {
                    "ks_bl_div_img": {
                      "type": "image",
                      "texture": "textures/ui/ks_divider_v",
                      "size": [ 2, 20 ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "layer": 1,
                      "alpha": 0.8
                    }
                  }
                ]
              }
            },
            {
              "ks_realms_slot": {
                "type": "panel",
                "size": [ 100, 32 ],
                "ignored": "($trial or $is_preview_app)",
                "controls": [
                  {
                    "ks_realms_button@start.realms_button": {
                      "$button_text": "menu.realms"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  // ---------- Bottom-right PLAY: SAME 190x40 at (-8,-8), image cover over vanilla stack ----------
  // Vanilla play stack stays underneath (full behaviour); the opaque banner
  // cover hides its text. Clicks pass through images. Social + Realms keep text.
  "ks_bottom_right_play": {
    "type": "panel",
    "size": [ 190, 40 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ -8, -8 ],
    "layer": 2,
    "controls": [
      {
        "ks_play_glow": {
          "type": "image",
          "texture": "textures/ui/ks_glow_play",
          "size": [ 230, 64 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, 0 ],
          "alpha": 0.85,
          "layer": 0
        }
      },
      {
        "ks_play_stack@start.play_button_stack": {
          "layer": 2
        }
      },
      {
        "ks_cover_play": {
          "type": "image",
          "texture": "textures/ui/ks_cover_play",
          "size": [ 190, 40 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, 0 ],
          "layer": 5
        }
      }
    ]
  },

  // ================= KS CLIENT PAGE (overlay, radio-group tabs) =================
  // Tabs share group "ks_client_tabs" (Overview=0 default). Each tab content
  // panel binds #visible to its own tab toggle's #toggle_state.

  "ks_tab_overview_toggle@common_toggles.light_text_toggle": {
    "size": [ "100%", 36 ],
    "$button_text": "",
    "$toggle_name": "ks_client_tabs",
    "$toggle_view_binding_name": "ks_tab_overview_state",
    "$radio_toggle_group": true,
    "$toggle_group_forced_index": 0,
    "$toggle_group_default_selected": 0
  },

  "ks_tab_info_toggle@common_toggles.light_text_toggle": {
    "size": [ "100%", 36 ],
    "$button_text": "",
    "$toggle_name": "ks_client_tabs",
    "$toggle_view_binding_name": "ks_tab_info_state",
    "$radio_toggle_group": true,
    "$toggle_group_forced_index": 1,
    "$toggle_group_default_selected": 0
  },

  "ks_tab_graphic_toggle@common_toggles.light_text_toggle": {
    "size": [ "100%", 36 ],
    "$button_text": "",
    "$toggle_name": "ks_client_tabs",
    "$toggle_view_binding_name": "ks_tab_graphic_state",
    "$radio_toggle_group": true,
    "$toggle_group_forced_index": 2,
    "$toggle_group_default_selected": 0
  },

  "ks_tab_settings_toggle@common_toggles.light_text_toggle": {
    "size": [ "100%", 36 ],
    "$button_text": "",
    "$toggle_name": "ks_client_tabs",
    "$toggle_view_binding_name": "ks_tab_settings_state",
    "$radio_toggle_group": true,
    "$toggle_group_forced_index": 3,
    "$toggle_group_default_selected": 0
  },

  // One tab unit: hidden toggle + pill bg + text label + gold underline when active.
  "ks_tab_unit": {
    "type": "panel",
    "size": [ "25%", 36 ],
    "$tab_toggle": "ks_client.ks_tab_overview_toggle",
    "$tab_state": "ks_tab_overview_state",
    "$tab_text": "Overview",
    "controls": [
      {
        "tab_toggle@$tab_toggle": {
          "layer": 1
        }
      },
      {
        "tab_bg": {
          "type": "image",
          "texture": "textures/ui/ks_pill_dark",
          "size": [ "100%", 36 ],
          "alpha": 0.9,
          "layer": 2
        }
      },
      {
        "tab_label": {
          "type": "label",
          "size": [ "100%", 20 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, -2 ],
          "text": "$tab_text",
          "color": [ 255, 255, 255 ],
          "shadow": true,
          "text_alignment": "center",
          "layer": 3
        }
      },
      {
        "tab_underline": {
          "type": "image",
          "texture": "textures/ui/ks_accent_gold",
          "size": [ "80%", 3 ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [ 0, -4 ],
          "layer": 3,
          "visible": false,
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "$tab_state",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ]
        }
      }
    ]
  },

  // "Coming soon" body shared by every tab (Overview adds the pack header above it).
  "ks_coming_soon_body": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "$sub_text": "More content is on the way.",
    "controls": [
      {
        "coming_title": {
          "type": "label",
          "size": [ "100%", 26 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, -12 ],
          "text": "COMING SOON",
          "color": [ 255, 255, 255 ],
          "font_size": "large",
          "shadow": true,
          "text_alignment": "center",
          "layer": 1
        }
      },
      {
        "coming_gold": {
          "type": "image",
          "texture": "textures/ui/ks_accent_gold",
          "size": [ 140, 3 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, 8 ],
          "layer": 1
        }
      },
      {
        "coming_sub": {
          "type": "label",
          "size": [ "100%", 16 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, 24 ],
          "text": "$sub_text",
          "color": [ 150, 180, 210 ],
          "shadow": true,
          "text_alignment": "center",
          "layer": 1
        }
      }
    ]
  },

