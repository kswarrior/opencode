{
  "namespace": "ks_client",

  // (Center KS row retired: the KS icon now lives in the top-left bar.)

  // (Scrims removed: solid black bg needs no readability gradient.)

  // ---------- (brand header removed: text-free screen) ----------

  // ---------- (footer removed: text-free screen) ----------

  // ---------- Futuristic side rails (subtle, non-interactive) ----------
  "ks_edge_left": {
    "type": "panel",
    "size": [ 2, "28%" ],
    "anchor_from": "left_middle",
    "anchor_to": "left_middle",
    "offset": [ 3, 0 ],
    "layer": 1,
    "alpha": 0.6,
    "controls": [
      {
        "ks_edge_left_img": {
          "type": "image",
          "texture": "textures/ui/ks_divider_v",
          "size": [ 2, "100%" ],
          "layer": 1
        }
      }
    ]
  },

  "ks_edge_right": {
    "type": "panel",
    "size": [ 2, "28%" ],
    "anchor_from": "right_middle",
    "anchor_to": "right_middle",
    "offset": [ -3, 0 ],
    "layer": 1,
    "alpha": 0.6,
    "controls": [
      {
        "ks_edge_right_img": {
          "type": "image",
          "texture": "textures/ui/ks_divider_v",
          "size": [ 2, "100%" ],
          "layer": 1
        }
      }
    ]
  },

  // Borderless icon button: no vanilla frame/text/hold visuals at all.
  // Art IS the button (exact slot size). Press shift forced to zero.
  "ks_settings_button@common_buttons.no_background_content_button": {
    "size": [ 30, 30 ],
    "$button_text": "",
    "$button_content": "ks_client.settings_icon_content",
    "$pressed_button_name": "button.menu_settings",
    "$button_offset": [ 0, 0 ],
    "$button_pressed_offset": [ 0, 0 ],
    "$pressed_button_offset": [ 0, 0 ]
  },

  "settings_icon_content": {
    "type": "panel",
    "size": [ 30, 30 ],
    "controls": [
      {
        "settings_icon_img": {
          "type": "image",
          "texture": "textures/ui/ks_icon_settings",
          "size": [ 30, 30 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, -2 ]
        }
      }
    ]
  },

  // ---------- Dressing room button: square like settings, same borderless pattern ----------
  // $pressed_button_name button.menu_skins = vanilla start-screen change-skin
  // action (opens the character / dressing-room editor). Same engine press path.
  "ks_dressing_button@common_buttons.no_background_content_button": {
    "size": [ 30, 30 ],
    "$button_text": "",
    "$button_content": "ks_client.dressing_icon_content",
    "$pressed_button_name": "button.menu_skins",
    "$button_offset": [ 0, 0 ],
    "$button_pressed_offset": [ 0, 0 ],
    "$pressed_button_offset": [ 0, 0 ]
  },

  "dressing_icon_content": {
    "type": "panel",
    "size": [ 30, 30 ],
    "controls": [
      {
        "dressing_icon_img": {
          "type": "image",
          "texture": "textures/ui/ks_icon_dressing",
          "size": [ 30, 30 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, -2 ]
        }
      }
    ]
  },

  // ---------- Profile button: [avatar + username], borderless like settings ----------
  // Replaces vanilla (avatar + static "Profile" text). Same engine press path.
  "ks_profile_button@common_buttons.no_background_content_button": {
    "size": [ 120, 30 ],
    "$button_text": "",
    "$button_content": "ks_client.profile_button_content",
    "$pressed_button_name": "button.menu_profile",
    "$button_offset": [ 0, 0 ],
    "$button_pressed_offset": [ 0, 0 ],
    "$pressed_button_offset": [ 0, 0 ]
  },

  "profile_button_content": {
    "type": "panel",
    "size": [ 120, 30 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 0, 0 ],
    "layer": 1,
    "controls": [
      {
        "pb_bg": {
          "type": "image",
          "texture": "textures/ui/ks_profile_bg",
          "size": [ 120, 30 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ],
          "layer": 0
        }
      },
      {
        "pb_avatar": {
          "type": "panel",
          "size": [ 24, 24 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 5, 0 ],
          "layer": 2,
          "controls": [
            {
              "gamerpic@start.gamerpic": {
                "size": [ 18, 18 ],
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [ 0, 0 ],
                "layer": 1,
                "$gamerpic_visible": "#show_gamerpic",
                "bindings": [
                  {
                    "binding_name": "#show_gamerpic",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            },
            {
              "alex_icon@start.alex_icon": {
                "size": [ 18, 18 ],
                "anchor_from": "center",
                "anchor_to": "center",
                "offset": [ 0, 0 ],
                "layer": 1,
                "bindings": [
                  {
                    "binding_name": "(not #show_gamerpic)",
                    "binding_name_override": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "pb_name": {
          "type": "label",
          "size": [ 81, 20 ],
          "max_size": [ 81, 20 ],
          "anchor_from": "left_middle",
          "anchor_to": "left_middle",
          "offset": [ 33, 0 ],
          "color": [ 255, 255, 255 ],
          "shadow": true,
          "localize": false,
          "text_alignment": "left",
          "font_size": "normal",
          "font_scale_factor": 0.85,
          "alpha": 1.0,
          "visible": true,
          "layer": 2,
          "text": "#gamertag_label",
          "bindings": [
            {
              "binding_name": "#gamertag_label"
            }
          ]
        }
      }
    ]
  },

  "ks_top_bar": {
    "type": "panel",
    "size": [ 154, 30 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 8, 8 ],
    "layer": 2,
    "controls": [
      {
        "ks_top_stack": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ 154, 30 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, -2 ],
          "layer": 2,
          "controls": [
            {
              "ks_settings_slot": {
                "type": "panel",
                "size": [ 30, 30 ],
                "offset": [ 0, -2 ],
                "controls": [
                  {
                    "ks_settings_button@ks_client.ks_settings_button": {}
                  }
                ]
              }
            },
            {
              "ks_top_gap": {
                "type": "panel",
                "size": [ 4, 30 ],
                "controls": [
                  {
                    "ks_top_div_img": {
                      "type": "image",
                      "texture": "textures/ui/ks_divider_v",
                      "size": [ 2, 18 ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "layer": 1,
                      "alpha": 0.8
                    }
                  }
                ]
              }
            },
            {
              "ks_profile_slot": {
                "type": "panel",
                "size": [ 120, 30 ],
                "offset": [ 0, -2 ],
                "controls": [
                  {
                    "profile_button@ks_client.ks_profile_button": {}
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  // (Profile card removed: username now lives in the profile button.)

  // ---------- Dressing room square left of doll, bottom-aligned with doll ----------
  // 30x30 like the settings button. Anchored bottom_middle so its bottom edge
  // sits exactly on the doll (skin_panel) bottom: same Y offset "-10% - 36px".
  // X "-25% + 12px" = left of doll with ~10px gap (doll half-width is 25% - 37.5px).
  "ks_dressing_below_settings": {
    "type": "panel",
    "size": [ 30, 30 ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ "-25% + 12px", "-10% - 36px" ],
    "layer": 2,
    "controls": [
      {
        "ks_dressing_slot": {
          "type": "panel",
          "size": [ 30, 30 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ],
          "controls": [
            {
              "ks_dressing_button@ks_client.ks_dressing_button": {}
            }
          ]
        }
      }
    ]
  },

  // ---------- Social button below the settings button (top-left) ----------
  // Friends/social entry moved out of the top-right cluster (bell only).
  // Same vanilla press path as before, just re-parented under settings.
  // Dressing moved to the doll, so social slides left to x=8 to fill the gap.
  "ks_social_below_settings": {
    "type": "panel",
    "size": [ 40, 32 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 8, 44 ],
    "layer": 2,
    "controls": [
      {
        "ks_social_slot": {
          "type": "panel",
          "size": [ 40, 32 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ],
          "controls": [
            {
              "friendsdrawer_button@friendsbutton.button_panel": {
                "size": [ 40, 32 ],
                "$context": "start"
              }
            }
          ]
        }
      }
    ]
  },

  // ---------- Bottom-left row: SAME 264x32 at (8,-8), glass pill + divider ----------
  "ks_bottom_left_row": {
    "type": "panel",
    "size": [ 264, 32 ],
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "offset": [ 8, -8 ],
    "layer": 2,
    "controls": [
      {
        "ks_bl_stack": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ 264, 32 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, -2 ],
          "layer": 2,
          "controls": [
            {
              "ks_store_slot": {
                "type": "panel",
                "size": [ 160, 32 ],
                "ignored": "$store_ignored",
                "controls": [
                  {
                    "ks_store_stack@start.store_button_stack": {
                      "size": [ "100%", "100%" ]
                    }
                  }
                ]
              }
            },
            {
              "ks_bl_divider": {
                "type": "panel",
                "size": [ 4, 32 ],
                "controls": [
                  {
                    "ks_bl_div_img": {
                      "type": "image",
                      "texture": "textures/ui/ks_divider_v",
                      "size": [ 2, 20 ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "layer": 1,
                      "alpha": 0.8
                    }
                  }
                ]
              }
            },
            {
              "ks_realms_slot": {
                "type": "panel",
                "size": [ 100, 32 ],
                "ignored": "($trial or $is_preview_app)",
                "controls": [
                  {
                    "ks_realms_button@start.realms_button": {
                      "size": [ "100%", "100%" ],
                      "$button_text": "menu.realms"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  // ---------- Bottom-right PLAY: 95x32 at (-8,-8), same height/baseline as store row ----------
  // start.play_button is overridden (no frame/text/hold visuals, art IS the
  // button, same engine press path). Social + Realms keep text.
  "ks_bottom_right_play": {
    "type": "panel",
    "size": [ 95, 32 ],
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "offset": [ -8, -8 ],
    "layer": 2,
    "controls": [
      {
        "ks_play_button@start.ks_play_button": {
          "size": [ 95, 32 ],
          "layer": 2
        }
      }
    ]
  }
}
