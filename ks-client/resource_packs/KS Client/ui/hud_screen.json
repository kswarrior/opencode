{
  "namespace": "hud",

  // HUD info readouts (Asteroid pattern): each row visible <=> matching
  // pause Info switch ON. Toggle states live in pause_screen
  // (ks_hud_*_state); HUD binds to them cross-screen like Asteroid's
  // asteroid.toggle.mod.* bindings. Coords shows REAL position via global.
  "ks_hud_info": {
    "type": "stack_panel",
    "orientation": "vertical",
    "size": [ 180, 190 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 8, 60 ],
    "layer": 10,
    "controls": [
      {
        "ks_h_fps": {
          "type": "panel",
          "visible": false,
          "size": [ "100%", 22 ],
          "bindings": [
            {
              "binding_type": "view",
              "binding_condition": "always",
              "source_control_name": "ks_hud_fps_state",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            }
          ],
          "controls": [
            {
              "ks_h_fps_bg": {
                "type": "image",
                "texture": "textures/ui/ks_config_btn",
                "size": [ "100%", "100%" ],
                "layer": 0
              }
            },
            {
              "ks_h_fps_icon": {
                "type": "image",
                "texture": "textures/ui/ks_info_fps",
                "size": [ 18, 18 ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "offset": [ 4, 0 ],
                "layer": 1
              }
            },
            {
              "ks_h_fps_lbl": {
                "type": "label",
                "size": [ "100% - 30px", 22 ],
                "anchor_from": "left_middle",
                "anchor_to": "left_middle",
                "offset": [ 28, 0 ],
                "color": [ 255, 255, 255 ],
                "shadow": true,
                "localize": false,
                "text_alignment": "left",
                "font_size": "small",
                "font_scale_factor": 0.9,
                "layer": 1,
                "text": "FPS: 60"
              }
