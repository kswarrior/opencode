                    }
                  },
                  {
                    "ks_bri_value": {
                      "type": "label",
                      "size": [ 114, 22 ],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "offset": [ 30, 0 ],
                      "color": [ 255, 255, 255 ],
                      "localize": false,
                      "text_alignment": "center",
                      "text": "50%"
                    }
                  },
                  {
                    "ks_bri_plus@common_buttons.light_text_button": {
                      "size": [ 30, 22 ],
                      "anchor_from": "top_right",
                      "anchor_to": "top_right",
                      "offset": [ 0, 0 ],
                      "$button_text": "+",
                      "$pressed_button_name": "button.menu_ok"
                    }
                  }
                ]
              }
            },
            {
              "ks_quality_toggle@common_toggles.light_text_toggle": {
                "size": [ 174, 22 ],
                "$button_text": "Quality ▾",
                "$toggle_name": "ks_quality_drop",
                "$toggle_view_binding_name": "ks_quality_drop_state"
              }
            },
            {
              "ks_quality_options": {
                "type": "stack_panel",
                "orientation": "vertical",
                "size": [ 174, 66 ],
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "ks_quality_drop_state",
                    "source_property_name": "#toggle_state",
                    "target_property_name": "#visible"
                  }
                ],
                "controls": [
                  {
                    "ks_q_low@common_toggles.light_text_toggle": {
                      "size": [ 174, 20 ],
                      "$button_text": "Low",
                      "$toggle_name": "ks_q_low",
                      "$toggle_view_binding_name": "ks_q_low_state"
                    }
                  },
                  {
                    "ks_q_med@common_toggles.light_text_toggle": {
                      "size": [ 174, 20 ],
                      "$button_text": "Medium",
                      "$toggle_name": "ks_q_med",
                      "$toggle_view_binding_name": "ks_q_med_state"
                    }
                  },
                  {
                    "ks_q_high@common_toggles.light_text_toggle": {
                      "size": [ 174, 20 ],
                      "$button_text": "High",
                      "$toggle_name": "ks_q_high",
                      "$toggle_view_binding_name": "ks_q_high_state"
                    }
                  }
                ]
              }
            },
            {
              "ks_hint": {
                "type": "label",
                "size": [ 174, 36 ],
                "color": [ 160, 170, 185 ],
                "localize": false,
                "text_alignment": "left",
                "font_size": "small",
                "font_scale_factor": 0.85,
                "text": "Tap MENU again to close."
              }
            },
            {
              "ks_right_footer": {
                "type": "label",
                "size": [ 174, 20 ],
                "color": [ 100, 220, 255 ],
                "shadow": true,
                "localize": false,
                "text_alignment": "center",
                "font_size": "small",
                "font_scale_factor": 0.9,
                "text": "KS Warrior"
              }
            }
          ]
        }
      }
    ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "ks_menu_holder@hud.ks_menu_holder": {}
          },
          {
            "ks_left_sidebar@hud.ks_left_sidebar": {}
          },
          {
            "ks_right_sidebar@hud.ks_right_sidebar": {}
          }
        ]
      }
    ]
  }
}
