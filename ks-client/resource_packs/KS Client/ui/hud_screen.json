{
  "namespace": "hud",

  // (Removed per request: Utility HUD V-1.5 fully removed — durability/crosshair/toggles/redirects gone.)
  "hud_screen": {
    "always_accepts_input": true
  },

  // ---------- Paperdoll renderer (vanilla copy) ----------
  // Hides vanilla doll/coords/days, styles
  // selected-slot art. Vanilla root_panel copy, touch-indicator override,
  // progress/player_renderer2-3 and hud_content.controls deliberately NOT
  // ported (stale-copy risk / missing toggle / unreferenced).
  "hud_player_renderer": {
    "type": "panel",
    "size": [
      65,
      65
    ],
    "offset": [
      0,
      0
    ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "ignored": true,
    "controls": [
      {
        "hud_player": {
          "type": "custom",
          "renderer": "hud_player_renderer",
          "layer": 1,
          "animation_reset_name": "screen_animation_reset",
          "anims": [
            "@common.screen_exit_size_animation_push",
            "@common.screen_exit_size_animation_pop",
            "@common.screen_entrance_size_animation_push",
            "@common.screen_entrance_size_animation_pop"
          ],
          "bindings": [
            {
              "binding_name": "#paper_doll_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },
  "root_panel/exp_rend": {
    "ignored": "$always_visible_hotbar"
  },
  "centered_gui_elements_at_bottom_middle/exp_rend": {
    "ignored": "$always_visible_hotbar"
  },
  "hotbar_slot_selected_image": {
    "type": "image",
    "texture": "textures/ui/selected_hotbar_slot",
    "size": [
      24,
      24
    ],
    "layer": 8,
    "bindings": [
      {
        "binding_name": "#slot_selected",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "$hotbar_collection_name"
      }
    ]
  },
  "player_position": {
    "ignored": true,
    "type": "image",
    "size": [
      "100%c + 6px",
      "100%c + 2px"
    ],
    "texture": "textures/ui/Black",
    "alpha": 0.7,
    "controls": [
      {
        "player_position_text": {
          "type": "label",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 1,
          "enable_profanity_filter": false,
          "color": "$chat_text_color",
          "text": "#text",
          "shadow": true
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#player_position_visible",
        "binding_name_override": "#visible",
        "binding_condition": "always",
        "binding_type": "global"
      },
      {
        "binding_name": "#number_of_days_played_text",
        "binding_name_override": "#text",
        "binding_condition": "always_when_visible",
        "binding_type": "global"
      }
    ]
  },
  // Displays number of played in-game days
  "number_of_days_played": {
    "ignored": true,
    "type": "image",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [
      "100%c + 6px",
      "100%c + 2px"
    ],
    "texture": "textures/ui/Black",
    "alpha": 0.7,
    "controls": [
      {
        "number_of_days_played_text": {
          "type": "label",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 1,
          "enable_profanity_filter": false,
          "color": "$chat_text_color",
          "text": "#text",
          "shadow": true
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#number_of_days_played_visible",
        "binding_name_override": "#visible",
        "binding_condition": "always",
        "binding_type": "global"
      },
      {
        "binding_name": "#number_of_days_played_text",
        "binding_name_override": "#text",
        "binding_condition": "always_when_visible",
        "binding_type": "global"
      }
    ]
  },

  // ---------- KS Clean Touch Controls (base layout tweaks) ----------
  // Vanilla touch-layout redefinitions: centered bottom-middle cluster sizing,
  // inventory button row, elipses helpers.
  "hotbar_elipses_button@borderless_button": {
    "sound_volume": "$hud_elipses_sound_volume"
  },

  "elipses_image": {
    "ignored": "(not $hud_elipses_enabled)"
  },

  "hotbar_elipses_panel_right_content": {
    "ignored": "(not $hud_elipses_enabled)"
  },

  "inventory_button": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": [ 226, 22 ],
    "offset": [ 0, -2 ],
    "layer": 4,
    "controls": [
      {
        "padding": {
          "type": "panel",
          "size": [ "fill", "100%" ]
        }
      },
      {
        "button@common.button": {
          "$pressed_button_name": "button.hotbar_inventory_button",
          "size": [ 22, "100%" ]
        }
      }
    ]
  },

  "centered_gui_elements_at_bottom_middle_touch": {
    "size": "$size",
    "$size": [ 180, 50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$size": [ 200, 50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/bubbles_rend_0": {
    "offset": "$offset",
    "$offset": [ 180, -50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/bubbles_rend_1": {
    "offset": "$offset",
    "$offset": [ 180, -50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/hunger_rend": {
    "offset": "$offset",
    "$offset": [ 180, -40 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -40 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/horse_heart_rend_1": {
    "offset": "$offset",
    "$offset": [ 180, -50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/horse_heart_rend_0": {
    "offset": "$offset",
    "$offset": [ 180, -56 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -56 ]
    }
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "inv_button@hud.inventory_button": {}
          }
        ]
      },
      // KS Inventory HUD (Bottom Right): inventory grid overlay.
      // Fixed bottom-right via ks_b6As_defs ($inv_pos/$inv_offs).
      // Visibility follows the HUD menu Show toggle live (ksbT_invhud_t, default $ksb_invhud_v true).
      // Compact via $ksb_invhud_small.
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "ks_invhud_pos@hud.ks_invhud_pos": {}
          }
        ]
      },
      // KS Durability HUD (Bottom Left): selected-item durability readout.
      // Fixed bottom-left via $ksd_hud_* globals (rebranded ZenXveda zx_durability).
      // Visibility follows the HUD menu Show toggle live (ksdT_dura_t, default $ksd_dura_v true).
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "ks_dura_pos@hud.ks_dura_pos": {}
          }
        ]
      },
      // (Removed per request: Utility HUD + KS F3/F8 keys fully removed.)
      // KS FPS counter (Top Left, always on): paper-doll digits overlay.
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "fps_counter@ks_fps.fps_counter_mask": {}
        }
      }
    ]
  },

  // Unhide MUST be a sibling of root_panel, not inside it: root_panel is
  // bound to #hud_visible, so anything inside it disappears with the HUD and
  // touch users tapping F1 could get stuck with no way back.
  // Slot Hotbar Button by KS Client (insert_front) + KS show-HUD
  // (insert_back) coexist as separate modifications on hud_content.
  // KS F1/F3 keys (same-to-same Default-mobile vs NeBux F1 & F3 Button v1.1.3):
  // F1 [-39, 0.5] hides HUD, F3 [38.5, 0.5] toggles ks_f3_panel + ks_f3_right,
  // "F1 -" bar is the way back.
  // Quick Totem Offhand button by KS Client (insert_front): 30x30 (40 -25%),
  // raised 30px (new size) above the Offhand default.
  "hud_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "totem_pos@hud.totem_btn_pos": {}
          }
        ]
      },
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "ks_f1@ks_client.ks_f1_button": {}
          },
          {
            "ks_f3_t@ks_client.ks_f3_button": {}
          },
          {
            "ks_f3@ks_client.ks_f3_panel": {}
          },
          {
            "ks_f3_r@ks_client.ks_f3_right": {}
          }
        ]
      },
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "ksb_buttons@ksb_main.slot_hotbar_button_panel": {}
          },
          {
            "ksb_button_editor@ksb_main.editor_button": {}
          },
          {
            "ksb_editor_panel@ksb_main.editor_panel": {}
          }
        ]
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "ks_show_hud@ks_client.ks_show_hud": {}
          }
        ]
      }
    ]
  },

  // KS perf flags for the HUD screen (telemetry off, cached screen).
  "hud_screen@common.base_screen": {
    "send_telemetry": false,
    "low_frequency_rendering": true,
    "load_screen_immediately": true,
    "cache_screen": true
  },

  // ---------- KS Inventory HUD position wrapper (fullscreen neutral) ----------
  // Fullscreen so the inner panel lands bottom-right via $inv_pos/$inv_offs.
  // Visibility follows the HUD menu Show toggle live (ksbT_invhud_t, default $ksb_invhud_v true).
  // Fixed: split toggle copy + local AND (was "(#toggle_state and #hud_visible)" with source_control,
  // which reads #hud_visible off the toggle itself -> always false -> grid never visible).
  "ks_invhud_pos": {
    "type": "panel",
    "size": ["100%", "100%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [0, 0],
    "visible": "$ksb_invhud_v",
    "layer": 44,
    "property_bag": {
      "#ks_invhud_toggle": true
    },
    "controls": [
      {
        "ks_inventory_hud@ks_hud.inventory_hud_panel": {}
      }
    ],
    "bindings": [
      {
        "binding_name": "#hud_visible",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_control_name": "ksbT_invhud_t",
        "source_property_name": "#toggle_state",
        "target_property_name": "#ks_invhud_toggle"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_visible and #ks_invhud_toggle)",
        "target_property_name": "#visible"
      }
    ]
  },

  // ---------- KS Durability HUD position wrapper (fullscreen neutral) ----------
  // Fullscreen so the inner panel lands bottom-left via $ksd_hud_* globals.
  // Visibility follows the HUD menu Show toggle live (ksdT_dura_t, default $ksd_dura_v true).
  // Fixed: same split-toggle pattern as ks_invhud_pos (was always-false combined view binding).
  "ks_dura_pos": {
    "type": "panel",
    "size": ["100%", "100%"],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [0, 0],
    "visible": "$ksd_dura_v",
    "layer": 46,
    "property_bag": {
      "#ks_dura_toggle": true
    },
    "controls": [
      {
        "ksd_content@ksd_hud.dd_content": {}
      }
    ],
    "bindings": [
      {
        "binding_name": "#hud_visible",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_control_name": "ksdT_dura_t",
        "source_property_name": "#toggle_state",
        "target_property_name": "#ks_dura_toggle"
      },
      {
        "binding_type": "view",
        "source_property_name": "(#hud_visible and #ks_dura_toggle)",
        "target_property_name": "#visible"
      }
    ]
  },

  // ---------- Quick Totem Offhand button (KS Client) ----------
  // Positioned live by the editor totem sliders via the resizer wrapper
  // ($ksb_totem_x/y are 0-100 slider positions: px offset = value-125 / value-35).
  // NOTE: htotem_y_slider is the X axis (-125), htotem_x_slider is the Y axis (-35),
  // matching ksb_main.editor_stack_templete + slot_button_item resizer mapping.
  // Visibility follows the totem toggle live; size tries the size slider.
  "totem_btn_pos": {
    "type": "panel",
    "size": [1, 1],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "visible": "$ksb_totem_v",
    "layer": 50,
    "use_anchored_offset": true,
    "property_bag": {
      "#anchored_offset_value_x": 1.0,
      "#anchored_offset_value_y": 1.0
    },
    "controls": [
      {
        "totem_btn@settings_common.action_button": {
          "prevent_touch_input": true,
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [0, 0],
          "size": [30, 30],
          "visible": "$ksb_totem_v",
          "layer": 50,
          "property_bag": {
            "#size_binding_x": 1.0,
            "#size_binding_y": 1.0
          },
          "$border_visible": false,
          "$button_text": "",
          "$pressed_button_name": "button.hotbar_inventory_button",
          "$default_button_texture|default": "textures/totem/totem_button",
          "$hover_button_texture|default": "textures/totem/totem_button",
          "$pressed_button_texture|default": "textures/totem/totem_button",
          "$locked_button_texture|default": "textures/totem/totem_button",
          "bindings": [
            {
              "binding_type": "view",
              "source_control_name": "ksbT_totem_t",
              "source_property_name": "#toggle_state",
              "target_property_name": "#visible"
            },
            {
              "binding_type": "view",
              "source_control_name": "htotem_size_slider",
              "source_property_name": "#slider_val",
              "target_property_name": "#size_binding_x"
            },
            {
              "binding_type": "view",
              "source_control_name": "htotem_size_slider",
              "source_property_name": "#slider_val",
              "target_property_name": "#size_binding_y"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#hud_visible",
        "binding_type": "global"
      },
      {
        "binding_type": "view",
        "source_property_name": "#hud_visible",
        "target_property_name": "#visible"
      },
      {
        "binding_type": "view",
        "source_control_name": "htotem_y_slider",
        "source_property_name": "(#slider_val - 125)",
        "target_property_name": "#anchored_offset_value_x"
      },
      {
        "binding_type": "view",
        "source_control_name": "htotem_x_slider",
        "source_property_name": "(#slider_val - 35)",
        "target_property_name": "#anchored_offset_value_y"
      }
    ]
  }

  // KS crosshair: dynamic indicator lives in ui/hud_crosshair_overlay.json
  // (hud_crosshair engine screen, rebranded PandaMine v1.1 default/entity art
  // via $ks_crosshair_v/size/alpha/offset) — 1st-person only, engine hides in
  // 2nd/3rd. No hud_screen panel: always-on images drew over the player face
  // in 3rd-person views. Vanilla fallback textures/ui/crosshair.png +
  // textures/gui/newgui/HUD/crosshair.png kept (same default art).
}
