{
  "namespace": "hud",

  // Test row: Q/W/A/F. F = hide GUI (F1). Q/W/A use other vanilla IDs
  // to check whether HUD presses work at all, or only hide_gui is dead.
  // Q = chat, W = emote, A = hide paperdoll.
  "ks_f1_button@common_buttons.light_text_button": {
    "size": [ 18, 14 ],
    "$button_text": "F",
    "$pressed_button_name": "button.hide_gui",
    "prevent_touch_input": true,
    "button_mappings": [
      {
        "to_button_id": "button.hide_gui",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.hide_gui",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.hide_gui",
        "mapping_type": "pressed"
      }
    ]
  },

  "ks_q_button@common_buttons.light_text_button": {
    "size": [ 18, 14 ],
    "$button_text": "Q",
    "$pressed_button_name": "button.chat",
    "prevent_touch_input": true,
    "button_mappings": [
      {
        "to_button_id": "button.chat",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.chat",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.chat",
        "mapping_type": "pressed"
      }
    ]
  },

  "ks_w_button@common_buttons.light_text_button": {
    "size": [ 18, 14 ],
    "$button_text": "W",
    "$pressed_button_name": "key.emote",
    "prevent_touch_input": true,
    "button_mappings": [
      {
        "to_button_id": "key.emote",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "key.emote",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "key.emote",
        "mapping_type": "pressed"
      }
    ]
  },

  "ks_a_button@common_buttons.light_text_button": {
    "size": [ 18, 14 ],
    "$button_text": "A",
    "$pressed_button_name": "button.hide_paperdoll",
    "prevent_touch_input": true,
    "button_mappings": [
      {
        "to_button_id": "button.hide_paperdoll",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "button.hide_paperdoll",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "button.hide_paperdoll",
        "mapping_type": "pressed"
      }
    ]
  },

  "ks_gap": {
    "type": "panel",
    "size": [ 2, 14 ]
  },

  // Row: Q W A F left-to-right, F keeps its old screen position
  // (row right edge at -52 from top-right).
  "ks_test_row": {
    "type": "panel",
    "size": [ 78, 14 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -52, 8 ],
    "layer": 10,
    "controls": [
      {
        "ks_test_stack": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ 78, 14 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ],
          "controls": [
            {
              "ks_q_slot": {
                "type": "panel",
                "size": [ 18, 14 ],
                "controls": [
                  {
                    "ks_q_button@hud.ks_q_button": {}
                  }
                ]
              }
            },
            {
              "ks_gap1@hud.ks_gap": {}
            },
            {
              "ks_w_slot": {
                "type": "panel",
                "size": [ 18, 14 ],
                "controls": [
                  {
                    "ks_w_button@hud.ks_w_button": {}
                  }
                ]
              }
            },
            {
              "ks_gap2@hud.ks_gap": {}
            },
            {
              "ks_a_slot": {
                "type": "panel",
                "size": [ 18, 14 ],
                "controls": [
                  {
                    "ks_a_button@hud.ks_a_button": {}
                  }
                ]
              }
            },
            {
              "ks_gap3@hud.ks_gap": {}
            },
            {
              "ks_f_slot": {
                "type": "panel",
                "size": [ 18, 14 ],
                "controls": [
                  {
                    "ks_f1_button@hud.ks_f1_button": {}
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "ks_test_row@hud.ks_test_row": {}
          }
        ]
      }
    ]
  }
}
