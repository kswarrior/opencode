{
  "namespace": "hud",

  // RP-only Hide-HUD + Paperdoll toggles.
  // Unlike $pressed_button_name actions (ignored on HUD), toggles write
  // straight to engine settings via hardcoded toggle names, so no
  // action routing is needed. Docs: bedrock.dev JSON UI Toggles table.
  "ks_hud_toggle@common_toggles.light_text_toggle": {
    "size": [ 44, 20 ],
    "$button_text": "HUD",
    "$toggle_name": "hide_hud",
    "$toggle_view_binding_name": "#hide_hud",
    "prevent_touch_input": true
  },

  "ks_doll_toggle@common_toggles.light_text_toggle": {
    "size": [ 44, 20 ],
    "$button_text": "DOLL",
    "$toggle_name": "hide_paperdoll",
    "$toggle_view_binding_name": "#hide_paperdoll",
    "prevent_touch_input": true
  },

  "ks_gap": {
    "type": "panel",
    "size": [ 4, 20 ]
  },

  // Row: HUD DOLL left-to-right, top-right corner area.
  "ks_toggle_row": {
    "type": "panel",
    "size": [ 92, 20 ],
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "offset": [ -52, 8 ],
    "layer": 10,
    "controls": [
      {
        "ks_toggle_stack": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ 92, 20 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ],
          "controls": [
            {
              "ks_hud_slot": {
                "type": "panel",
                "size": [ 44, 20 ],
                "controls": [
                  {
                    "ks_hud_toggle@hud.ks_hud_toggle": {}
                  }
                ]
              }
            },
            {
              "ks_gap1@hud.ks_gap": {}
            },
            {
              "ks_doll_slot": {
                "type": "panel",
                "size": [ 44, 20 ],
                "controls": [
                  {
                    "ks_doll_toggle@hud.ks_doll_toggle": {}
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "ks_toggle_row@hud.ks_toggle_row": {}
          }
        ]
      }
    ]
  }
}
