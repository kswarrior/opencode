    "controls": [
      {
        "ks_right_bg@hud.ks_sidebar_bg": {}
      },
      {
        "ks_right_accent@hud.ks_sidebar_accent": {}
      },
      {
        "ks_right_title@hud.ks_sidebar_title": {
          "text": "KS Client"
        }
      },
      {
        "ks_right_stack": {
          "type": "stack_panel",
          "orientation": "vertical",
          "size": [ 174, 250 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 8, 32 ],
          "layer": 2,
          "controls": [
            {
              "ks_opt_chat@common_toggles.light_text_toggle": {
                "size": [ 174, 22 ],
                "$button_text": "Chat ON",
                "$toggle_name": "ks_chat_on",
                "$toggle_view_binding_name": "ks_chat_state"
