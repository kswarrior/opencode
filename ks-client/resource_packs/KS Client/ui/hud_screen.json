{
  "namespace": "hud",

  // ---------- Utility HUD V-1.5 (Without Counters) ----------
  "_toggles": {
    "type": "panel",
    "size": [0, 0],
    "controls": [
      { "__durability__@inv_content.component_toggle": { "$activator": "button.toggle_main_durability" } },
      { "__counters__@inv_content.component_toggle": { "$activator": "button.toggle_counters" } },
      { "__crosshair__@inv_content.component_toggle": { "$activator": "button.toggle_crosshair" } }
    ]
  },

  "force_close_screen": { // closes the topmost screen from screen stack
    "type": "button",
    "size": [0, 0],
    "layer": 30,
    "pressed_control": "pressed",
    "controls": [
      {
        "pressed": {
          "type": "input_panel",
          "button_mappings": [
            {
              "mapping_type": "global",
              "from_button_id": "button.hide_gui",
              "to_button_id": "button.menu_exit"
            }
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "mapping_type": "global",
        "from_button_id": "button.slot3",
        "to_button_id": "button.menu_select",
        "consume_event": false
      }
    ]
  },

  "f1_redirect": {
    "type": "button",
    "size": [0, 0],
    "layer": 25,
    "default_control": "default",
    "pressed_control": "pressed",
    "controls": [
      {
        "default": {
          "type": "input_panel",
          "button_mappings": [
            {
              "mapping_type": "global",
              "from_button_id": "button.hide_gui",
              "to_button_id": "button.consume"
            }
          ]
        }
      },
      {
        "pressed": {
          "type": "input_panel",
          "button_mappings": [
            {
              "mapping_type": "global",
              "from_button_id": "button.hide_gui",
              "to_button_id": "button.hide_gui_all"
            }
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "mapping_type": "global",
        "from_button_id": "button.slot2",
        "to_button_id": "button.menu_select",
        "consume_event": false
      }
    ]
  },

  "f8_redirect": {
    "type": "button",
    "size": [0, 0],
    "layer": 25,
    "pressed_control": "pressed",
    "controls": [
      {
        "pressed": {
          "type": "input_panel",
          "button_mappings": [
            {
              "mapping_type": "global",
              "from_button_id": "button.hide_paperdoll",
              "to_button_id": "button.hide_paperdoll_hud"
            }
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "mapping_type": "global",
        "from_button_id": "button.slot2",
        "to_button_id": "button.menu_select",
        "consume_event": false
      }
    ]
  },

  "f8_function": {
    "type": "button",
    "size": [0, 0],
    "layer": 25,
    "anchor_from": "top_middle",
    "anchor_to": "top_middle",
    "pressed_control": "pressed",
    "controls": [
      {
        "pressed": {
          "type": "input_panel",
          "button_mappings": [
            {
              "mapping_type": "global",
              "scope": "global",
              "from_button_id": "button.slot3",
              "to_button_id": "button.toggle_main_durability"
            },
            {
              "mapping_type": "global",
              "scope": "global",
              "from_button_id": "button.slot4",
              "to_button_id": "button.toggle_counters"
            },
            {
              "mapping_type": "global",
              "scope": "global",
              "from_button_id": "button.slot5",
              "to_button_id": "button.toggle_crosshair"
            }
          ],
          "controls": [
            {
              "tip_label": {
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [0, 5],
                "type": "image",
                "texture": "textures/ui/hud_tip_text_background",
                "size": ["100%c + 10px", "100%c + 8px"],
                "alpha": 0.5,
                "controls": [
                  {
                    "tip_label": {
                      "type": "label",
                      "text": "Toggle: §31 §r- Armor Durability §32 §r- Offhand\n§33 §r- Mainhand Durability §34 §r- Counters §35 §r- Attack Crosshair",
                      "text_alignment": "center",
                      "shadow": true
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "button_mappings": [
      {
        "mapping_type": "global",
        "from_button_id": "button.hide_paperdoll",
        "to_button_id": "button.menu_select"
      }
    ]
  },

  "attack_crosshair": {
    "type": "collection_panel",
    "size": [9, 9],
    "collection_name": "right_helper_collection",
    "controls": [
      {
        "crosshair": {
          "type": "image",
          "texture": "textures/c_ui/attack_crosshair",
          "offset": [-0.5, -0.5],
          "collection_index": 0,
          "bindings": [
            {
              "binding_name": "(#helper_description = 'hudScreen.tooltip.hit')",
              "binding_name_override": "#visible",
              "binding_type": "collection",
              "binding_collection_name": "right_helper_collection",
              "binding_condition": "always"
            }
          ]
        }
      }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "__crosshair__",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "mainhand_durability": {
    "type": "stack_panel",
    "anchor_from": "bottom_right",
    "anchor_to": "bottom_right",
    "size": ["100%cm", "100%cm"],
    "offset": [-5, -5],
    "$item_collection_name": "hotbar_items",
    "collection_name": "$item_collection_name",
    "controls": [
      { "slot_1@durability_unit": { "collection_index": 0 } },
      { "slot_2@durability_unit": { "collection_index": 1 } },
      { "slot_3@durability_unit": { "collection_index": 2 } },
      { "slot_4@durability_unit": { "collection_index": 3 } },
      { "slot_5@durability_unit": { "collection_index": 4 } },
      { "slot_6@durability_unit": { "collection_index": 5 } },
      { "slot_7@durability_unit": { "collection_index": 6 } },
      { "slot_8@durability_unit": { "collection_index": 7 } },
      { "slot_9@durability_unit": { "collection_index": 8 } }
    ],
    "bindings": [
      {
        "binding_type": "view",
        "source_control_name": "__durability__",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ]
  },

  "durability_unit@inv_content.item_durability": {
    "$fallback_texture": "_",
    "bindings": [
      {
        "binding_name": "#item_durability_total_amount",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_name": "#slot_selected",
        "binding_type": "collection",
        "binding_collection_name": "$item_collection_name"
      },
      {
        "binding_type": "view",
        "source_property_name": "((#item_durability_total_amount > 0) and #slot_selected)",
        "target_property_name": "#visible"
      }
    ]
  },

  "hud_screen": {
    "always_accepts_input": true
  },

  // ---------- NeBux F1 & F3 Buttons v1.1.3 (Default/mobile variant) ----------
  // Hides vanilla doll/coords/days (F3 screens show their own), styles
  // selected-slot art. Vanilla root_panel copy, touch-indicator override,
  // progress/player_renderer2-3 and hud_content.controls deliberately NOT
  // ported (stale-copy risk / missing toggle / unreferenced).
  "hud_player_renderer": {
    "type": "panel",
    "size": [
      65,
      65
    ],
    "offset": [
      0,
      0
    ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "ignored": true,
    "controls": [
      {
        "hud_player": {
          "type": "custom",
          "renderer": "hud_player_renderer",
          "layer": 1,
          "animation_reset_name": "screen_animation_reset",
          "anims": [
            "@common.screen_exit_size_animation_push",
            "@common.screen_exit_size_animation_pop",
            "@common.screen_entrance_size_animation_push",
            "@common.screen_entrance_size_animation_pop"
          ],
          "bindings": [
            {
              "binding_name": "#paper_doll_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },
  "root_panel/exp_rend": {
    "ignored": "$always_visible_hotbar"
  },
  "centered_gui_elements_at_bottom_middle/exp_rend": {
    "ignored": "$always_visible_hotbar"
  },
  "hotbar_slot_selected_image": {
    "type": "image",
    "texture": "textures/ui/selected_hotbar_slot",
    "size": [
      24,
      24
    ],
    "layer": 8,
    "bindings": [
      {
        "binding_name": "#slot_selected",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "$hotbar_collection_name"
      }
    ]
  },
  "player_position": {
    "ignored": true,
    "type": "image",
    "size": [
      "100%c + 6px",
      "100%c + 2px"
    ],
    "texture": "textures/ui/Black",
    "alpha": 0.7,
    "controls": [
      {
        "player_position_text": {
          "type": "label",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 1,
          "enable_profanity_filter": false,
          "color": "$chat_text_color",
          "text": "#text",
          "shadow": true
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#player_position_visible",
        "binding_name_override": "#visible",
        "binding_condition": "always",
        "binding_type": "global"
      },
      {
        "binding_name": "#number_of_days_played_text",
        "binding_name_override": "#text",
        "binding_condition": "always_when_visible",
        "binding_type": "global"
      }
    ]
  },
  // Displays number of played in-game days
  "number_of_days_played": {
    "ignored": true,
    "type": "image",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [
      "100%c + 6px",
      "100%c + 2px"
    ],
    "texture": "textures/ui/Black",
    "alpha": 0.7,
    "controls": [
      {
        "number_of_days_played_text": {
          "type": "label",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 1,
          "enable_profanity_filter": false,
          "color": "$chat_text_color",
          "text": "#text",
          "shadow": true
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#number_of_days_played_visible",
        "binding_name_override": "#visible",
        "binding_condition": "always",
        "binding_type": "global"
      },
      {
        "binding_name": "#number_of_days_played_text",
        "binding_name_override": "#text",
        "binding_condition": "always_when_visible",
        "binding_type": "global"
      }
    ]
  },

  // ---------- PandaMine Clean Touch Controls v1.4.1 (base layout tweaks) ----------
  // Vanilla touch-layout redefinitions: centered bottom-middle cluster sizing,
  // inventory button row, elipses helpers. No KS keys touched. Credit: PandaMine5.
  "hotbar_elipses_button@borderless_button": {
    "sound_volume": "$hud_elipses_sound_volume"
  },

  "elipses_image": {
    "ignored": "(not $hud_elipses_enabled)"
  },

  "hotbar_elipses_panel_right_content": {
    "ignored": "(not $hud_elipses_enabled)"
  },

  "inventory_button": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": [ 226, 22 ],
    "offset": [ 0, -2 ],
    "layer": 4,
    "controls": [
      {
        "padding": {
          "type": "panel",
          "size": [ "fill", "100%" ]
        }
      },
      {
        "button@common.button": {
          "$pressed_button_name": "button.hotbar_inventory_button",
          "size": [ 22, "100%" ]
        }
      }
    ]
  },

  "centered_gui_elements_at_bottom_middle_touch": {
    "size": "$size",
    "$size": [ 180, 50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$size": [ 200, 50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/bubbles_rend_0": {
    "offset": "$offset",
    "$offset": [ 180, -50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/bubbles_rend_1": {
    "offset": "$offset",
    "$offset": [ 180, -50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/hunger_rend": {
    "offset": "$offset",
    "$offset": [ 180, -40 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -40 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/horse_heart_rend_1": {
    "offset": "$offset",
    "$offset": [ 180, -50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/horse_heart_rend_0": {
    "offset": "$offset",
    "$offset": [ 180, -56 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -56 ]
    }
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "inv_button@hud.inventory_button": {}
          }
        ]
      },
      // Déesse Inventory HUD v1.0.2 (Bottom Right): inventory grid overlay.
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "déesse_inventory_hud@déesse_hud.inventory_hud_panel": {}
          },
          {
            "déesse_hotbar_data@déesse_hud.hotbar_data": {}
          }
        ]
      }
      // (Removed per request: Utility HUD + KS F3/F8 keys fully removed.)
    ]
  },

  // Unhide MUST be a sibling of root_panel, not inside it: root_panel is
  // bound to #hud_visible, so anything inside it disappears with the HUD and
  // touch users tapping F1 could get stuck with no way back.
  // Slot Hotbar Button v1.3.0 by @Itzriyo157 (insert_front) + KS show-HUD
  // (insert_back) coexist as separate modifications on hud_content.
  // (PandaMine F1 button removed per request.)
  // Quick Totem Offhand button by oSkullo (insert_front): 30x30 (40 -25%),
  // raised 30px (new size) above the Offhand default.
  "hud_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "totem_btn@hud.totem_btn": {}
          }
        ]
      },
      // (NeBux F1/F3 buttons removed per request — doll kept, buttons gone.)
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": {
          "hud_player_renderer@NeBuxHud.NeBux_hud_player_renderer": {}
        }
      },
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "shb_buttons@shb_main.slot_hotbar_button_panel": {}
          },
          {
            "shb_button_editor@shb_main.editor_button": {}
          },
          {
            "shb_editor_panel@shb_main.editor_panel": {}
          }
        ]
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "ks_show_hud@ks_client.ks_show_hud": {}
          }
        ]
      }
    ]
  },

  // PandaMine perf flags for the HUD screen (telemetry off, cached screen).
  "hud_screen@common.base_screen": {
    "send_telemetry": false,
    "low_frequency_rendering": true,
    "load_screen_immediately": true,
    "cache_screen": true
  },

  // ---------- Quick Totem Offhand button (oSkullo), resized per KS request ----------
  // Offhand default was 40x40 @ [-125, -5]; KS uses 30x30 (-25%) raised by the
  // new size (30px) to [-125, -35], clearing the bottom hotbar row.
  "totem_btn@settings_common.action_button": {
    "prevent_touch_input": true,
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ -125, -35 ],
    "size": [ 30, 30 ],
    "$border_visible": false,
    "$button_text": "",
    "$pressed_button_name": "button.hotbar_inventory_button",
    "$default_button_texture|default": "textures/totem/totem_button",
    "$hover_button_texture|default": "textures/totem/totem_button",
    "$pressed_button_texture|default": "textures/totem/totem_button",
    "$locked_button_texture|default": "textures/totem/totem_button"
  }
}
