{
  "namespace": "hud",

  // (Removed per request: Utility HUD V-1.5 fully removed — durability/crosshair/toggles/redirects gone.)
  "hud_screen": {
    "always_accepts_input": true
  },

  // ---------- Paperdoll renderer (vanilla copy) ----------
  // Hides vanilla doll/coords/days, styles
  // selected-slot art. Vanilla root_panel copy, touch-indicator override,
  // progress/player_renderer2-3 and hud_content.controls deliberately NOT
  // ported (stale-copy risk / missing toggle / unreferenced).
  "hud_player_renderer": {
    "type": "panel",
    "size": [
      65,
      65
    ],
    "offset": [
      0,
      0
    ],
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "ignored": true,
    "controls": [
      {
        "hud_player": {
          "type": "custom",
          "renderer": "hud_player_renderer",
          "layer": 1,
          "animation_reset_name": "screen_animation_reset",
          "anims": [
            "@common.screen_exit_size_animation_push",
            "@common.screen_exit_size_animation_pop",
            "@common.screen_entrance_size_animation_push",
            "@common.screen_entrance_size_animation_pop"
          ],
          "bindings": [
            {
              "binding_name": "#paper_doll_visible",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },
  "root_panel/exp_rend": {
    "ignored": "$always_visible_hotbar"
  },
  "centered_gui_elements_at_bottom_middle/exp_rend": {
    "ignored": "$always_visible_hotbar"
  },
  "hotbar_slot_selected_image": {
    "type": "image",
    "texture": "textures/ui/selected_hotbar_slot",
    "size": [
      24,
      24
    ],
    "layer": 8,
    "bindings": [
      {
        "binding_name": "#slot_selected",
        "binding_name_override": "#visible",
        "binding_type": "collection",
        "binding_collection_name": "$hotbar_collection_name"
      }
    ]
  },
  "player_position": {
    "ignored": true,
    "type": "image",
    "size": [
      "100%c + 6px",
      "100%c + 2px"
    ],
    "texture": "textures/ui/Black",
    "alpha": 0.7,
    "controls": [
      {
        "player_position_text": {
          "type": "label",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 1,
          "enable_profanity_filter": false,
          "color": "$chat_text_color",
          "text": "#text",
          "shadow": true
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#player_position_visible",
        "binding_name_override": "#visible",
        "binding_condition": "always",
        "binding_type": "global"
      },
      {
        "binding_name": "#number_of_days_played_text",
        "binding_name_override": "#text",
        "binding_condition": "always_when_visible",
        "binding_type": "global"
      }
    ]
  },
  // Displays number of played in-game days
  "number_of_days_played": {
    "ignored": true,
    "type": "image",
    "anchor_from": "top_right",
    "anchor_to": "top_right",
    "size": [
      "100%c + 6px",
      "100%c + 2px"
    ],
    "texture": "textures/ui/Black",
    "alpha": 0.7,
    "controls": [
      {
        "number_of_days_played_text": {
          "type": "label",
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "layer": 1,
          "enable_profanity_filter": false,
          "color": "$chat_text_color",
          "text": "#text",
          "shadow": true
        }
      }
    ],
    "bindings": [
      {
        "binding_name": "#number_of_days_played_visible",
        "binding_name_override": "#visible",
        "binding_condition": "always",
        "binding_type": "global"
      },
      {
        "binding_name": "#number_of_days_played_text",
        "binding_name_override": "#text",
        "binding_condition": "always_when_visible",
        "binding_type": "global"
      }
    ]
  },

  // ---------- KS Clean Touch Controls (base layout tweaks) ----------
  // Vanilla touch-layout redefinitions: centered bottom-middle cluster sizing,
  // inventory button row, elipses helpers.
  "hotbar_elipses_button@borderless_button": {
    "sound_volume": "$hud_elipses_sound_volume"
  },

  "elipses_image": {
    "ignored": "(not $hud_elipses_enabled)"
  },

  "hotbar_elipses_panel_right_content": {
    "ignored": "(not $hud_elipses_enabled)"
  },

  "inventory_button": {
    "type": "stack_panel",
    "orientation": "horizontal",
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "size": [ 226, 22 ],
    "offset": [ 0, -2 ],
    "layer": 4,
    "controls": [
      {
        "padding": {
          "type": "panel",
          "size": [ "fill", "100%" ]
        }
      },
      {
        "button@common.button": {
          "$pressed_button_name": "button.hotbar_inventory_button",
          "size": [ 22, "100%" ]
        }
      }
    ]
  },

  "centered_gui_elements_at_bottom_middle_touch": {
    "size": "$size",
    "$size": [ 180, 50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$size": [ 200, 50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/bubbles_rend_0": {
    "offset": "$offset",
    "$offset": [ 180, -50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/bubbles_rend_1": {
    "offset": "$offset",
    "$offset": [ 180, -50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/hunger_rend": {
    "offset": "$offset",
    "$offset": [ 180, -40 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -40 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/horse_heart_rend_1": {
    "offset": "$offset",
    "$offset": [ 180, -50 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -50 ]
    }
  },

  "centered_gui_elements_at_bottom_middle_touch/horse_heart_rend_0": {
    "offset": "$offset",
    "$offset": [ 180, -56 ],
    "variables": {
      "requires": "$hud_elipses_enabled",
      "$offset": [ 200, -56 ]
    }
  },

  "root_panel": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "inv_button@hud.inventory_button": {}
          }
        ]
      },
      // KS Inventory HUD (Bottom Right): inventory grid overlay.
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "ks_inventory_hud@ks_hud.inventory_hud_panel": {}
          },
          {
            "ks_hotbar_data@ks_hud.hotbar_data": {}
          }
        ]
      },
      // (Removed per request: Utility HUD + KS F3/F8 keys fully removed.)
      // KS FPS counter (Top Left, always on): paper-doll digits overlay.
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": {
          "fps_counter@ks_fps.fps_counter_mask": {}
        }
      }
    ]
  },

  // Unhide MUST be a sibling of root_panel, not inside it: root_panel is
  // bound to #hud_visible, so anything inside it disappears with the HUD and
  // touch users tapping F1 could get stuck with no way back.
  // Slot Hotbar Button by KS Client (insert_front) + KS show-HUD
  // (insert_back) coexist as separate modifications on hud_content.
  // (Legacy F1 button removed per request.)
  // Quick Totem Offhand button by KS Client (insert_front): 30x30 (40 -25%),
  // raised 30px (new size) above the Offhand default.
  "hud_content": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "totem_btn@hud.totem_btn": {}
          }
        ]
      },
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": [
          {
            "ksb_buttons@ksb_main.slot_hotbar_button_panel": {}
          },
          {
            "ksb_button_editor@ksb_main.editor_button": {}
          },
          {
            "ksb_editor_panel@ksb_main.editor_panel": {}
          }
        ]
      },
      {
        "array_name": "controls",
        "operation": "insert_back",
        "value": [
          {
            "ks_show_hud@ks_client.ks_show_hud": {}
          }
        ]
      }
    ]
  },

  // KS perf flags for the HUD screen (telemetry off, cached screen).
  "hud_screen@common.base_screen": {
    "send_telemetry": false,
    "low_frequency_rendering": true,
    "load_screen_immediately": true,
    "cache_screen": true
  },

  // ---------- Quick Totem Offhand button (oSkullo), resized per KS request ----------
  // Offhand default was 40x40 @ [-125, -5]; KS uses 30x30 (-25%) raised by the
  // new size (30px) to [-125, -35], clearing the bottom hotbar row.
  "totem_btn@settings_common.action_button": {
    "prevent_touch_input": true,
    "anchor_from": "bottom_middle",
    "anchor_to": "bottom_middle",
    "offset": [ -125, -35 ],
    "size": [ 30, 30 ],
    "$border_visible": false,
    "$button_text": "",
    "$pressed_button_name": "button.hotbar_inventory_button",
    "$default_button_texture|default": "textures/totem/totem_button",
    "$hover_button_texture|default": "textures/totem/totem_button",
    "$pressed_button_texture|default": "textures/totem/totem_button",
    "$locked_button_texture|default": "textures/totem/totem_button"
  }
}
