{
  "namespace": "ks_hud_config",

  "ks_cfg_icon_content": {
    "type": "panel",
    "size": [ 28, 32 ],
    "controls": [
      {
        "ks_cfg_icon_img": {
          "type": "image",
          "texture": "textures/ui/ks_icon_settings",
          "size": [ 20, 20 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, 0 ]
        }
      }
    ]
  },

  "ks_cfg_btn": {
    "type": "panel",
    "size": [ 28, 32 ],
    "controls": [
      { "ks_cfg_icon@ks_hud_config.ks_cfg_icon_content": {} },
      {
        "ks_hud_cfg_state@common.toggle": {
          "size": [ 28, 32 ],
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 0, 0 ],
          "layer": 3,
          "enabled": true,
          "visible": true,
          "$toggle_name": "ks_hud_cfg_open",
          "$toggle_default_state": false,
          "$toggle_binding_type": "none",
          "$toggle_focus_enabled": false,
          "$unchecked_control": "common.empty_panel",
          "$checked_control": "common.empty_panel",
          "$unchecked_hover_control": "common.empty_panel",
          "$checked_hover_control": "common.empty_panel",
          "$unchecked_locked_control": "common.empty_panel",
          "$unchecked_locked_hover_control": "common.empty_panel",
          "$checked_locked_control": "common.empty_panel",
          "$checked_locked_hover_control": "common.empty_panel"
        }
      }
    ]
  },

  "ks_hud_cfg_full": {
    "type": "panel",
    "size": [ "100%", "100%" ],
    "visible": false,
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "offset": [ 0, 0 ],
    "layer": 45,
    "bindings": [
      {
        "binding_type": "view",
        "binding_condition": "always",
        "source_control_name": "ks_hud_cfg_state",
        "source_property_name": "#toggle_state",
        "target_property_name": "#visible"
      }
    ],
    "controls": [
      {
        "ks_cfg_bg": {
          "type": "image",
          "texture": "textures/ui/ks_menu_bg",
          "size": [ "100%", "100%" ],
          "layer": 0
        }
      },
      {
        "ks_cfg_card": {
          "type": "panel",
          "size": [ 620, 360 ],
          "anchor_from": "center",
          "anchor_to": "center",
          "offset": [ 0, 0 ],
          "layer": 1,
          "controls": [
            {
              "ks_cfg_card_bg": {
                "type": "image",
                "texture": "textures/ui/ks_config_bg",
                "size": [ "100%", "100%" ],
                "layer": 0
              }
            },
            {
              "ks_cfg_title": {
                "type": "label",
                "size": [ 300, 26 ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [ -40, 8 ],
                "color": [ 255, 255, 255 ],
                "shadow": true,
                "localize": false,
                "text_alignment": "center",
                "font_size": "normal",
                "font_scale_factor": 1.1,
                "layer": 1,
                "text": "HUD SETTINGS"
              }
            },
            {
              "ks_cfg_sub": {
                "type": "label",
                "size": [ 420, 18 ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [ -40, 32 ],
                "color": [ 160, 220, 235 ],
                "localize": false,
                "text_alignment": "center",
                "font_size": "small",
                "font_scale_factor": 0.85,
                "layer": 1,
                "text": "Toggle hotbar buttons and F1 F3"
              }
            },
            {
              "ks_cfg_save": {
                "type": "panel",
                "size": [ 90, 24 ],
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "offset": [ -30, 8 ],
                "layer": 2,
                "controls": [
                  {
                    "ks_cfg_save_bg": {
                      "type": "image",
                      "texture": "textures/ui/ks_config_btn",
                      "size": [ "100%", "100%" ],
                      "layer": 0
                    }
                  },
                  {
                    "ks_cfg_save_lbl": {
                      "type": "label",
                      "size": [ "100%", "100%" ],
                      "anchor_from": "center",
                      "anchor_to": "center",
                      "offset": [ 0, 0 ],
                      "color": [ 255, 255, 255 ],
                      "shadow": true,
                      "localize": false,
                      "text_alignment": "center",
                      "font_size": "small",
                      "font_scale_factor": 0.9,
                      "layer": 1,
                      "text": "Save"
                    }
                  },
                  {
                    "ks_hud_cfg_save@common.toggle": {
                      "size": [ "100%", "100%" ],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "offset": [ 0, 0 ],
                      "layer": 2,
                      "enabled": true,
                      "visible": true,
                      "$toggle_name": "ks_hud_cfg_saved",
                      "$toggle_default_state": false,
                      "$toggle_binding_type": "none",
                      "$toggle_focus_enabled": false,
                      "$unchecked_control": "common.empty_panel",
                      "$checked_control": "common.empty_panel",
                      "$unchecked_hover_control": "common.empty_panel",
                      "$checked_hover_control": "common.empty_panel",
                      "$unchecked_locked_control": "common.empty_panel",
                      "$unchecked_locked_hover_control": "common.empty_panel",
                      "$checked_locked_control": "common.empty_panel",
                      "$checked_locked_hover_control": "common.empty_panel"
                    }
                  }
                ]
              }
            },
            {
              "ks_cfg_close": {
                "type": "panel",
                "size": [ 20, 20 ],
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "offset": [ -6, 8 ],
                "layer": 2,
                "controls": [
                  {
                    "ks_cfg_close_img": {
                      "type": "image",
                      "texture": "textures/ui/box_exit",
                      "size": [ "100%", "100%" ],
                      "layer": 0
                    }
                  },
                  {
                    "ks_hud_cfg_close@common.toggle": {
                      "size": [ "100%", "100%" ],
                      "anchor_from": "top_left",
                      "anchor_to": "top_left",
                      "offset": [ 0, 0 ],
                      "layer": 1,
                      "enabled": true,
                      "visible": true,
                      "$toggle_name": "ks_hud_cfg_open",
                      "$toggle_default_state": false,
                      "$toggle_binding_type": "none",
                      "$toggle_focus_enabled": false,
                      "$unchecked_control": "common.empty_panel",
                      "$checked_control": "common.empty_panel",
                      "$unchecked_hover_control": "common.empty_panel",
                      "$checked_hover_control": "common.empty_panel",
                      "$unchecked_locked_control": "common.empty_panel",
                      "$unchecked_locked_hover_control": "common.empty_panel",
                      "$checked_locked_control": "common.empty_panel",
                      "$checked_locked_hover_control": "common.empty_panel"
                    }
                  }
                ]
              }
            },
            {
              "ks_cfg_saved_toast": {
                "type": "label",
                "visible": false,
                "size": [ 220, 18 ],
                "anchor_from": "top_right",
                "anchor_to": "top_right",
                "offset": [ -6, 34 ],
                "color": [ 140, 255, 170 ],
                "shadow": true,
                "localize": false,
                "text_alignment": "right",
                "font_size": "small",
                "font_scale_factor": 0.85,
                "layer": 2,
                "text": "Saved for this session",
                "bindings": [
                  {
                    "binding_type": "view",
                    "binding_condition": "always",
                    "source_control_name": "ks_hud_cfg_save",
                    "source_property_name": "#toggle_state",
                    "target_property_name": "#visible"
                  }
                ]
              }
            },
            {
              "ks_cfg_list": {
                "type": "panel",
                "size": [ 580, 210 ],
                "anchor_from": "top_middle",
                "anchor_to": "top_middle",
                "offset": [ 0, 56 ],
                "layer": 1,
                "controls": [
                  {
                    "ks_cfg_list_bg": {
                      "type": "image",
                      "texture": "textures/ui/Black",
                      "alpha": 0.5,
                      "size": [ "100%", "100%" ],
                      "layer": 0
                    }
                  },
                  {
                    "ks_cfg_scroll@common.scrolling_panel": {
                      "size": [ "100% - 16px", "100% - 12px" ],
                      "anchor_from": "top_middle",
                      "anchor_to": "top_middle",
                      "offset": [ 0, 6 ],
                      "layer": 2,
                      "$show_background": false,
                      "$scrolling_content": "ks_hud_config.ks_cfg_toggle_stack"
                    }
                  }
                ]
              }
            },
            {
              "ks_cfg_hint": {
                "type": "label",
                "size": [ 580, 44 ],
                "anchor_from": "bottom_middle",
                "anchor_to": "bottom_middle",
                "offset": [ 0, -8 ],
                "color": [ 160, 170, 185 ],
                "localize": false,
                "text_alignment": "center",
                "font_size": "small",
                "font_scale_factor": 0.8,
                "layer": 1,
                "text": "Toggles apply this session. Persist via ui/_global_variables.json ($ksb_1..$ksb_10, $ksb_totem_*, $ks_f1_v, $ks_f3_v) + repack. No position editing."
              }
            }
          ]
        }
      }
    ]
  },
  "ks_cfg_toggle_stack": {
    "type": "stack_panel",
    "size": [ "100%", "100%c" ],
    "controls": [
      { "ks_c1@ksb_main.toggle_option": { "$toggle_name": "ksbT_1", "$toggle_view_binding_name": "ksbT_1_t", "$toggle_text": "Show Hotbar 1", "$toggle_default_state": "$ksb_1_v" } },
      { "ks_c2@ksb_main.toggle_option": { "$toggle_name": "ksbT_2", "$toggle_view_binding_name": "ksbT_2_t", "$toggle_text": "Show Hotbar 2", "$toggle_default_state": "$ksb_2_v" } },
      { "ks_c3@ksb_main.toggle_option": { "$toggle_name": "ksbT_3", "$toggle_view_binding_name": "ksbT_3_t", "$toggle_text": "Show Hotbar 3", "$toggle_default_state": "$ksb_3_v" } },
      { "ks_c4@ksb_main.toggle_option": { "$toggle_name": "ksbT_4", "$toggle_view_binding_name": "ksbT_4_t", "$toggle_text": "Show Hotbar 4", "$toggle_default_state": "$ksb_4_v" } },
      { "ks_c5@ksb_main.toggle_option": { "$toggle_name": "ksbT_5", "$toggle_view_binding_name": "ksbT_5_t", "$toggle_text": "Show Hotbar 5", "$toggle_default_state": "$ksb_5_v" } },
      { "ks_c6@ksb_main.toggle_option": { "$toggle_name": "ksbT_6", "$toggle_view_binding_name": "ksbT_6_t", "$toggle_text": "Show Hotbar 6", "$toggle_default_state": "$ksb_6_v" } },
      { "ks_c7@ksb_main.toggle_option": { "$toggle_name": "ksbT_7", "$toggle_view_binding_name": "ksbT_7_t", "$toggle_text": "Show Hotbar 7", "$toggle_default_state": "$ksb_7_v" } },
      { "ks_c8@ksb_main.toggle_option": { "$toggle_name": "ksbT_8", "$toggle_view_binding_name": "ksbT_8_t", "$toggle_text": "Show Hotbar 8", "$toggle_default_state": "$ksb_8_v" } },
      { "ks_c9@ksb_main.toggle_option": { "$toggle_name": "ksbT_9", "$toggle_view_binding_name": "ksbT_9_t", "$toggle_text": "Show Hotbar 9", "$toggle_default_state": "$ksb_9_v" } },
      { "ks_c10@ksb_main.toggle_option": { "$toggle_name": "ksbT_10", "$toggle_view_binding_name": "ksbT_10_t", "$toggle_text": "Show Inv Btn", "$toggle_default_state": "$ksb_10_v" } },
      { "ks_ct@ksb_main.toggle_option": { "$toggle_name": "ksbT_totem", "$toggle_view_binding_name": "ksbT_totem_t", "$toggle_text": "Show Totem Btn", "$toggle_default_state": "$ksb_totem_v" } },
      { "ks_ci@ksb_main.toggle_option": { "$toggle_name": "ksbT_invhud", "$toggle_view_binding_name": "ksbT_invhud_t", "$toggle_text": "Show Inv HUD", "$toggle_default_state": "$ksb_invhud_v" } },
      { "ks_cf1@ksb_main.toggle_option": { "$toggle_name": "ksbT_f1", "$toggle_view_binding_name": "ksbT_f1_t", "$toggle_text": "Show F1 HUD", "$toggle_default_state": "$ks_f1_v" } },
      { "ks_cf3@ksb_main.toggle_option": { "$toggle_name": "ksbT_f3show", "$toggle_view_binding_name": "ksbT_f3show_t", "$toggle_text": "Show F3 HUD", "$toggle_default_state": "$ks_f3_v" } },
      { "ks_cd@ksb_main.toggle_option": { "$toggle_name": "ksdT_dura", "$toggle_view_binding_name": "ksdT_dura_t", "$toggle_text": "Show Durability HUD", "$toggle_default_state": "$ksd_dura_v" } }
    ]
  }
}  
}
