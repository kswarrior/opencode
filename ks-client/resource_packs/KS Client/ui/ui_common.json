{
  "namespace": "common",

  // ---------- Side Tooltip Items v1.0.0 (itzriyo157, rebranded) ----------
  // Touch item-details tooltip pinned to a screen corner instead of floating
  // over the touched slot. Corner via $ks_tooltip_anchor (top_left default),
  // fade seconds via $ks_tooltip_alpha_duration, master switch $ks_tooltip_v.
  "selected_item_details": {
    "anchor_to": "$ks_tooltip_anchor",
    "anchor_from": "$ks_tooltip_anchor",
    "$alpha_anim": "@common.ks_sti_alpha",
    "offset": [ 0, 0 ]
  },

  "ks_sti_alpha": {
    "anim_type": "alpha",
    "easing": "in_quint",
    "destroy_at_end": "selected_item_details",
    "duration": "$ks_tooltip_alpha_duration",
    "from": 1.0,
    "to": 0
  },

  "highlight_slot_panel": {
    "type": "panel",
    "controls": [
      {
        "highlight@common.highlight_slot": {
          "controls": [
            {
              "hover_text@common.hover_text": {
                "layer": 29,
                "$hover_text_binding_name|default": "#hover_text",
                // Utility HUD V-1.5 (EchoRif): hover durability is config-gated —
                // $ks_uhud_hover_v for container hover, recipe book follows
                // $ks_uhud_hover_recipe_v.
                "$conditional_ignore|default": "$ks_uhud_hover_v",
                "variables": [
                  {
                    "requires": "($item_collection_name = 'recipe_book')",
                    "$conditional_ignore": "$ks_uhud_hover_recipe_v"
                  }
                ],
                "property_bag": {
                  "#total_durability": 0 //initiating from 0
                },
                "bindings": [
                  {
                    "binding_name": "$hover_text_binding_name",
                    "binding_name_override": "#hover_text_pre",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection_name"
                  },
                  {
                    "ignored": "$conditional_ignore",
                    "binding_type": "view",
                    "source_property_name": "#hover_text_pre",
                    "target_property_name": "#hover_text"
                  },
                  {
                    "ignored": "(not $conditional_ignore)",
                    "binding_name": "#item_durability_total_amount",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection_name"
                  },
                  {
                    "ignored": "(not $conditional_ignore)",
                    "binding_name": "#item_durability_current_amount",
                    "binding_type": "collection",
                    "binding_collection_name": "$item_collection_name"
                  },
                  {
                    "ignored": "(not $conditional_ignore)",
                    "binding_type": "view",
                    "source_property_name": "(#total_durability + (#total_durability < #item_durability_total_amount) * 1 - (#total_durability > #item_durability_total_amount) * 1)", //increment or decrement when needed
                    "target_property_name": "#total_durability"
                  },
                  {
                    "ignored": "(not $conditional_ignore)",
                    "binding_type": "view",
                    "source_property_name": "((#item_durability_current_amount > 0) * #total_durability)",
                    "target_property_name": "#current_durability" // initiating from total durability
                  },
                  {
                    "ignored": "(not $conditional_ignore)",
                    "binding_type": "view",
                    "source_property_name": "(#current_durability - (#item_durability_current_amount < #current_durability) * 1)", //decrement
                    "target_property_name": "#current_durability"
                  },
                  {
                    "ignored": "(not $conditional_ignore)",
                    "binding_type": "view",
                    "source_property_name": "('\n§7Durability: ' + #current_durability + '/' + #total_durability)",
                    "target_property_name": "#durability"
                  },
                  {
                    "ignored": "(not $conditional_ignore)",
                    "binding_type": "view",
                    "source_property_name": "(#hover_text_pre + (((#item_durability_total_amount = 0) + #durability) - ('true' + #durability) - 'false') + #item_durability_current_amount)", //not a mistake
                    "target_property_name": "#hover_text"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "(not (#hover_text_pre = ''))",
                    "target_property_name": "#visible"
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "white_border@common.white_border_slot": {
          "bindings": [
            {
              "binding_name": "#show_persistent_bundle_hover_text",
              "binding_name_override": "#visible"
            }
          ]
        }
      }
    ]
  },

  // ---------- Utility HUD V-1.5 (EchoRif) ----------
  // Side Tooltip Items needs the vanilla touch details factory active so the
  // corner-pinned tooltip above can spawn; keep it gated by $ks_tooltip_v.
  "selected_item_details_factory": {
    "ignored": "(not $ks_tooltip_v)"
  },

  // ---------- Bundle Item Counter (ryBIC, rebranded) ----------
  "container_item": {
    "modifications": [
      {
        "array_name": "controls",
        "operation": "insert_front",
        "value": {
          "item_count_bundle@ks_bundle_counter.bundle_item_counter_text": {}
        }
      }
    ]
  },

  "container_item/item_cell/storage_bar": {
    "ignored": true
  }
}