{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.vindicator.attack": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{"raise_axe": "q.has_target"}
					],
					"blend_transition": 0.1
				},
				"attack": {
					"animations": ["attack"],
					"transitions": [
						{"default": "q.all_animations_finished && !q.has_target"},
						{"raise_axe": "q.all_animations_finished && q.has_target"}
					],
					"blend_transition": 0.1
				},
				"raise_axe": {
					"animations": ["raise_axe"],
					"transitions": [
						{"default": "!q.has_target"},
						{"attack": "v.attack_time>0.0"}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}