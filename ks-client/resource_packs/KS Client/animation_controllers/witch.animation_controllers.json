{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.witch": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{"drink": "v.isholdingitem"},
						{"attack": "v.attack_time>0.0 && q.facing_target_to_range_attack"}
					],
					"blend_transition": 0.1
				},
				"drink": {
					"animations": ["drink"],
					"transitions": [
						{"default": "q.all_animations_finished"}
					],
					"blend_transition": 0.2
				},
				"attack": {
					"animations": ["throw"],
					"transitions": [
						{"default": "q.all_animations_finished"}
					]
				}
			}
		}
	}
}