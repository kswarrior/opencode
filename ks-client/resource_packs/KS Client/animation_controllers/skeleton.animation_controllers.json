{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.skeleton.attack": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{"charge_bow": "q.get_equipped_item_name == 'bow' && q.facing_target_to_range_attack"}
					],
					"blend_transition": 0.1
				},
				"charge_bow": {
					"animations": ["charge_bow"],
					"transitions": [
						{"default": "q.get_equipped_item_name != 'bow' || !q.facing_target_to_range_attack"}
					],
					"blend_transition": 0.2
				}
			}
		},
		"controller.animation.skeleton.move": {
			"initial_state": "default",
			"states": {
				"default": {
					"animations": ["walk"],
					"transitions": [
						{"run": "q.modified_move_speed>1.2"}
					],
					"blend_transition": 0.1
				},
				"run": {
					"animations": ["run"],
					"transitions": [
						{"default": "q.modified_move_speed<=1.1"}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}