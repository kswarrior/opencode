{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.zombie.move": {
		    "initial_state": "default",
			"states": {
				"default": {
					"animations": ["walk"],
					"transitions": [
						{"run": "q.modified_move_speed>0.8"}
					],
					"blend_transition": 0.1
				},
				"run": {
					"animations": ["run"],
					"transitions": [
						{"default": "q.modified_move_speed<=0.7"}
					],
					"blend_transition": 0.1
				}
			}
		},
		"controller.animation.zombie.attack": {
		    "initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{"attack": "v.attack_time>0.0"}
					],
					"blend_transition": 0.1
				},
				"attack": {
					"animations": ["attack"],
					"transitions": [
						{"default": "q.all_animations_finished"}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}