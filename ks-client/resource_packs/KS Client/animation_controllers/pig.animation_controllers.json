{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.pig.move": {
		    "initial_state": "default",
			"states": {
				"default": {
					"animations": ["walk", "idle"],
					"transitions": [
						{"run": "q.ground_speed>4"},
						{"float": "q.is_in_water && !q.is_on_ground"}
					],
					"blend_transition": 0.1
				},
				"run": {
					"animations": ["run"],
					"transitions": [
						{"default": "q.ground_speed<=3"},
						{"float": "q.is_in_water && !q.is_on_ground"}
					],
					"blend_transition": 0.1
				},
				"float": {
					"animations": ["float"],
					"transitions": [
						{"default": "!q.is_in_water || q.is_on_ground"}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}