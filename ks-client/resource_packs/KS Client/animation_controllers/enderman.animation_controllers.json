{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.enderman.angry": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{"angry": "q.is_angry"}
					],
					"blend_transition": 0.1
				},
				"angry": {
					"animations": ["angry"],
					"transitions": [
						{"default": "!q.is_angry"}
					],
					"blend_transition": 0.1
				}
			}
		},
		"controller.animation.enderman.carrying": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{"carrying": "q.is_carrying_block"},
						{"attack": "v.attack_time>0.0"}
					],
					"blend_transition": 0.1
				},
				"carrying": {
					"animations": ["carrying"],
					"transitions": [
						{"default": "!q.is_carrying_block"},
						{"attack": "v.attack_time>0.0"}
					],
					"blend_transition": 0.1
				},
				"attack": {
					"animations": ["attack"],
					"transitions": [
						{"default": "q.all_animations_finished && !q.is_carrying_block"},
						{"carrying": "q.all_animations_finished && q.is_carrying_block"}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}