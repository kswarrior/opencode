{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.ravager.head": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{"stunned": "q.is_stunned"},
						{"roar": "q.is_roaring"},
						{"attack": "q.is_delayed_attacking>0.0"}
					],
					"blend_transition": 0.15
				},
				"stunned": {
					"animations": ["stunned"],
					"particle_effects": [
						{
							"effect": "stun_particles",
							"locator": "stun"
						}
					],
					"transitions": [
						{"default": "!q.is_stunned"}
					],
					"blend_transition": 0.15
				},
				"roar": {
					"animations": ["roar"],
					"transitions": [
						{"default": "!q.is_roaring"}
					],
					"blend_transition": 0.15
				},
				"attack": {
					"animations": ["bite"],
					"transitions": [
						{"default": "q.all_animations_finished"}
					],
					"blend_transition": 0.15
				}
			}
		},
		"controller.animation.ravager.move": {
			"states": {
				"default": {
					"animations": ["walk", "idle"],
					"transitions": [
						{"run": "q.ground_speed>3.5"}
					],
					"blend_transition": 0.1
				},
				"run": {
					"animations": ["run"],
					"transitions": [
						{"default": "q.ground_speed<3.0"}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}