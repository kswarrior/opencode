{
	"format_version" : "1.10.0",
	"animation_controllers" : {
		"controller.animation.evoker" : {
			"initial_state" : "default",
			"states" : {
				"casting" : {
					"blend_transition" : 0.2,
					"animations" : [ "casting" ],
					"particle_effects" : [
						{
							"effect" : "spell",
							"locator" : "spell0"
						},
						{
							"effect" : "spell",
							"locator" : "spell1"
						}
					],
					"transitions" : [
						{
							"default" : "!q.is_casting"
						}
					]
				},
        "celebrating" : {
          "animations" : [ "celebrating" ],
          "blend_transition" : 0.2,
          "blend_via_shortest_path" : true,
          "transitions" : [
            {
              "default" : "!q.is_celebrating"
            }
          ]
        },
				"default" : {
					"blend_transition" : 0.2,
          "blend_via_shortest_path" : true,
          "transitions" : [
            {
              "casting" : "q.is_casting"
            },
            {
							"celebrating" : "q.is_celebrating"
						}
					]
				}
			}
		}
  }
}
