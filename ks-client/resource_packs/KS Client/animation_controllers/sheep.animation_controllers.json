{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.sheep.grazing": {
		    "initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{"grazing": "q.is_grazing && q.modified_move_speed<0.1"}
					]
				},
				"grazing": {
					"animations": ["grazing"],
					"transitions": [
						{"default": "q.all_animations_finished || q.modified_move_speed>=0.1"}
					],
					"blend_transition": 0.2
				}
			}
		},
		"controller.animation.sheep.wool": {
		    "initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{"wet_wool": "q.is_in_contact_with_water"}
					],
					"blend_transition": 0.1
				},
				"wet_wool": {
					"animations": ["wet_wool"],
					"transitions": [
						{"dry_wool": "!q.is_in_contact_with_water"}
					],
					"blend_transition": 0.1
				},
				"dry_wool": {
					"animations": ["dry_wool"],
					"transitions": [
						{"default": "q.all_animations_finished && !q.is_in_contact_with_water"},
						{"wet_wool": "q.is_in_contact_with_water"}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}