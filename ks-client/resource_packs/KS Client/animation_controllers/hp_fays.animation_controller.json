{
    "format_version": "1.10.0",
    "animation_controllers": {
        "controller.animation.sprinting_dust": {
            "initial_state": "default",
            "states": {
                "default": {
                    "transitions": [
                        {
                            "is_sprinting": "query.is_moving && query.is_sprinting && !query.is_in_water"
                        }
                    ]
                },
                "is_sprinting": {
                    "particle_effects": [
                        {
                            "effect": "particle"
                        }
                    ],
                    "transitions": [
                        {
                            "default": "!query.is_moving && !query.is_sprinting && !query.is_in_water"
                        }
                    ]
                }
            }
        },
        "controller.animation.swim.idle": {
            "states": {
                "1": {
                    "animations": [
                        {
                            "swim.idle": "!v.is_first_person"
                        }
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "default": "!q.is_in_water || q.is_swimming || q.is_on_ground || q.is_using_item"
                        }
                    ]
                },
                "default": {
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "1": "q.is_in_water && !q.is_swimming && !q.is_on_ground && !q.is_using_item"
                        }
                    ]
                }
            }
        },
        "controller.animation.swim.ground": {
            "states": {
                "1": {
                    "animations": [
                        {
                            "sneak.arms": "!v.is_first_person"
                        },
                        {
                            "sneak.legs": "!v.is_first_person"
                        }
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "default": "!q.is_in_water || q.is_swimming || !q.is_on_ground || !q.is_moving"
                        }
                    ]
                },
                "default": {
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "1": "q.is_in_water && !q.is_swimming && q.is_on_ground && q.is_moving"
                        }
                    ]
                }
            }
        },
        "controller.animation.player.fishing_carrots": {
            "states": {
                "default": {
                    "transitions": [
                        {
                            "fish_carrots": "query.get_equipped_item_name == 'carrot_on_a_stick'"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "fish_carrots": {
                    "animations": [
                        "fishing"
                    ],
                    "transitions": [
                        {
                            "default": "query.get_equipped_item_name != 'carrot_on_a_stick'"
                        }
                    ],
                    "blend_transition": 0.25
                }
            }
        },
        "controller.animation.player.fishing_warped_fungus": {
            "states": {
                "default": {
                    "transitions": [
                        {
                            "fish_warped": "query.get_equipped_item_name == 'warped_fungus_on_a_stick'"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "fish_warped": {
                    "animations": [
                        "fishing"
                    ],
                    "transitions": [
                        {
                            "default": "query.get_equipped_item_name != 'warped_fungus_on_a_stick'"
                        }
                    ],
                    "blend_transition": 0.25
                }
            }
        },
        "controller.animation.player.fishing": {
            "states": {
                "default": {
                    "transitions": [
                        {
                            "fish": "query.get_equipped_item_name == 'fishing_rod'"
                        }
                    ],
                    "blend_transition": 0.25
                },
                "fish": {
                    "animations": [
                        "fishing"
                    ],
                    "transitions": [
                        {
                            "default": "query.get_equipped_item_name != 'fishing_rod'"
                        }
                    ],
                    "blend_transition": 0.25
                }
            }
        },
        "controller.animation.player.fishing_action": {
            "states": {
                "default": {
                    "transitions": [
                        {
                            "fish_action": "query.get_equipped_item_name == 'fishing_rod' && query.item_in_use_duration > 0"
                        }
                    ]
                },
                "fish_action": {
                    "animations": [
                        "fishing_action"
                    ],
                    "transitions": [
                        {
                            "default": "query.all_animations_finished || query.get_equipped_item_name != 'fishing_rod'"
                        }
                    ]
                }
            }
        },
        "controller.animation.jump": {
            "states": {
                "default": {
                    "transitions": [
                        {
                            "jump_left": "q.is_jumping"
                        },
                        {
                            "jump_right": "q.is_jumping"
                        }
                    ],
                    "blend_transition": 0.24
                },
                "jump_left": {
                    "animations": [
                        {
                            "jump_left": "!q.is_in_water && !v.is_first_person"
                        }
                    ],
                    "blend_transition": 0.24,
                    "transitions": [
                        {
                            "jump_right": "q.is_jumping && q.is_on_ground"
                        },
                        {
                            "default": "!q.is_jumping"
                        }
                    ]
                },
                "jump_right": {
                    "animations": [
                        {
                            "jump_right": "!q.is_in_water && !v.is_first_person"
                        }
                    ],
                    "blend_transition": 0.24,
                    "transitions": [
                        {
                            "jump_left": "q.is_jumping && q.is_on_ground"
                        },
                        {
                            "default": "!q.is_jumping"
                        }
                    ]
                }
            }
        },
        "controller.animation.player.fly.bob": {
            "initial_state": "default",
            "states": {
                "1": {
                    "animations": [
                        "fly_bob"
                    ],
                    "blend_transition": 0.4,
                    "transitions": [
                        {
                            "default": "!q.is_alive || !query.is_on_screen || query.is_sleeping || variable.is_first_person || query.is_sprinting || query.is_in_water || query.is_riding || query.is_gliding || query.is_on_ground || query.modified_move_speed > 0.99"
                        }
                    ]
                },
                "default": {
                    "blend_transition": 0.4,
                    "transitions": [
                        {
                            "1": "q.is_alive && query.is_on_screen && !query.is_sleeping && !variable.is_first_person && !query.is_sprinting && !query.is_in_water && !query.is_riding && !query.is_gliding && !query.is_on_ground && query.modified_move_speed < 0.99"
                        }
                    ]
                }
            }
        },
        "controller.animation.player.fly.move": {
            "initial_state": "default",
            "states": {
                "1": {
                    "animations": [
                        "fly_move"
                    ],
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "default": "!q.is_alive || !query.is_on_screen || query.is_sleeping || variable.is_first_person || query.is_in_water || query.is_riding || query.is_gliding || query.is_on_ground || query.modified_move_speed<0.99 || q.is_sprinting"
                        }
                    ]
                },
                "default": {
                    "blend_transition": 0.2,
                    "transitions": [
                        {
                            "1": "q.is_alive && query.is_on_screen && !query.is_sleeping && !variable.is_first_person && !query.is_in_water && !query.is_riding && !query.is_gliding && !query.is_on_ground && query.modified_move_speed>0.99 && !q.is_sprinting"
                        }
                    ]
                }
            }
        },
        "controller.animation.player.fly.sprint": {
            "initial_state": "default",
            "states": {
                "1": {
                    "animations": [
                        "fly_sprint"
                    ],
                    "blend_transition": 0.4,
                    "transitions": [
                        {
                            "default": "!q.is_alive || !query.is_on_screen || query.is_sleeping || variable.is_first_person || query.is_in_water || query.is_riding || query.is_gliding || query.is_on_ground || query.modified_move_speed<0.99 || !q.is_sprinting"
                        }
                    ]
                },
                "default": {
                    "blend_transition": 0.4,
                    "transitions": [
                        {
                            "1": "q.is_alive && query.is_on_screen && !query.is_sleeping && !variable.is_first_person && !query.is_in_water && !query.is_riding && !query.is_gliding && !query.is_on_ground && query.modified_move_speed>0.99 && q.is_sprinting"
                        }
                    ]
                }
            }
        },
		"controller.animation.player.flower" : {
			"initial_state" : "default",
			"states" : {
				"8" : {
					"animations" : [ {"flower": "!v.is_first_person"} ],
					"blend_transition": 0.4,
					"transitions" : [
						{
							"default" : "!variable.flower || !q.is_sneaking || query.modified_move_speed > 0.08"
						}
					]
				},
				"default" : {
					"blend_transition": 0.4,
					"transitions" : [
						{
							"8" : "variable.flower && q.is_sneaking && !q.is_sleeping && query.modified_move_speed < 0.08"
						}
					]
				}
			}
		},
		"controller.animation.player.eat_drink": {
			"states": {
				"default": {
					"blend_transition": 0.2,
					"transitions": [
						{
							"eat" : "query.item_remaining_use_duration > 0.0 && (query.get_equipped_item_name != 'spyglass' && query.get_equipped_item_name != 'crossbow' && query.get_equipped_item_name != 'bow' && query.get_equipped_item_name != 'trident' && query.get_equipped_item_name != 'ender_trident' && query.get_equipped_item_name != 'fishing_rod' && !v.drink) && query.is_alive"
						},
						{
						    "drink" : "query.item_remaining_use_duration > 0.0 && (v.drink) && query.is_alive"
						}
					]
				},
				"eat": {
					"animations": [
						{"eat":"query.get_equipped_item_name != 'brush' && query.get_equipped_item_name != 'goat_horn'"}
					],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "query.item_remaining_use_duration <= 0.0 || (query.get_equipped_item_name == 'spyglass' || query.get_equipped_item_name == 'crossbow' || query.get_equipped_item_name == 'bow' || query.get_equipped_item_name == 'trident' || query.get_equipped_item_name == 'ender_trident' || query.get_equipped_item_name == 'fishing_rod' || v.drink) || !query.is_alive"
						},
						{
						    "drink" : "query.item_remaining_use_duration > 0.0 && (v.drink) && query.is_alive"
						}
					]
				},
				"drink": {
					"animations": [
						"drink"
					],
					"blend_transition": 0.2,
					"transitions": [
						{
							"default": "query.item_remaining_use_duration <= 0.0 || (!v.drink) || !query.is_alive"
						},
						{
							"eat" : "query.item_remaining_use_duration > 0.0 && (query.get_equipped_item_name != 'spyglass' && query.get_equipped_item_name != 'crossbow' && query.get_equipped_item_name != 'bow' && query.get_equipped_item_name != 'trident' && query.get_equipped_item_name != 'ender_trident' && query.get_equipped_item_name != 'fishing_rod' && !v.drink) && query.is_alive"
						}
					]
				}
			}
		}
    }
}