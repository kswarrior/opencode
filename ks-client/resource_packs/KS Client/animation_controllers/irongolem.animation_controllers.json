{
	"format_version": "1.19.0",
	"animation_controllers": {
		"controller.animation.irongolem.arms": {
			"initial_state": "default",
			"states": {
				"default": {
					"transitions": [
						{"attack": "v.attack_animation_tick>0.0"},
						{"flower": "v.offer_flower_tick"}
					],
					"blend_transition": 0.1
				},
				"attack": {
					"animations": ["attack"],
					"transitions": [
						{"default": "q.all_animations_finished"}
					],
					"blend_transition": 0.1
				},
				"flower": {
					"animations": ["flower"],
					"transitions": [
						{"default": "!v.offer_flower_tick"}
					],
					"blend_transition": 0.1
				}
			}
		}
	}
}