# Bedrock server to monitor
MC_HOST=Mayanshanboss.aternos.me
MC_PORT=63046

# How often the backend pings the server (ms, minimum 15000)
CHECK_INTERVAL_MS=60000

# RakNet UDP ping timeout (ms)
PING_TIMEOUT_MS=5000

# If UDP gets no answer, confirm status through api.mcsrvstat.us (1 = on, 0 = off)
HTTP_FALLBACK=1

# Port the web app listens on (Render sets PORT automatically)
PORT=10000
