<%- include('partials/head', { page: page, title: title, cfg: cfg }) %>

  <section class="section">
    <div class="section-head"><h2>Server Info</h2></div>

    <div class="card info-list">
      <div class="row"><span>Address</span><b id="infoAddress"><%= cfg.address %></b><button class="copy" id="copyBtn" type="button" data-copy="<%= cfg.address %>">Copy</button></div>
      <div class="row"><span>Port</span><b id="infoPort"><%= cfg.port %></b></div>
      <div class="row"><span>Edition</span><b id="infoEdition"><%= cfg.edition %></b></div>
      <div class="row"><span>Software</span><b id="infoSoftware"><span class="skeleton chip"></span></b></div>
      <div class="row"><span>Status</span><b id="infoStatus"><span class="skeleton chip"></span></b></div>
    </div>

    <div class="card help">
      <div class="card-title">How to join</div>
      <ol>
        <li>Open Minecraft Bedrock Edition (Windows, Android, iOS, Xbox, PlayStation).</li>
        <li>Go to <b>Play</b> → <b>Servers</b> → <b>Add Server</b>.</li>
        <li>Server address <code><%= cfg.host %></code>, port <code><%= cfg.port %></code>.</li>
        <li>Start the server from the Aternos panel, then join.</li>
      </ol>
    </div>
  </section>

<%- include('partials/foot') %>
