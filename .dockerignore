!ksx/releases/ksx
!ksx/releases/ksx.sha256
ksvc/releases
ksvc/*.o
ksvc/src/*.o
ksvc/examples/demo
ksvc/examples/simple
main/server
auth/server
account/server
stats/server
browser/data
browser/node_modules
web/node_modules
/tmp
*.log
.DS_Store
.opencode
.serena
